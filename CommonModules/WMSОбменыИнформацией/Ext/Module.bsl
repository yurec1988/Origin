	СтруктураПодключения.Вставить("URLТоваров",				Константы.WMSURLТоваров.Получить());
	СтруктураПодключения.Вставить("URLКонтрагентов",		Константы.WMSURLКонтрагентов.Получить());
	СтруктураПодключения.Вставить("URLДокументовПриемки",	Константы.WMSURLДокументовПриемки.Получить());
	СтруктураПодключения.Вставить("URLДокументовОтгрузки",	Константы.WMSURLДокументовОтгрузки.Получить());
	СтруктураПодключения.Вставить("URLФактаПриемки",		Константы.WMSURLФактаПриемки.Получить());
	СтруктураПодключения.Вставить("URLФактаОтгрузки",		Константы.WMSURLФактаОтгрузки.Получить());
	СтруктураПодключения.Вставить("URLСтатусПриемки",		Константы.WMSURLСтатусПриемки.Получить());
	СтруктураПодключения.Вставить("URLСтатусОтгрузки",		Константы.WMSURLСтатусОтгрузки.Получить());
	СтруктураПодключения.Вставить("URLСтатусОстатков",		Константы.WMSURLСтатусОстатков.Получить());
	
	Возврат СтруктураПодключения;

КонецФункции

// Функция отправляет Json данные методом Post
//
Функция ОтправитьДанныеJSON(Адрес,Url,Guid,СтрокаJS,Объект,ЭтоДокумент = Ложь,СтатусВыгрузки = "") Экспорт
	
	Попытка
        ssl = Новый ЗащищенноеСоединениеOpenSSL();
        HTTPСоединение = Новый HTTPСоединение(Адрес,,,,,,ssl);
    Исключение
		#Если Клиент Тогда
			Сообщить("Не удалось соединиться с " + Адрес);
		#КонецЕсли
        Возврат Неопределено;
    КонецПопытки;
	
	//создаем запрос данных методом POST
	ЗапросPOST = Новый HTTPЗапрос(Url + Guid);
	ЗапросPOST.Заголовки.Вставить("Content-Type", "application/json");
	ЗапросPOST.УстановитьТелоИзСтроки(СтрокаJS,КодировкаТекста.UTF8,ИспользованиеByteOrderMark.НеИспользовать);
	Попытка
		
		ФайлОтвета = ПолучитьИмяВременногоФайла();
		HTTPСоединение.ОтправитьДляОбработки(ЗапросPOST, ФайлОтвета);
		ТекстовыйФайлОтвет = Новый ТекстовыйДокумент;
		ТекстовыйФайлОтвет.Прочитать(ФайлОтвета,КодировкаТекста.UTF8);
		ОтветСервера = ТекстовыйФайлОтвет.ПолучитьТекст();
		
		СтатусВыгрузки = ОтветСервера; 
		
		Если ТипЗнч(Объект) = Тип("Массив") Тогда 
			Для Каждого СтрокаОбъекта Из Объект Цикл
				ЗаписатьИнформациюПоВыгрузкеОбъекта(СтрокаОбъекта,СтрокаJS,ОтветСервера,ЭтоДокумент);		
			КонецЦикла;
		Иначе
			ЗаписатьИнформациюПоВыгрузкеОбъекта(Объект,СтрокаJS,ОтветСервера,ЭтоДокумент);	
		КонецЕсли;
				
	Исключение
		#Если Клиент Тогда 
			Сообщить(ОписаниеОшибки());
		#КонецЕсли
	КонецПопытки;	
		
КонецФункции

// Функция получает Json данные методом Get
//
Функция ПолучитьДанныеJSON(Адрес,Url,Guid,НомерДокумента = "",ЭтоФакт = Ложь) Экспорт
	
	Попытка
	    ssl = Новый ЗащищенноеСоединениеOpenSSL();
	    HTTPСоединение = Новый HTTPСоединение(Адрес,,,,,,ssl);
	Исключение
		#Если Клиент Тогда
			Сообщить("Не удалось соединиться с " + Адрес);
		#КонецЕсли
		Возврат Неопределено;
	КонецПопытки;
	
	Если НомерДокумента = "" Тогда
		ЗапросUrl = Url + Guid;
	Иначе
		ЗапросUrl = Url + Guid + "/" + СокрЛП(НомерДокумента);
	КонецЕсли;
	Запрос = Новый HTTPЗапрос(ЗапросUrl);
	ФайлОтвета = ПолучитьИмяВременногоФайла();
	Ответ = HTTPСоединение.Получить(Запрос, ФайлОтвета);
	ТекстовыйФайлОтвет = Новый ТекстовыйДокумент;
	ТекстовыйФайлОтвет.Прочитать(ФайлОтвета,КодировкаТекста.UTF8);
	ОтветСервера = ТекстовыйФайлОтвет.ПолучитьТекст();	
	
	Если Не ЭтоФакт Тогда 
		Если Ответ.КодСостояния = 200 И Найти(ОтветСервера,"status") <> 0 Тогда 
			Возврат Сред(ОтветСервера,Найти(ОтветСервера,"status")+9,2); 
		ИначеЕсли Ответ.КодСостояния = 200 И Найти(ОтветСервера,"c_order_nr") <> 0 Тогда 
			Возврат "Документ выгружен успешно";	
		Иначе
			Возврат "Документ не выгружен";
		КонецЕсли;
	Иначе
		Возврат ОтветСервера;	
	КонецЕсли;
	
КонецФункции

// Функция получает префикс документа 
//
Функция ПолучитьПрефиксДокумента(СтрокаРегистратор) Экспорт
	
	Если ТипЗнч(СтрокаРегистратор) = Тип("ДокументСсылка.ПоступлениеТоваровУслуг") Тогда 
		Возврат "ПТ_";
	ИначеЕсли ТипЗнч(СтрокаРегистратор) = Тип("ДокументСсылка.ОприходованиеТоваров") Тогда
		Возврат "ОТ_";
	ИначеЕсли ТипЗнч(СтрокаРегистратор) = Тип("ДокументСсылка.ВозвратТоваровОтПокупателя") Тогда
		Возврат "ВТ_";
	ИначеЕсли ТипЗнч(СтрокаРегистратор) = Тип("ДокументСсылка.РеализацияТоваровУслуг") 
		Или ТипЗнч(СтрокаРегистратор) = Тип("ДокументСсылка.ЗаказПокупателя") Тогда
		Возврат "РТ_";
	ИначеЕсли ТипЗнч(СтрокаРегистратор) = Тип("ДокументСсылка.ВозвратТоваровПоставщику") Тогда
		Возврат "ВП_";
	ИначеЕсли ТипЗнч(СтрокаРегистратор) = Тип("ДокументСсылка.СписаниеТоваров") Тогда
		Возврат "СТ_";
	КонецЕсли;
	
КонецФункции

// Процедура записи информации по выгрузке объектов в WMS
//
Процедура ЗаписатьИнформациюПоВыгрузкеОбъекта(Объект,СтрокаJS,ОтветСервера,ЭтоДокумент)
	
	НЗ = РегистрыСведений.WMSВыгруженныеОбъекты.СоздатьНаборЗаписей();
	НЗ.Отбор.Объект.Установить(Объект);
	НЗ.Прочитать();
	Если НЗ.Количество() = 0 Тогда 
		НС = НЗ.Добавить();
		НС.Период = ТекущаяДата();
		НС.Объект = Объект;
		НС.ДатаВыгрузки = ТекущаяДата();
		Попытка
			НС.СтрокаJSON = СтрокаJS;
		Исключение КонецПопытки;
		НС.СтатусОтправки = ОтветСервера;
	КонецЕсли;
	НЗ.Записать();
	
	Если ЭтоДокумент Тогда 
		НЗ = РегистрыСведений.WMSСтатусыДокументов.СоздатьНаборЗаписей();
		НЗ.Отбор.Объект.Установить(Объект);
		НЗ.Прочитать();
		Если НЗ.Количество() > 0 Тогда 
			Возврат;
		Иначе
			НС = НЗ.Добавить();
			НС.Период = ТекущаяДата();
			НС.Объект = Объект;
			НС.СтатусПриОтправке = ОтветСервера;
		КонецЕсли;
		НЗ.Записать();		
	КонецЕсли;
	
КонецПроцедуры

// Процедура записи информации по статусам документов в WMS
//
Процедура ЗаписатьСтатусыДокументовWMS(Объект,СтрокаJS) Экспорт
	
	Если СтрДлина(СтрокаJS) > 5000 Тогда 
		Возврат;	
	КонецЕсли;
	
	НЗ = РегистрыСведений.WMSСтатусыДокументов.СоздатьНаборЗаписей();
	НЗ.Отбор.Объект.Установить(Объект);
	НЗ.Прочитать();
	Если НЗ.Количество() > 0 Тогда 
		НЗ[0].ТекущийСтатусWMS = СтрокаJS;
		Если Найти(СтрокаJS,"FI") > 0 Тогда 
			НЗ[0].ОписаниеСтатуса = "(Finished) - замовлення закрито в системі WMS";
		ИначеЕсли Найти(СтрокаJS,"OK") > 0 Тогда
			НЗ[0].ОписаниеСтатуса = "(Okay) - замовлення передано на склад";
		ИначеЕсли Найти(СтрокаJS,"AC") > 0 Тогда
			НЗ[0].ОписаниеСтатуса = "(Active) - замовлення активовано на збірку";
		ИначеЕсли Найти(СтрокаJS,"PC") > 0 Тогда
			НЗ[0].ОписаниеСтатуса = "(Picked) - замовлення зібрано комплектувальником і доставлено до місця видачі клієнтам";
		ИначеЕсли Найти(СтрокаJS,"PICK") > 0 Тогда
			НЗ[0].ОписаниеСтатуса = "(Pick) - замовлення в процесі збірки";
		ИначеЕсли Найти(СтрокаJS,"DL") > 0 Тогда
			НЗ[0].ОписаниеСтатуса = "замовлення доставлено";
		ИначеЕсли Найти(СтрокаJS,"SH") > 0 Тогда
			НЗ[0].ОписаниеСтатуса = "замовлення відвантажено в маршруті";
		КонецЕсли;
		НЗ.Записать();
	КонецЕсли;		
	
Конецпроцедуры

// Функция получает данные по товарам документа
//
Функция ПолучитьДанныеПоТоварамДляПеремещения(Док) Экспорт

	ТекстЗапроса = "ВЫБРАТЬ
	               |	Док.Количество КАК BU_QUANTITY,
				   |	Док.Номенклатура КАК Номенклатура,
				   |	Док.СерияНоменклатуры КАК СерияНоменклатуры,
				   |	Док.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
				   |	Док.СерияНоменклатуры КАК part_nr,
				   |	Док.Номенклатура.Код КАК КодТовара,
				   |	Док.СерияНоменклатуры.СерийныйНомер КАК НомерПартии,
				   |	Док.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
				   |	Док.Коэффициент КАК Коэффициент,
				   |	Док.Качество КАК Качество,
				   |	Док.ЕдиницаИзмеренияМест КАК ЕдиницаИзмеренияМест,
				   |	Док.КоличествоМест КАК КоличествоМест,
				   |	Док.НалоговоеНазначение КАК НалоговоеНазначение,
				   |	Док.СчетУчетаБУ КАК СчетУчетаБУ,
	               |	ВЫБОР
	               |		КОГДА Док.ХарактеристикаНоменклатуры = ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)
	               |			ТОГДА ЕСТЬNULL(Док.Номенклатура.Код, """")
	               |		ИНАЧЕ ЕСТЬNULL(Док.Номенклатура.Код, """") + ""_"" + (ВЫРАЗИТЬ(Док.ХарактеристикаНоменклатуры.Наименование КАК СТРОКА(200)))
	               |	КОНЕЦ КАК PROD_NR,
	               |	ВЫБОР
	               |		КОГДА Док.ХарактеристикаНоменклатуры = ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)
	               |			ТОГДА ЕСТЬNULL(Док.Номенклатура.Наименование, """")
	               |		ИНАЧЕ ЕСТЬNULL(Док.Номенклатура.Наименование, """") + ""_"" + (ВЫРАЗИТЬ(Док.ХарактеристикаНоменклатуры.Наименование КАК СТРОКА(200)))
	               |	КОНЕЦ КАК PROD_NAME
	               |ИЗ
	               |	Документ.ИмяДок.Товары КАК Док
	               |ГДЕ
	               |	Док.Ссылка = &Ссылка";
	
	Если ТипЗнч(Док) = Тип("ДокументСсылка.ЗаказПокупателя") Тогда 
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса,"ИмяДок","ЗаказПокупателя");
	ИначеЕсли ТипЗнч(Док) = Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда 
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса,"ИмяДок","РеализацияТоваровУслуг");
	ИначеЕсли ТипЗнч(Док) = Тип("ДокументСсылка.ВозвратТоваровОтПокупателя") Тогда 
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса,"ИмяДок","ВозвратТоваровОтПокупателя");
	ИначеЕсли ТипЗнч(Док) = Тип("ДокументСсылка.ВозвратТоваровПоставщику") Тогда 
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса,"ИмяДок","ВозвратТоваровПоставщику");
	ИначеЕсли ТипЗнч(Док) = Тип("ДокументСсылка.ПоступлениеТоваровУслуг") Тогда 
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса,"ИмяДок","ПоступлениеТоваровУслуг");
	ИначеЕсли ТипЗнч(Док) = Тип("ДокументСсылка.ОприходованиеТоваров") Тогда 
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса,"ИмяДок","ОприходованиеТоваров");
	Иначе 
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса,"ИмяДок","СписаниеТоваров");
	КонецЕсли;
		
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Ссылка",Док);	
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	
	Для Каждого СтрокаРезультат Из РезультатЗапроса Цикл
		СтрокаРезультат.НомерПартии = СокрЛП(СтрокаРезультат.НомерПартии);		
	КонецЦикла;
	
	Возврат РезультатЗапроса;
	
КонецФункции

// Функция получает данные по товарам документа
//
Функция ПолучитьДанныеПоТоварамДок(Док) Экспорт

	ТекстЗапроса = "ВЫБРАТЬ
	               |	Док.Количество КАК BU_QUANTITY,
				   |	Док.Номенклатура КАК Номенклатура,
				   |	Док.СерияНоменклатуры КАК part_nr,
	               |	ВЫБОР
	               |		КОГДА Док.ХарактеристикаНоменклатуры = ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)
	               |			ТОГДА ЕСТЬNULL(Док.Номенклатура.Код, """")
	               |		ИНАЧЕ ЕСТЬNULL(Док.Номенклатура.Код, """") + ""_"" + (ВЫРАЗИТЬ(Док.ХарактеристикаНоменклатуры.Наименование КАК СТРОКА(200)))
	               |	КОНЕЦ КАК PROD_NR,
	               |	ВЫБОР
	               |		КОГДА Док.ХарактеристикаНоменклатуры = ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)
	               |			ТОГДА ЕСТЬNULL(Док.Номенклатура.Наименование, """")
	               |		ИНАЧЕ ЕСТЬNULL(Док.Номенклатура.Наименование, """") + ""_"" + (ВЫРАЗИТЬ(Док.ХарактеристикаНоменклатуры.Наименование КАК СТРОКА(200)))
	               |	КОНЕЦ КАК PROD_NAME
	               |ИЗ
	               |	Документ.ИмяДок.Товары КАК Док
	               |ГДЕ
	               |	Док.Ссылка = &Ссылка";
	
	Если ТипЗнч(Док) = Тип("ДокументСсылка.ЗаказПокупателя") Тогда 
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса,"ИмяДок","ЗаказПокупателя");
	ИначеЕсли ТипЗнч(Док) = Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда 
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса,"ИмяДок","РеализацияТоваровУслуг");
	ИначеЕсли ТипЗнч(Док) = Тип("ДокументСсылка.ВозвратТоваровОтПокупателя") Тогда 
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса,"ИмяДок","ВозвратТоваровОтПокупателя");
	ИначеЕсли ТипЗнч(Док) = Тип("ДокументСсылка.ВозвратТоваровПоставщику") Тогда 
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса,"ИмяДок","ВозвратТоваровПоставщику");
	ИначеЕсли ТипЗнч(Док) = Тип("ДокументСсылка.ПоступлениеТоваровУслуг") Тогда 
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса,"ИмяДок","ПоступлениеТоваровУслуг");
	ИначеЕсли ТипЗнч(Док) = Тип("ДокументСсылка.ОприходованиеТоваров") Тогда 
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса,"ИмяДок","ОприходованиеТоваров");
	Иначе 
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса,"ИмяДок","СписаниеТоваров");
	КонецЕсли;
		
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Ссылка",Док);	
	
	Возврат Запрос.Выполнить().Выгрузить();
		
КонецФункции

// Создаем объект ЧтениеJSON на основе текста объекта
//
Функция ПолучитьСтруктуруJSON(ТекстJSON) Экспорт
	
	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(ТекстJSON);
	Структура = ЗаполнитьСтруктуруИзОтветаJSON(Чтение);	
	Чтение.Закрыть();
	
	Возврат Структура;
	
КонецФункции

// Рекурсивная процедура  для возврата объекта типа Структура
//
Функция ЗаполнитьСтруктуруИзОтветаJSON(Знач Чтение) Экспорт
	
	Результат = Новый Структура;

	ПоследнееИмяРеквизита = Неопределено;
	
	Пока Чтение.Прочитать() Цикл
		Тип = Чтение.ТипТекущегоЗначения;
		Если Тип = ТипЗначенияJSON.НачалоОбъекта И ПоследнееИмяРеквизита<>Неопределено Тогда 
			Результат[ПоследнееИмяРеквизита] = ЗаполнитьСтруктуруИзОтветаJSON(Чтение);
		ИначеЕсли Тип = ТипЗначенияJSON.КонецОбъекта Тогда 
			Возврат Результат;
			ПоследнееИмяРеквизита = Неопределено;
		ИначеЕсли Тип = ТипЗначенияJSON.ИмяСвойства Тогда 
			Результат.Вставить(Чтение.ТекущееЗначение, Неопределено);
			ПоследнееИмяРеквизита = Чтение.ТекущееЗначение;
		ИначеЕсли Тип = ТипЗначенияJSON.Булево или Тип = ТипЗначенияJSON.Строка
			или Тип = ТипЗначенияJSON.Число или Тип = ТипЗначенияJSON.Null Тогда 
			Результат[ПоследнееИмяРеквизита] = Чтение.ТекущееЗначение;
		ИначеЕсли Тип = ТипЗначенияJSON.НачалоМассива Тогда 
			Результат[ПоследнееИмяРеквизита] = ЗаполнитьМассивИзОтветаJSON(Чтение);
		КонецЕсли;
	КонецЦикла;  
	
	Возврат Результат;
	
КонецФункции 

// В случае использования массивов в JSON-объекте используем третью процедуру
//
Функция ЗаполнитьМассивИзОтветаJSON(Знач Чтение)
	
	Результат = Новый Массив;
	
	Пока Чтение.Прочитать() Цикл
		Тип = Чтение.ТипТекущегоЗначения;
		Если Тип = ТипЗначенияJSON.НачалоОбъекта Тогда 
			Результат.Добавить(ЗаполнитьСтруктуруИзОтветаJSON(Чтение));
		ИначеЕсли Тип = ТипЗначенияJSON.КонецМассива Тогда 
			Возврат Результат;
		КонецЕсли;
	КонецЦикла;  
	
	Возврат Результат;
	
КонецФункции

// Функция получает Json данные методом Get
//
Функция ПолучитьДанныеМетодомGet(Адрес,Url) Экспорт
	
	Попытка
	    ssl = Новый ЗащищенноеСоединениеOpenSSL();
	    HTTPСоединение = Новый HTTPСоединение(Адрес,,,,,,ssl);
	Исключение
		#Если Клиент Тогда
			Сообщить("Не удалось соединиться с " + Адрес);
		#КонецЕсли
		Возврат Неопределено;
	КонецПопытки;
	
	ЗапросUrl = Url;
	Запрос = Новый HTTPЗапрос(ЗапросUrl);
	Результат = HTTPСоединение.Получить(Запрос);
	ОтветСервера = Результат.ПолучитьТелоКакСтроку();
	
	Возврат ОтветСервера;
	
КонецФункции

// Функция получает таблицу значений на основании структуры Json
//
Функция ПолучитьТЗСоСтруктурыJSON(СтруктураJS)
	
	ТЗ = Новый ТаблицаЗначений;
	ТЗ.Колонки.Добавить("oper_date");
