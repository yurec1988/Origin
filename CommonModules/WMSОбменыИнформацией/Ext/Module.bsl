// Функция перезаписывает документы согласно данным WMS
//
Процедура ПерезаписатьДокументыСогласноWMS(НачалоПериода = Неопределено,КонецПериода = Неопределено) Экспорт
	
	Если Не Константы.WMSКорректироватьДокументы.Получить() Тогда 
		Возврат;	
	КонецЕсли;

	ТекстЗапроса = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	WMSСтатусыДокументовСрезПервых.Объект
	               |ИЗ
	               |	РегистрСведений.WMSСтатусыДокументов.СрезПервых КАК WMSСтатусыДокументовСрезПервых
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.WMSОтгруженныеДокументы КАК WMSОтгруженныеДокументы
	               |		ПО WMSСтатусыДокументовСрезПервых.Объект = WMSОтгруженныеДокументы.Объект
	               |ГДЕ
	               |	WMSСтатусыДокументовСрезПервых.Период МЕЖДУ &НачалоПериода И &КонецПериода
	               |	И WMSОтгруженныеДокументы.Объект ЕСТЬ NULL";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Если НачалоПериода <> Неопределено И КонецПериода <> Неопределено Тогда
		Запрос.УстановитьПараметр("НачалоПериода",НачалоПериода);
		Запрос.УстановитьПараметр("КонецПериода",КонецДня(КонецПериода));
	Иначе
		Запрос.УстановитьПараметр("НачалоПериода",НачалоДня(ТекущаяДата() - (86400 * 4)));
		Запрос.УстановитьПараметр("КонецПериода",КонецДня(ТекущаяДата()));
	КонецЕсли;
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();

	Для Каждого СтрокаРезультат Из РезультатЗапроса Цикл
		Если Не ЗначениеЗаполнено(СтрокаРезультат.Объект) Тогда 
			Продолжить;	
		КонецЕсли;
		ФиксацияЗакрытыхДокументовWMS(СтрокаРезультат.Объект);	
	КонецЦикла;	
	
КонецПроцедуры

// Процедура изменяет содержимое документа согласно данным WMS
//
Процедура ФиксацияЗакрытыхДокументовWMS(Док) Экспорт
	
	// 1.Получим структуру подключения
	СтруктураПодключения = WMSОбменыИнформацией.ПолучитьДанныеПодключенияКWMS();
	
	// 2.Определим номер документа
	ПрефиксДокумента = WMSОбменыИнформацией.ПолучитьПрефиксДокумента(Док);
	НомерДокумента = ПрефиксДокумента + Док.Номер + "_" + СтрЗаменить(Год(Док.Дата),Символы.НПП,"");
	
	// 3.Получим строку JSON со статусом документа
	Если ТипЗнч(Док) = Тип("ДокументСсылка.ПоступлениеТоваровУслуг") Или ТипЗнч(Док) = Тип("ДокументСсылка.ВозвратТоваровОтПокупателя")
		Или ТипЗнч(Док) = Тип("ДокументСсылка.ОприходованиеТоваров") Тогда
		СтрокаJS = WMSОбменыИнформацией.ПолучитьДанныеJSON(СтруктураПодключения.АдресСервера,СтруктураПодключения.URLСтатусПриемки,СтруктураПодключения.GUID,НомерДокумента);
	Иначе
		СтрокаJS = WMSОбменыИнформацией.ПолучитьДанныеJSON(СтруктураПодключения.АдресСервера,СтруктураПодключения.URLСтатусОтгрузки,СтруктураПодключения.GUID,НомерДокумента);
	КонецЕсли;

	// 4.Обработка идет только по статусу FI
	Если Найти(СтрокаJS,"FI") = 0 Тогда 
		Возврат;
	КонецЕсли;

	// 5.Получим строку JSON с информацией по собранным товарам
	СтрокаJS = "";
	Если ТипЗнч(Док) = Тип("ДокументСсылка.ПоступлениеТоваровУслуг") Или ТипЗнч(Док) = Тип("ДокументСсылка.ВозвратТоваровОтПокупателя")
		Или ТипЗнч(Док) = Тип("ДокументСсылка.ОприходованиеТоваров") Тогда
		СтрокаJS = WMSОбменыИнформацией.ПолучитьДанныеJSON(СтруктураПодключения.АдресСервера,СтруктураПодключения.URLФактаПриемки,СтруктураПодключения.GUID,НомерДокумента,Истина);
	Иначе
		СтрокаJS = WMSОбменыИнформацией.ПолучитьДанныеJSON(СтруктураПодключения.АдресСервера,СтруктураПодключения.URLФактаОтгрузки,СтруктураПодключения.GUID,НомерДокумента,Истина);
	КонецЕсли;
	
	// 6.Преобразуем строку JSON в СписокЗначений	
	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(СтрокаJS);
	Результат = ФабрикаXDTO.ПрочитатьJSON(Чтение);
	Чтение.Закрыть();
	
	// 7.Создадим ТЗ для заполнения со списка JSON
	ТЗJSON = Новый ТаблицаЗначений;
	ТЗJSON.Колонки.Добавить("prod_nr");
	ТЗJSON.Колонки.Добавить("part_nr");
	ТЗJSON.Колонки.Добавить("bu_quantity");
	ТЗJSON.Колонки.Добавить("info");
	
	// 8.Заполним данными списка ранее созданную тз
	Попытка
		Попытка
			Для Каждого СтрокаСписка Из Результат.items.items Цикл
				НС = ТЗJSON.Добавить();
				ЗаполнитьЗначенияСвойств(НС,СтрокаСписка);
			КонецЦикла;
		Исключение 
			Если ЗначениеЗаполнено(Результат.items.items.prod_nr) И ЗначениеЗаполнено(Результат.items.items.bu_quantity) Тогда 
				НС = ТЗJSON.Добавить();
				НС.prod_nr = Результат.items.items.prod_nr;
				НС.bu_quantity = Результат.items.items.bu_quantity;
				НС.info = "";
			КонецЕсли;
		КонецПопытки;
	Исключение 
		Возврат;
	КонецПопытки;
	ТЗJSON.Индексы.Добавить("prod_nr");
	
	// 9.Получим данные по товарам документа
	ТЗ = WMSОбменыИнформацией.ПолучитьДанныеПоТоварамДок(Док);  
	ТЗ.Индексы.Добавить("Номенклатура");
	
	ДокОбъект = Док.ПолучитьОбъект();
	ТЗТовары = ДокОбъект.Товары.Выгрузить();
	
	//ДокОбъект.Товары.Очистить();
	
	НЗ = РегистрыСведений.WMSОтгруженныеДокументы.СоздатьНаборЗаписей();
	НЗ.Отбор.Объект.Установить(Док);
	НЗ.Прочитать();
	НЗ.Очистить();
	
	Для Каждого СтрокаТЧ Из ТЗТовары Цикл
		
		НСРег = НЗ.Добавить();
		НСРег.Период = ТекущаяДата();
		НСРег.Объект = Док;
		НСРег.Номенклатура = СтрокаТЧ.Номенклатура; 
		НСРег.ХарактеристикаНоменклатуры = СтрокаТЧ.ХарактеристикаНоменклатуры;
		НСРег.СерияНоменклатуры = СтрокаТЧ.СерияНоменклатуры;
		НСРег.КоличествоДо = СтрокаТЧ.Количество;
		
		// 1.Определим код товара в wms
		КодТовараWMS = "";
		ИскомаяСтрока = ТЗ.Найти(СтрокаТЧ.Номенклатура,"Номенклатура");
		Если ИскомаяСтрока = Неопределено Тогда 
			Продолжить;
		КонецЕсли;
		
		КоличествоДо = 0;
		Комментарий = "";
		// 2.Найдем фактически отгруженный товар
		ИскомаяСтрокаФакт = ТЗJSON.Найти(ИскомаяСтрока.part_nr.СерийныйНомер,"part_nr");
		Если ИскомаяСтрокаФакт = Неопределено Тогда 
			ИскомаяСтрокаФакт = ТЗJSON.Найти(ИскомаяСтрока.PROD_NR,"prod_nr");
		КонецЕсли;
		Если ИскомаяСтрокаФакт <> Неопределено Тогда 
			КоличествоДо = СтрокаТЧ.Количество;
			СтрокаТЧ.Количество = ИскомаяСтрокаФакт.bu_quantity;
			Комментарий = ИскомаяСтрокаФакт.info;
		Иначе
			Продолжить;
		КонецЕсли;
		
		Если СтрокаТЧ.Количество <= 0 Тогда 
			Продолжить;	
		КонецЕсли;
		
		//// 3.Заполним тч товары заказа
		//НС = ДокОбъект.Товары.Добавить();
		//ЗаполнитьЗначенияСвойств(НС,СтрокаТЧ);
		//ОбработкаТабличныхЧастей.РассчитатьСуммуТабЧасти(НС, ДокОбъект);
		//ОбработкаТабличныхЧастей.РассчитатьСуммуНДСТабЧасти(НС, ДокОбъект);

		НСРег.КоличествоПосле = СтрокаТЧ.Количество;
		НСРег.ОписаниеСборки = Комментарий;
		
	КонецЦикла;
	
	Если НЗ.Количество() > 0 Тогда 
		НЗ.Записать();
	КонецЕсли;
	
	//Если ТипЗнч(Док) = Тип("ДокументСсылка.ПоступлениеТоваровУслуг") Или ТипЗнч(Док) = Тип("ДокументСсылка.ВозвратТоваровПоставщику") 
	//	Или ТипЗнч(Док) = Тип("ДокументСсылка.ВозвратТоваровОтПокупателя") Тогда 
	//	Попытка
	//		ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
	//	Исключение 
	//		Возврат;	
	//	КонецПопытки;
	//КонецЕсли;

КонецПроцедуры

