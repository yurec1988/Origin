	КонецПопытки;
	ТЗJSON.Индексы.Добавить("prod_nr");
	
	// 9.Получим данные по товарам документа
	ТЗ = WMSОбменыИнформацией.ПолучитьДанныеПоТоварамДок(Док);  
	ТЗ.Индексы.Добавить("Номенклатура");
	
	ДокОбъект = Док.ПолучитьОбъект();
	ТЗТовары = ДокОбъект.Товары.Выгрузить();
	
	ДокОбъект.Товары.Очистить();
	
	НЗ = РегистрыСведений.WMSОтгруженныеДокументы.СоздатьНаборЗаписей();
	НЗ.Отбор.Объект.Установить(Док);
	НЗ.Прочитать();
	НЗ.Очистить();
	
	Для Каждого СтрокаТЧ Из ТЗТовары Цикл
		
		НСРег = НЗ.Добавить();
		НСРег.Период = ТекущаяДата();
		НСРег.Объект = Док;
		НСРег.Номенклатура = СтрокаТЧ.Номенклатура; 
		НСРег.ХарактеристикаНоменклатуры = СтрокаТЧ.ХарактеристикаНоменклатуры;
		НСРег.КоличествоДо = СтрокаТЧ.Количество;
		
		// 1.Определим код товара в wms
		КодТовараWMS = "";
		ИскомаяСтрока = ТЗ.Найти(СтрокаТЧ.Номенклатура,"Номенклатура");
		Если ИскомаяСтрока = Неопределено Тогда 
			Продолжить;
		КонецЕсли;
		
		КоличествоДо = 0;
		Комментарий = "";
		// 2.Найдем фактически отгруженный товар
		ИскомаяСтрокаФакт = ТЗJSON.Найти(ИскомаяСтрока.PROD_NR,"prod_nr");
		Если ИскомаяСтрокаФакт <> Неопределено Тогда 
			КоличествоДо = СтрокаТЧ.Количество;
			СтрокаТЧ.Количество = ИскомаяСтрокаФакт.bu_quantity;
			Комментарий = ИскомаяСтрокаФакт.info;
		Иначе
			Продолжить;
		КонецЕсли;
		
		Если СтрокаТЧ.Количество <= 0 Тогда 
			Продолжить;	
		КонецЕсли;
		
		// 3.Заполним тч товары заказа
		НС = ДокОбъект.Товары.Добавить();
		ЗаполнитьЗначенияСвойств(НС,СтрокаТЧ);
		ОбработкаТабличныхЧастей.РассчитатьСуммуТабЧасти(НС, ДокОбъект);
		ОбработкаТабличныхЧастей.РассчитатьСуммуНДСТабЧасти(НС, ДокОбъект);
		 
		НСРег.КоличествоПосле = СтрокаТЧ.Количество;
		НСРег.ОписаниеСборки = Комментарий;
		
	КонецЦикла;
	
	Попытка
		ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
		Если НЗ.Количество() > 0 Тогда 
			НЗ.Записать();
		КонецЕсли;
	Исключение 
		Возврат;	
	КонецПопытки;
	
	// Если текущий документ это заказ, тогда нужно изменить расходную накладную по нему
	Если ТипЗнч(Док) = Тип("ДокументСсылка.ЗаказПокупателя") Тогда 
		
		ТекстЗапроса = "ВЫБРАТЬ
		               |	РеализацияТоваровУслуг.Ссылка
		               |ИЗ
		               |	Документ.РеализацияТоваровУслуг КАК РеализацияТоваровУслуг
		               |ГДЕ
		               |	РеализацияТоваровУслуг.Сделка = &Сделка";
		
		Запрос = Новый Запрос(ТекстЗапроса);
		Запрос.УстановитьПараметр("Сделка",Док);
		РезультатЗапроса = Запрос.Выполнить().Выгрузить();
		
		Если РезультатЗапроса.Количество() > 0 Тогда
			РНОбъект = РезультатЗапроса[0].Ссылка.ПолучитьОбъект();
			ТЗТоварыРН = РНОбъект.Товары.Выгрузить();
			РНОбъект.Товары.Очистить();
			Для Каждого СтрокаТЧ Из ТЗТоварыРН Цикл
				ИскомыеСтроки = ДокОбъект.Товары.НайтиСтроки(Новый Структура("Номенклатура,ХарактеристикаНоменклатуры",СтрокаТЧ.Номенклатура,СтрокаТЧ.ХарактеристикаНоменклатуры));
				Для Каждого ИскомаяСтрока Из ИскомыеСтроки Цикл
					НС = РНОбъект.Товары.Добавить();
					ЗаполнитьЗначенияСвойств(НС,СтрокаТЧ);
					НС.Количество = ИскомаяСтрока.Количество;
					ОбработкаТабличныхЧастей.РассчитатьСуммуТабЧасти(НС, РНОбъект);
					ОбработкаТабличныхЧастей.РассчитатьСуммуНДСТабЧасти(НС, РНОбъект);
				КонецЦикла;
			КонецЦикла;
			Попытка
				РНОбъект.Записать(РежимЗаписиДокумента.Проведение);
			Исключение 
				НЗ = РегистрыСведений.WMSОтгруженныеДокументы.СоздатьНаборЗаписей();
				НЗ.Отбор.Объект.Установить(Док);
				НЗ.Прочитать();
				НЗ.Очистить();
	            НЗ.Записать();
			КонецПопытки;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

// Процедура создает документ перемещения согласно данным WMS
//
Процедура СоздатьПеремещенияПоКачествуТовараWMS(НачалоПериодаПарам = "",КонецПериодаПарам = "") Экспорт
	
	// 1.Получим структуру подключения
	СтруктураПодключения = WMSОбменыИнформацией.ПолучитьДанныеПодключенияКWMS();
	
	Если Не ЗначениеЗаполнено(НачалоПериодаПарам) И Не ЗначениеЗаполнено(КонецПериодаПарам) Тогда 
		НачалоПериода = НачалоДня(ТекущаяДата()) - (86400 * 7);
		КонецПериода = КонецДня(ТекущаяДата())+1;
	Иначе
		НачалоПериода = НачалоПериодаПарам;
		КонецПериода = КонецПериодаПарам;	
	КонецЕсли;
	
	НачПериода = Формат(НачалоПериода,"ДФ=dd-MM-yyyy");
	КонПериода = Формат(КонецПериода,"ДФ=dd-MM-yyyy");
		
	URLСтатусОстатков = "/ords/project/whs-services/sq_changes/" + СтруктураПодключения.GUID + "/" + НачПериода + "/" + КонПериода;
	СтрокаJS = ПолучитьДанныеМетодомGet(СтруктураПодключения.АдресСервера,URLСтатусОстатков);	
	СтруктураJS = WMSОбменыИнформацией.ПолучитьСтруктуруJSON(СтрокаJS);
	
	КоличествоСтрок = 0;
	Попытка
		КоличествоСтрок = СтруктураJS.items.Количество();
	Исключение 		
	КонецПопытки;
	
	Если КоличествоСтрок = 0 Тогда 
		Возврат;
	КонецЕсли;
	
	ТЗJSON = ПолучитьТЗСоСтруктурыJSON(СтруктураJS);
	ТЗJSON.Индексы.Добавить("oper_date");
	
	ТЗСклады = ПолучитьСкладыWMS();
	
	ТЗТовары = ПолучитьТовары();
	ТЗТовары.Индексы.Добавить("КодНоменклатуры,СерийныйНомер");
	
	ТЗПеремещения = ПолучитьПеремещенияТоваровПоКачеству(НачалоПериода,КонецПериода);
	ТЗПеремещения.Индексы.Добавить("ДатаТранзакцииWMS");
	
	ТЗ = ТЗJSON.Скопировать();
	ТЗ.Свернуть("oper_date,sq_from,sq_to");
	
	ОсновнаяОрганизация = СПравочники.Организации.НайтиПоКоду("000000001");
	Для Каждого СтрокаСтруктуры Из ТЗ Цикл
		
		// 1.Найдем ранее созданные перемещения по полю oper_date
		ИскомаяСтрока = ТЗПеремещения.Найти(СокрЛП(СтрокаСтруктуры.oper_date),"ДатаТранзакцииWMS");
		Если ИскомаяСтрока <> Неопределено Тогда 
			Продолжить;	
		КонецЕсли;
		
		// 2.Создадим новый документ перемещения
		ДокОбъект = Документы.ПеремещениеТоваров.СоздатьДокумент();
		ДокОбъект.Дата = ТекущаяДата();
		ДокОбъект.ВидОперации = Перечисления.ВидыОперацийПеремещениеТоваров.ТоварыПродукция;
		ДокОбъект.Организация = ОсновнаяОрганизация;
		ДокОбъект.ДатаТранзакцииWMS = СокрЛП(СтрокаСтруктуры.oper_date);
		ДокОбъект.СозданWMS = Истина;
		ДокОбъект.ОтражатьВУправленческомУчете = Истина;
		ДокОбъект.ОтражатьВБухгалтерскомУчете = Истина;
		ДокОбъект.Ответственный = ПараметрыСеанса.ТекущийПользователь;
		ДокОбъект.Комментарий = "Создан системой WMS";
				
		ИскомаяСтрока = ТЗСклады.Найти(Строка(СтрокаСтруктуры.sq_from),"WMSСтатусы");
		Если ИскомаяСтрока <> Неопределено Тогда 
			ДокОбъект.СкладОтправитель = ИскомаяСтрока.Склад;
		КонецЕсли;
		
		ИскомаяСтрока = ТЗСклады.Найти(Строка(СтрокаСтруктуры.sq_to),"WMSСтатусы");
		Если ИскомаяСтрока <> Неопределено Тогда
			ДокОбъект.СкладПолучатель = ИскомаяСтрока.Склад;
		КонецЕсли;
		
		// 3.Заполним товарами	
		ИскомыеСтроки = ТЗJSON.НайтиСтроки(Новый Структура("oper_date,sq_from,sq_to",СтрокаСтруктуры.oper_date,СтрокаСтруктуры.sq_from,СтрокаСтруктуры.sq_to));
		Для Каждого ИскомаяСтрока Из ИскомыеСтроки Цикл
			
			ИскСтроки = ТЗТовары.НайтиСтроки(Новый Структура("КодНоменклатуры,СерийныйНомер",ИскомаяСтрока.prod_nr,ИскомаяСтрока.part_nr));
			Если ИскомыеСтроки.Количество() = 0 Тогда 
				Продолжить;	
			КонецЕсли;

			НС = ДокОбъект.Товары.Добавить();
			НС.Номенклатура = ИскСтроки[0].Номенклатура;
			НС.СерияНоменклатуры = ИскСтроки[0].СерияНоменклатуры;
			НС.Количество = ИскомаяСтрока.qty;
			НС.КоличествоМест = ИскомаяСтрока.qty;
			НС.ЕдиницаИзмерения = НС.Номенклатура.ЕдиницаХраненияОстатков;
			НС.ЕдиницаИзмеренияМест = НС.ЕдиницаИзмерения;
			НС.Коэффициент = НС.ЕдиницаИзмерения.Коэффициент;
			НС.Качество = Справочники.Качество.Новый;
			
			//заполняем счета учета по умолчанию для склада
			ДокОбъект.ЗаполнитьСчетаУчетаВСтрокеТабЧасти(НС, "Товары", Истина, Истина);
			
		КонецЦикла;
		
		ДокОбъект.Записать(РежимЗаписиДокумента.Запись);
		
	КонецЦикла;
	
КонецПроцедуры

// Функция создает перемещения согласно данным WMS
//
Процедура СоздатьПеремещенияСогласноWMS(НачПериода = Неопределено,КонПериода = Неопределено) Экспорт
	
	Если Не Константы.WMSСоздаватьПеремещениеПоСтатусам.Получить() Тогда 
		Возврат;	
	КонецЕсли;

	ТекстЗапроса = "ВЫБРАТЬ
	               |	Склады.Ссылка КАК Склад,
	               |	Склады.WMSСтатусы
	               |ИЗ
	               |	Справочник.Склады КАК Склады
	               |ГДЕ
	               |	Склады.WMSСтатусы <> """"";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	ТЗСклады = Запрос.Выполнить().Выгрузить();
	
	ТекстЗапроса = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	WMSСтатусыДокументовСрезПервых.Объект,
	               |	WMSСтатусыДокументовСрезПервых.Обработан
	               |ИЗ
	               |	РегистрСведений.WMSСтатусыДокументов.СрезПервых КАК WMSСтатусыДокументовСрезПервых
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.WMSОтгруженныеДокументы КАК WMSОтгруженныеДокументы
	               |		ПО WMSСтатусыДокументовСрезПервых.Объект = WMSОтгруженныеДокументы.Объект
	               |ГДЕ
	               |	WMSСтатусыДокументовСрезПервых.Объект.Дата МЕЖДУ &НачалоПериода И &КонецПериода
				   //|	И WMSОтгруженныеДокументы.Объект ЕСТЬ NULL
	               |	И НЕ WMSСтатусыДокументовСрезПервых.Обработан";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Если НачПериода <> Неопределено И КонПериода <> Неопределено Тогда
		Запрос.УстановитьПараметр("НачалоПериода",НачПериода);
		Запрос.УстановитьПараметр("КонецПериода",КонецДня(КонПериода));
	Иначе
		Запрос.УстановитьПараметр("НачалоПериода",НачалоДня(ТекущаяДата() - (86400 * 7)));
		Запрос.УстановитьПараметр("КонецПериода",КонецДня(ТекущаяДата()));
	КонецЕсли;
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();

	Для Каждого СтрокаРезультат Из РезультатЗапроса Цикл
		Если Не ЗначениеЗаполнено(СтрокаРезультат.Объект) Тогда 
			Продолжить;	
		КонецЕсли;
		ДокументОбработан = Ложь;
		ОбработатьДокумент(СтрокаРезультат.Объект,ТЗСклады,ДокументОбработан);	
		Если ДокументОбработан Тогда
			НЗ = РегистрыСведений.WMSСтатусыДокументов.СоздатьНаборЗаписей();
			НЗ.Отбор.Объект.Установить(СтрокаРезультат.Объект);
			НЗ.Прочитать();
			Для Каждого СтрокаНЗ Из НЗ Цикл
				СтрокаНЗ.Обработан = Истина;	
			КонецЦикла;
			НЗ.Записать();
		КонецЕсли;
	КонецЦикла;	
	
КонецПроцедуры

// Процедура обрабатывает содержимое документа согласно данным WMS
//
Процедура ОбработатьДокумент(Док,ТЗСклады,ДокументОбработан=Ложь) Экспорт
	
	// 1.Получим структуру подключения
	СтруктураПодключения = WMSОбменыИнформацией.ПолучитьДанныеПодключенияКWMS();
	
	// 2.Определим номер документа
	ПрефиксДокумента = WMSОбменыИнформацией.ПолучитьПрефиксДокумента(Док);
	НомерДокумента = ПрефиксДокумента + Док.Номер + "_" + СтрЗаменить(Год(Док.Дата),Символы.НПП,"");
	
	// 3.Получим строку JSON со статусом документа
	Если ТипЗнч(Док) = Тип("ДокументСсылка.ПоступлениеТоваровУслуг") Или ТипЗнч(Док) = Тип("ДокументСсылка.ВозвратТоваровОтПокупателя")
		Или ТипЗнч(Док) = Тип("ДокументСсылка.ОприходованиеТоваров") Тогда
		СтрокаJS = WMSОбменыИнформацией.ПолучитьДанныеJSON(СтруктураПодключения.АдресСервера,СтруктураПодключения.URLСтатусПриемки,СтруктураПодключения.GUID,НомерДокумента);
	Иначе
		СтрокаJS = WMSОбменыИнформацией.ПолучитьДанныеJSON(СтруктураПодключения.АдресСервера,СтруктураПодключения.URLСтатусОтгрузки,СтруктураПодключения.GUID,НомерДокумента);
	КонецЕсли;

	// 4.Обработка идет только по статусу FI
	Если Найти(СтрокаJS,"FI") = 0 Тогда 
		Возврат;
	КонецЕсли;

	СкладДокумента = Справочники.Склады.ПустаяСсылка();
	Если ТипЗнч(Док) = Тип("ДокументСсылка.ПоступлениеТоваровУслуг") Или ТипЗнч(Док) = Тип("ДокументСсылка.ВозвратТоваровОтПокупателя") Тогда 
		СкладДокумента = Док.СкладОрдер;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(СкладДокумента) Тогда 
		Возврат;	
	КонецЕсли;
	
	// 5.Получим строку JSON с информацией по собранным товарам
	СтрокаJS = "";
	Если ТипЗнч(Док) = Тип("ДокументСсылка.ПоступлениеТоваровУслуг") Или ТипЗнч(Док) = Тип("ДокументСсылка.ВозвратТоваровОтПокупателя")
		Или ТипЗнч(Док) = Тип("ДокументСсылка.ОприходованиеТоваров") Тогда
		СтрокаJS = WMSОбменыИнформацией.ПолучитьДанныеJSON(СтруктураПодключения.АдресСервера,СтруктураПодключения.URLФактаПриемки,СтруктураПодключения.GUID,НомерДокумента,Истина);
	Иначе
		СтрокаJS = WMSОбменыИнформацией.ПолучитьДанныеJSON(СтруктураПодключения.АдресСервера,СтруктураПодключения.URLФактаОтгрузки,СтруктураПодключения.GUID,НомерДокумента,Истина);
	КонецЕсли;
	
	// 6.Преобразуем строку JSON в СписокЗначений	
	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(СтрокаJS);
	Результат = ФабрикаXDTO.ПрочитатьJSON(Чтение);
	Чтение.Закрыть();
	
	// 7.Создадим ТЗ для заполнения со списка JSON
	ТЗJSON = Новый ТаблицаЗначений;
	ТЗJSON.Колонки.Добавить("prod_nr");
	ТЗJSON.Колонки.Добавить("part_nr");
	ТЗJSON.Колонки.Добавить("bu_quantity");
	ТЗJSON.Колонки.Добавить("info");
	ТЗJSON.Колонки.Добавить("sq");
	ТЗJSON.Колонки.Добавить("Склад");
	
	ПустойСклад = Справочники.Склады.ПустаяСсылка();
	
	// 8.Заполним данными списка ранее созданную тз
	Попытка
		Попытка
			Для Каждого СтрокаСписка Из Результат.items.items Цикл
				НС = ТЗJSON.Добавить();
				ЗаполнитьЗначенияСвойств(НС,СтрокаСписка);
				НС.Склад = ПустойСклад;
				ИскомаяСтрока = ТЗСклады.Найти(Строка(СтрокаСписка.sq),"WMSСтатусы");
				Если ИскомаяСтрока <> Неопределено Тогда 
					НС.Склад = ИскомаяСтрока.Склад;	
				КонецЕсли;
			КонецЦикла;
		Исключение 
			Если ЗначениеЗаполнено(Результат.items.items.prod_nr) И ЗначениеЗаполнено(Результат.items.items.bu_quantity) Тогда 
				НС = ТЗJSON.Добавить();
				НС.prod_nr = Результат.items.items.prod_nr;
				НС.bu_quantity = Результат.items.items.bu_quantity;
				НС.part_nr = Результат.items.items.part_nr;
				НС.info = "";
				НС.sq = Результат.items.items.sq;
				НС.Склад = ПустойСклад;
				ИскомаяСтрока = ТЗСклады.Найти(Строка(Результат.items.items.sq),"WMSСтатусы");
				Если ИскомаяСтрока <> Неопределено Тогда 
					НС.Склад = ИскомаяСтрока.Склад;	
				КонецЕсли;
			КонецЕсли;
		КонецПопытки;
	Исключение 
		Возврат;
	КонецПопытки;
	ТЗJSON.Индексы.Добавить("prod_nr");
	
	// 9.Получим данные по товарам документа
	ТЗ = WMSОбменыИнформацией.ПолучитьДанныеПоТоварамДляПеремещения(Док);  
	ТЗ.Индексы.Добавить("Номенклатура");
	
	ДокОбъект = Док.ПолучитьОбъект();
	ТЗТовары = ДокОбъект.Товары.Выгрузить();
	
	ТЗКачество = ТЗJSON.Скопировать();
	ТЗКачество.Свернуть("sq,Склад");
		
	Для Каждого СтрокаТЗ Из ТЗКачество Цикл
		
		Если Не ЗначениеЗаполнено(СтрокаТЗ.Склад) Тогда 
			Продолжить;	
		КонецЕсли;
		
		ДокОбъект = Документы.ПеремещениеТоваров.СоздатьДокумент();
		
		// Заполнение шапки
		ДокОбъект.ОтражатьВУправленческомУчете = Док.ОтражатьВУправленческомУчете;
		ДокОбъект.ОтражатьВБухгалтерскомУчете  = Док.ОтражатьВБухгалтерскомУчете;		
		ДокОбъект.Организация                  = Док.Организация;
		ДокОбъект.Ответственный                = ПараметрыСеанса.ТекущийПользователь;
		ДокОбъект.Подразделение                = Док.Подразделение;
		ДокОбъект.Комментарий                  = Док.Комментарий;
		ДокОбъект.ДокументОснование			   = Док;
		ДокОбъект.СкладОтправитель 			   = СкладДокумента;
		ДокОбъект.СкладПолучатель 			   = СтрокаТЗ.Склад;
		ДокОбъект.ВидОперации = Перечисления.ВидыОперацийПеремещениеТоваров.ТоварыПродукция;		
		ДокОбъект.Дата = Док.Дата + 1;
		
		ИскомыеСтроки = ТЗJSON.НайтиСтроки(Новый Структура("sq",СтрокаТЗ.sq));
		Для Каждого ИскомаяСтрока Из ИскомыеСтроки Цикл
			
			ИскомыеСтрокиТовар = ТЗ.НайтиСтроки(Новый Структура("КодТовара,НомерПартии",ИскомаяСтрока.prod_nr,ИскомаяСтрока.part_nr));
			Если ИскомыеСтрокиТовар.Количество() = 0 Тогда 
				НомерПартииПреобразованный = ПреобразоватьНомерПартииАнгл(ИскомаяСтрока.part_nr);
				ИскомыеСтрокиТовар = ТЗ.НайтиСтроки(Новый Структура("КодТовара,НомерПартии",ИскомаяСтрока.prod_nr,НомерПартииПреобразованный));
				Если ИскомыеСтрокиТовар.Количество() = 0 Тогда
					НомерПартииПреобразованный = ПреобразоватьНомерПартииРус(НомерПартииПреобразованный);
					ИскомыеСтрокиТовар = ТЗ.НайтиСтроки(Новый Структура("КодТовара,НомерПартии",ИскомаяСтрока.prod_nr,НомерПартииПреобразованный));
					Если ИскомыеСтрокиТовар.Количество() = 0 Тогда
						Продолжить;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
			
			НС = ДокОбъект.Товары.Добавить();
			НС.Номенклатура = ИскомыеСтрокиТовар[0].Номенклатура;
			НС.Количество = ИскомаяСтрока.bu_quantity;
			НС.ХарактеристикаНоменклатуры = ИскомыеСтрокиТовар[0].ХарактеристикаНоменклатуры;
			НС.СерияНоменклатуры 		  = ИскомыеСтрокиТовар[0].СерияНоменклатуры;
			НС.ЕдиницаИзмерения           = ИскомыеСтрокиТовар[0].ЕдиницаИзмерения;
			НС.ЕдиницаИзмеренияМест       = ИскомыеСтрокиТовар[0].ЕдиницаИзмеренияМест;
			НС.КоличествоМест             = ИскомыеСтрокиТовар[0].КоличествоМест;
			НС.Коэффициент                = ИскомыеСтрокиТовар[0].Коэффициент;
 			НС.Качество                   = ИскомыеСтрокиТовар[0].Качество;
			
			//заполняем счета учета по умолчанию для склада
			ДокОбъект.ЗаполнитьСчетаУчетаВСтрокеТабЧасти(НС, "Товары", Истина, Истина);
			
			НС.НалоговоеНазначение		   = ИскомыеСтрокиТовар[0].НалоговоеНазначение;			
			НС.СчетУчетаБУ				   = ИскомыеСтрокиТовар[0].СчетУчетаБУ;	
				
		КонецЦикла;
		
		ДокОбъект.ЗаполнитьРозничнуюЦену();
		
		ДокОбъект.Записать(РежимЗаписиДокумента.Запись);

		ДокументОбработан = Истина;
		
	КонецЦикла;
		
КонецПроцедуры

