	НомерПартии = СтрЗаменить(НомерПартии,"А","A");
	НомерПартии = СтрЗаменить(НомерПартии,"а","a");
	НомерПартии = СтрЗаменить(НомерПартии,"О","O");
	НомерПартии = СтрЗаменить(НомерПартии,"о","o");
	НомерПартии = СтрЗаменить(НомерПартии,"Е","E");
	НомерПартии = СтрЗаменить(НомерПартии,"е","e");
	НомерПартии = СтрЗаменить(НомерПартии,"К","K");
	НомерПартии = СтрЗаменить(НомерПартии,"к","k");
	НомерПартии = СтрЗаменить(НомерПартии,"С","C");
	НомерПартии = СтрЗаменить(НомерПартии,"с","c");
	НомерПартии = СтрЗаменить(НомерПартии,"М","M");
	НомерПартии = СтрЗаменить(НомерПартии,"м","m");
	НомерПартии = СтрЗаменить(НомерПартии,"Р","P");
	НомерПартии = СтрЗаменить(НомерПартии,"р","p");
	НомерПартии = СтрЗаменить(НомерПартии,"Н","H");
	НомерПартии = СтрЗаменить(НомерПартии,"н","h");
	
	Возврат НомерПартии;
	
