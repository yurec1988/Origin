// Процедура формирует справочную информацию по товарам в формате Json
//
Процедура ВыгрузитьТоварыВLogisticonWMS(СписокТоваров) Экспорт

	СтруктураПодключения = ПолучитьДанныеПодключенияКWMS();
	
	ТекстЗапроса = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	Номенклатура.Код КАК PROD_NR,
	               |	Номенклатура.Наименование КАК PROD_NAME,
	               |	ВЫБОР
	               |		КОГДА Номенклатура.ЕдиницаХраненияОстатков.Наименование ПОДОБНО ""%пак%"" 
				   |			ИЛИ Номенклатура.ЕдиницаХраненияОстатков.Наименование ПОДОБНО ""%туб%""
	               |			ТОГДА ""уп""
	               |		ИНАЧЕ Номенклатура.ЕдиницаХраненияОстатков.Наименование
	               |	КОНЕЦ КАК BASE_UNIT,
	               |	Номенклатура.Артикул КАК PROD_NR_ERP,
	               |	""1"" КАК PART,
	               |	""0"" КАК PIC_PRIORITY,
	               |	ЕСТЬNULL(ШКТовара.Штрихкод, """") КАК EAN,
	               |	0 КАК PRICE,
	               |	"""" КАК INFO,
	               |	ЕСТЬNULL(Номенклатура.Родитель.Код, """") КАК PROD_GROUP
	               |ИЗ
	               |	Справочник.Номенклатура КАК Номенклатура
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ХарактеристикиНоменклатуры КАК ХарактеристикиНоменклатуры
	               |			ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	               |				Штрихкоды.Владелец КАК Владелец,
	               |				МАКСИМУМ(Штрихкоды.Штрихкод) КАК Штрихкод,
	               |				Штрихкоды.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры
	               |			ИЗ
	               |				РегистрСведений.Штрихкоды КАК Штрихкоды
	               |			ГДЕ
	               |				Штрихкоды.Владелец В ИЕРАРХИИ(&Номенклатура)
	               |			
	               |			СГРУППИРОВАТЬ ПО
	               |				Штрихкоды.Владелец,
	               |				Штрихкоды.ХарактеристикаНоменклатуры) КАК ШКХарактеристики
	               |			ПО ХарактеристикиНоменклатуры.Ссылка = ШКХарактеристики.ХарактеристикаНоменклатуры
	               |		ПО Номенклатура.Ссылка = ХарактеристикиНоменклатуры.Владелец
	               |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	               |			Штрихкоды.Владелец КАК Владелец,
	               |			МАКСИМУМ(Штрихкоды.Штрихкод) КАК Штрихкод
	               |		ИЗ
	               |			РегистрСведений.Штрихкоды КАК Штрихкоды
	               |		ГДЕ
	               |			Штрихкоды.Владелец В ИЕРАРХИИ(&Номенклатура)
	               |		
	               |		СГРУППИРОВАТЬ ПО
	               |			Штрихкоды.Владелец) КАК ШКТовара
	               |		ПО Номенклатура.Ссылка = ШКТовара.Владелец
	               |ГДЕ
	               |	Номенклатура.Ссылка В ИЕРАРХИИ(&Номенклатура)";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Номенклатура",СписокТоваров);
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.ПроверятьСтруктуру = Ложь;
	ПараметрыЗаписиJSON = Новый ПараметрыЗаписиJSON(, Символы.Таб);
	ЗаписьJSON.УстановитьСтроку(ПараметрыЗаписиJSON);
	
	ЗаписьJSON.ЗаписатьНачалоОбъекта();
	ЗаписьJSON.ЗаписатьИмяСвойства("items");
	ЗаписьJSON.ЗаписатьНачалоМассива();
	Для Каждого СтрокаРезультат Из РезультатЗапроса Цикл
		ЗаписьJSON.ЗаписатьНачалоОбъекта();
		Для Каждого СтрокаКолонка Из РезультатЗапроса.Колонки Цикл
			ЗаписьJSON.ЗаписатьИмяСвойства(СтрокаКолонка.Имя);
			ЗначениеКолонки = СтрокаРезультат[СтрокаКолонка.Имя];
			Если СтрокаКолонка.Имя = "BASE_UNIT" Тогда 
				Если Найти(ЗначениеКолонки,".") <> 0 Тогда 
					ЗначениеКолонки	= СтрЗаменить(ЗначениеКолонки,".","");
				КонецЕсли;
				Если Найти(ЗначениеКолонки,",") <> 0 Тогда 
					ЗначениеКолонки	= СтрЗаменить(ЗначениеКолонки,",","");
				КонецЕсли;
			КонецЕсли;
			Попытка
				ЗаписьJSON.ЗаписатьЗначение(ЗначениеКолонки);
			Исключение 
				#Если Клиент Тогда 
					Сообщить("Ошибка записи файла товаров по колонке: " + СтрокаКолонка.Имя);
				#КонецЕсли
			КонецПопытки;
		КонецЦикла;	
		ЗаписьJSON.ЗаписатьКонецОбъекта();
	КонецЦикла;
	ЗаписьJSON.ЗаписатьКонецМассива();
	ЗаписьJSON.ЗаписатьКонецОбъекта();
	СтрокаJS = ЗаписьJSON.Закрыть();

	ОтправитьДанныеJSON(СтруктураПодключения.АдресСервера,СтруктураПодключения.URLТоваров,СтруктураПодключения.GUID,СтрокаJS,СписокТоваров);	
	
КонецПроцедуры

// Процедура формирует справочную информацию по клиентам в формате Json
//
Процедура ВыгрузитьКлиентовLogisticonWMS(Контрагенты) Экспорт
	
	СтруктураПодключения = ПолучитьДанныеПодключенияКWMS();

	ТекстЗапроса = "ВЫБРАТЬ
	               |	Контрагенты.Код КАК FIRM_NR,
	               |	Контрагенты.Наименование КАК NAME,
	               |	""1"" КАК IS_OWNER,
	               |	ЕСТЬNULL(КИАдрес.Адрес,"""") КАК ADDRESS,
	               |	"""" КАК INFO,
	               |	"""" КАК EMAIL,
	               |	ЕСТЬNULL(КИТелефон.Телефон,"""") КАК PHONE,
	               |	"""" КАК IS_INPUT,
	               |	""1"" КАК IS_OUTPUT,
	               |	"""" КАК INFO2
	               |ИЗ
	               |	Справочник.Контрагенты КАК Контрагенты
	               |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	               |			КонтактнаяИнформация.Объект КАК Объект,
	               |			МАКСИМУМ(ВЫРАЗИТЬ(КонтактнаяИнформация.Представление КАК СТРОКА(200))) КАК Адрес
	               |		ИЗ
	               |			РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
	               |		ГДЕ
	               |			КонтактнаяИнформация.Объект В(&Контрагенты)
	               |			И КонтактнаяИнформация.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Адрес)
	               |			И КонтактнаяИнформация.Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.ЮрАдресКонтрагента)
	               |		
	               |		СГРУППИРОВАТЬ ПО
	               |			КонтактнаяИнформация.Объект) КАК КИАдрес
	               |		ПО Контрагенты.Ссылка = КИАдрес.Объект
	               |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	               |			КонтактнаяИнформация.Объект КАК Объект,
	               |			МАКСИМУМ(ВЫРАЗИТЬ(КонтактнаяИнформация.Представление КАК СТРОКА(200))) КАК Телефон
	               |		ИЗ
	               |			РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
	               |		ГДЕ
	               |			КонтактнаяИнформация.Объект В(&Контрагенты)
	               |			И КонтактнаяИнформация.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Телефон)
	               |			И КонтактнаяИнформация.Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.ТелефонКонтрагента)
	               |		
	               |		СГРУППИРОВАТЬ ПО
	               |			КонтактнаяИнформация.Объект) КАК КИТелефон
	               |		ПО Контрагенты.Ссылка = КИТелефон.Объект
	               |ГДЕ
	               |	Контрагенты.Ссылка В(&Контрагенты)";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Контрагенты",Контрагенты);
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
		
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.ПроверятьСтруктуру = Ложь;
	ПараметрыЗаписиJSON = Новый ПараметрыЗаписиJSON(, Символы.Таб);
	ЗаписьJSON.УстановитьСтроку(ПараметрыЗаписиJSON);
	
	ЗаписьJSON.ЗаписатьНачалоОбъекта();
	ЗаписьJSON.ЗаписатьИмяСвойства("items");
	ЗаписьJSON.ЗаписатьНачалоМассива();
	Для Каждого СтрокаРезультат Из РезультатЗапроса Цикл
		ЗаписьJSON.ЗаписатьНачалоОбъекта();
		Для Каждого СтрокаКолонка Из РезультатЗапроса.Колонки Цикл
			ЗаписьJSON.ЗаписатьИмяСвойства(СтрокаКолонка.Имя);
			ЗначениеКолонки = СтрокаРезультат[СтрокаКолонка.Имя];
			Если СтрокаКолонка.Имя = "PHONE" Тогда 
				ЗначениеКолонки = СтрЗаменить(СтрЗаменить(СтрЗаменить(СтрЗаменить(ЗначениеКолонки," ",""),Символы.НПП,""),"+",""),"-","");	
				ЗначениеКолонки = СтрЗаменить(СтрЗаменить(ЗначениеКолонки,"(",""),")","");
				ЗначениеКолонки = СтрЗаменить(СтрЗаменить(ЗначениеКолонки,",","")," ","");
				ЗначениеКолонки = СтрЗаменить(СтрЗаменить(ЗначениеКолонки,"Юля",""),"бухгалтерія","");
				ЗначениеКолонки = СокрЛП(ЗначениеКолонки);
			КонецЕсли;
			Попытка
				ЗаписьJSON.ЗаписатьЗначение(ЗначениеКолонки);
			Исключение 
				#Если Клиент Тогда
					Сообщить("Ошибка записи файла контрагентов отгрузки по колонке: " + СтрокаКолонка.Имя);
				#КонецЕсли
			КонецПопытки;
		КонецЦикла;	
		ЗаписьJSON.ЗаписатьКонецОбъекта();
	КонецЦикла;
	ЗаписьJSON.ЗаписатьКонецМассива();
	ЗаписьJSON.ЗаписатьКонецОбъекта();
	СтрокаJS = ЗаписьJSON.Закрыть();
	
	ОтправитьДанныеJSON(СтруктураПодключения.АдресСервера,СтруктураПодключения.URLКонтрагентов,СтруктураПодключения.GUID,СтрокаJS,Контрагенты);
	
КонецПроцедуры

// Процедура выгружает документы приемки в формате Json
//
Процедура ВыгрузитьДокументыПриемкиLogisticonWMS(Регистратор,ДатаДок,СтатусВыгрузки = "") Экспорт

	СтруктураПодключения = ПолучитьДанныеПодключенияКWMS();

	ТекстЗапроса = "ВЫБРАТЬ
	               |	""ВТ_"" + ВозвратТоваровОтПокупателя.Номер + ""_"" КАК ORDER_NR,
	               |	ЕСТЬNULL(ВозвратТоваровОтПокупателя.Контрагент.Код, """") КАК FIRM_ID,
	               |	ЕСТЬNULL(ВозвратТоваровОтПокупателя.Контрагент.Наименование, """") КАК FIRM_NAME,
	               |	ВозвратТоваровОтПокупателя.Дата КАК DELIV_DATE,
	               |	""1"" КАК SQ,
	               |	ВЫРАЗИТЬ(ВозвратТоваровОтПокупателя.Комментарий КАК СТРОКА(200)) КАК INFO,
	               |	"""" КАК DOCK,
	               |	"""" КАК DELIV_POST,
	               |	"""" КАК TRACK_NUMBER
	               |ПОМЕСТИТЬ Основная
	               |ИЗ
	               |	Документ.ВозвратТоваровОтПокупателя КАК ВозвратТоваровОтПокупателя
	               |ГДЕ
	               |	ВозвратТоваровОтПокупателя.Ссылка = &Ссылка
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	""ПТ_"" + ПоступлениеТоваровУслуг.Номер + ""_"",
	               |	ЕСТЬNULL(ПоступлениеТоваровУслуг.Контрагент.Код, """"),
	               |	ЕСТЬNULL(ПоступлениеТоваровУслуг.Контрагент.Наименование, """"),
	               |	ПоступлениеТоваровУслуг.Дата,
	               |	""1"",
	               |	ВЫРАЗИТЬ(ПоступлениеТоваровУслуг.Комментарий КАК СТРОКА(200)),
	               |	"""",
	               |	"""",
	               |	""""
	               |ИЗ
	               |	Документ.ПоступлениеТоваровУслуг КАК ПоступлениеТоваровУслуг
	               |ГДЕ
	               |	ПоступлениеТоваровУслуг.Ссылка = &Ссылка
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	""ОТ_"" + ОприходованиеТоваров.Номер + ""_"",
	               |	""001234567"",
	               |	ЕСТЬNULL(ОприходованиеТоваров.Организация.Наименование, """"),
	               |	ОприходованиеТоваров.Дата,
	               |	""1"",
	               |	ВЫРАЗИТЬ(ОприходованиеТоваров.Комментарий КАК СТРОКА(200)),
	               |	"""",
	               |	"""",
	               |	""""
	               |ИЗ
	               |	Документ.ОприходованиеТоваров КАК ОприходованиеТоваров
	               |ГДЕ
	               |	ОприходованиеТоваров.Ссылка = &Ссылка
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	Основная.ORDER_NR + &Год КАК ORDER_NR,
	               |	Основная.FIRM_ID КАК FIRM_ID,
	               |	Основная.FIRM_NAME КАК FIRM_NAME,
	               |	Основная.DELIV_DATE КАК DELIV_DATE,
	               |	Основная.SQ КАК SQ,
	               |	Основная.INFO КАК INFO,
	               |	Основная.DOCK КАК DOCK,
	               |	Основная.DELIV_POST КАК DELIV_POST,
	               |	Основная.TRACK_NUMBER КАК TRACK_NUMBER
	               |ИЗ
	               |	Основная КАК Основная";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Ссылка",Регистратор);
	Запрос.УстановитьПараметр("Год",СтрЗаменить(Год(ДатаДок),Символы.НПП,""));
	РезультатШапка = Запрос.Выполнить().Выгрузить();
	
	ТекстЗапроса = "ВЫБРАТЬ
	               |	ВозвратТоваровОтПокупателяТовары.Количество КАК BU_QUANTITY,
	               |	ЕСТЬNULL(ВозвратТоваровОтПокупателяТовары.Номенклатура.Код, """") КАК PROD_NR,
	               |	ЕСТЬNULL(ВозвратТоваровОтПокупателяТовары.Номенклатура.Наименование, """") КАК PROD_NAME,
	               |	ЕСТЬNULL(ВозвратТоваровОтПокупателяТовары.СерияНоменклатуры.СерийныйНомер, """") КАК PART_NR,
	               |	"""" КАК INFO,
	               |	ВозвратТоваровОтПокупателяТовары.Цена КАК PRICE
	               |ПОМЕСТИТЬ Основная
	               |ИЗ
	               |	Документ.ВозвратТоваровОтПокупателя.Товары КАК ВозвратТоваровОтПокупателяТовары
	               |ГДЕ
	               |	ВозвратТоваровОтПокупателяТовары.Ссылка = &Ссылка
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	ПоступлениеТоваровУслугТовары.Количество,
	               |	ЕСТЬNULL(ПоступлениеТоваровУслугТовары.Номенклатура.Код, """"),
	               |	ЕСТЬNULL(ПоступлениеТоваровУслугТовары.Номенклатура.Наименование, """"),
	               |	ЕСТЬNULL(ПоступлениеТоваровУслугТовары.СерияНоменклатуры.СерийныйНомер, """"),
	               |	"""",
	               |	ПоступлениеТоваровУслугТовары.Цена
	               |ИЗ
	               |	Документ.ПоступлениеТоваровУслуг.Товары КАК ПоступлениеТоваровУслугТовары
	               |ГДЕ
	               |	ПоступлениеТоваровУслугТовары.Ссылка = &Ссылка
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	ОприходованиеТоваровТовары.Количество,
	               |	ЕСТЬNULL(ОприходованиеТоваровТовары.Номенклатура.Код, """"),
	               |	ЕСТЬNULL(ОприходованиеТоваровТовары.Номенклатура.Наименование, """"),
	               |	ЕСТЬNULL(ОприходованиеТоваровТовары.СерияНоменклатуры.СерийныйНомер, """"),
	               |	"""",
	               |	ОприходованиеТоваровТовары.Цена
	               |ИЗ
	               |	Документ.ОприходованиеТоваров.Товары КАК ОприходованиеТоваровТовары
	               |ГДЕ
	               |	ОприходованиеТоваровТовары.Ссылка = &Ссылка
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	СУММА(Основная.BU_QUANTITY) КАК BU_QUANTITY,
	               |	Основная.PROD_NR КАК PROD_NR,
	               |	Основная.PROD_NAME КАК PROD_NAME,
	               |	Основная.PART_NR,
	               |	СУММА(Основная.PRICE) КАК PRICE,
	               |	Основная.INFO КАК INFO
	               |ИЗ
	               |	Основная КАК Основная
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	Основная.INFO,
	               |	Основная.PROD_NR,
	               |	Основная.PROD_NAME,
	               |	Основная.PART_NR";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Ссылка",Регистратор);
	РезультатТЧ = Запрос.Выполнить().Выгрузить();
	
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.ПроверятьСтруктуру = Ложь;
	ПараметрыЗаписиJSON = Новый ПараметрыЗаписиJSON(, Символы.Таб);
	ЗаписьJSON.УстановитьСтроку(ПараметрыЗаписиJSON);
	
	ЗаписьJSON.ЗаписатьНачалоОбъекта();
	ЗаписьJSON.ЗаписатьИмяСвойства("header");
	ЗаписьJSON.ЗаписатьНачалоМассива();
	Для Каждого СтрокаРезультат Из РезультатШапка Цикл
		ЗаписьJSON.ЗаписатьНачалоОбъекта();
		Для Каждого СтрокаКолонка Из РезультатШапка.Колонки Цикл
			ЗаписьJSON.ЗаписатьИмяСвойства(СтрокаКолонка.Имя);
			ЗначениеКолонки = СтрокаРезультат[СтрокаКолонка.Имя];
			Если СтрокаКолонка.Имя = "DELIV_DATE" Тогда 
				Если ЗначениеЗаполнено(СтрокаРезультат[СтрокаКолонка.Имя]) Тогда 
					ЗначениеКолонки = Формат(СтрокаРезультат[СтрокаКолонка.Имя],"ДФ='yyyy-MM-dd HH:mm:ss'");
				КонецЕсли;
			КонецЕсли;
			Попытка
				ЗаписьJSON.ЗаписатьЗначение(ЗначениеКолонки);
			Исключение 
				#Если Клиент Тогда
					Сообщить("Ошибка записи файла документа приемки по колонке: " + СтрокаКолонка.Имя);
				#КонецЕсли
			КонецПопытки;
		КонецЦикла;	
		ЗаписьJSON.ЗаписатьКонецОбъекта();
	КонецЦикла;
	ЗаписьJSON.ЗаписатьКонецМассива();
	
	ЗаписьJSON.ЗаписатьИмяСвойства("items");
	ЗаписьJSON.ЗаписатьНачалоМассива();
	Для Каждого СтрокаРезультат Из РезультатТЧ Цикл
		ЗаписьJSON.ЗаписатьНачалоОбъекта();
		Для Каждого СтрокаКолонка Из РезультатТЧ.Колонки Цикл
			ЗаписьJSON.ЗаписатьИмяСвойства(СтрокаКолонка.Имя);
			ЗначениеКолонки = СтрокаРезультат[СтрокаКолонка.Имя];
			Попытка
				ЗаписьJSON.ЗаписатьЗначение(ЗначениеКолонки);
			Исключение 
				#Если Клиент Тогда
					Сообщить("Ошибка записи файла документа приемки по колонке: " + СтрокаКолонка.Имя);
				#КонецЕсли
			КонецПопытки;
		КонецЦикла;	
		ЗаписьJSON.ЗаписатьКонецОбъекта();
	КонецЦикла;
	ЗаписьJSON.ЗаписатьКонецМассива();
	ЗаписьJSON.ЗаписатьКонецОбъекта();
	СтрокаJS = ЗаписьJSON.Закрыть();
	
	ОтветСервера = ОтправитьДанныеJSON(СтруктураПодключения.АдресСервера,СтруктураПодключения.URLДокументовПриемки,СтруктураПодключения.GUID,СтрокаJS,Регистратор,Истина,СтатусВыгрузки);
	
КонецПроцедуры

// Процедура выгружает документы отгрузки в формате Json
//
Процедура ВыгрузитьДокументыОтгрузкиLogisticonWMS(Регистратор,ДатаДок,СтатусВыгрузки = "",ДопЗаказ = Неопределено) Экспорт

	СтруктураПодключения = ПолучитьДанныеПодключенияКWMS();

	Приоритет = 0;
	Если ДопЗаказ <> Неопределено Тогда 
		
		ТекстЗапроса = "ВЫБРАТЬ
		               |	ЗаказПокупателя.Ссылка
		               |ИЗ
		               |	Документ.ЗаказПокупателя КАК ЗаказПокупателя
		               |ГДЕ
		               |	ЗаказПокупателя.ОсновнойЗаказ = &ОсновнойЗаказ";
		
		Запрос = Новый Запрос(ТекстЗапроса);
		Запрос.УстановитьПараметр("ОсновнойЗаказ",ДопЗаказ);
		РезультатДопЗаказ = Запрос.Выполнить().Выгрузить();
		
		Приоритет = РезультатДопЗаказ.Количество();
		
	КонецЕсли;
	
	ТекстЗапроса = "ВЫБРАТЬ
	               |	""ВП_"" + ВозвратТоваровПоставщику.Номер + ""_"" КАК ORDER_NR,
	               |	ЕСТЬNULL(ВозвратТоваровПоставщику.Контрагент.Код, """") КАК FIRM_ID,
	               |	ЕСТЬNULL(ВозвратТоваровПоставщику.Контрагент.Наименование, """") КАК FIRM_NAME,
	               |	ВозвратТоваровПоставщику.Дата КАК SHIP_DATE,
	               |	"""" КАК ADDRESS,
	               |	""1"" КАК SQ,
	               |	ВЫРАЗИТЬ(ВозвратТоваровПоставщику.Комментарий КАК СТРОКА(200)) КАК INFO,
	               |	"""" КАК DOCK,
	               |	"""" КАК DELIV_POST,
	               |	"""" КАК TRACK_NUMBER
	               |ПОМЕСТИТЬ Основная
	               |ИЗ
	               |	Документ.ВозвратТоваровПоставщику КАК ВозвратТоваровПоставщику
	               |ГДЕ
	               |	ВозвратТоваровПоставщику.Ссылка = &Ссылка
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	""РТ_"" + РеализацияТоваровУслуг.Номер + ""_"",
	               |	ЕСТЬNULL(РеализацияТоваровУслуг.Контрагент.Код, """"),
	               |	ЕСТЬNULL(РеализацияТоваровУслуг.Контрагент.Наименование, """"),
	               |	РеализацияТоваровУслуг.Дата,
	               |	"""",
	               |	""1"",
	               |	ВЫРАЗИТЬ(РеализацияТоваровУслуг.Комментарий КАК СТРОКА(200)),
	               |	"""",
	               |	"""",
	               |	""""
	               |ИЗ
	               |	Документ.РеализацияТоваровУслуг КАК РеализацияТоваровУслуг
	               |ГДЕ
	               |	РеализацияТоваровУслуг.Ссылка = &Ссылка
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	""СТ_"" + СписаниеТоваров.Номер + ""_"",
	               |	""001234567"",
	               |	ЕСТЬNULL(СписаниеТоваров.Организация.Наименование, """"),
	               |	СписаниеТоваров.Дата,
	               |	"""",
	               |	""1"",
	               |	ВЫРАЗИТЬ(СписаниеТоваров.Комментарий КАК СТРОКА(200)),
	               |	"""",
	               |	"""",
	               |	""""
	               |ИЗ
	               |	Документ.СписаниеТоваров КАК СписаниеТоваров
	               |ГДЕ
	               |	СписаниеТоваров.Ссылка = &Ссылка
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	""РТ_"" + ЗаказПокупателя.Номер + ""_"",
	               |	ЕСТЬNULL(ЗаказПокупателя.Контрагент.Код, """"),
	               |	ЕСТЬNULL(ЗаказПокупателя.Контрагент.Наименование, """"),
	               |	ЗаказПокупателя.Дата,
	               |	"""",
	               |	""1"",
	               |	ВЫРАЗИТЬ(ЗаказПокупателя.Комментарий КАК СТРОКА(200)),
	               |	"""",
	               |	"""",
	               |	""""
	               |ИЗ
	               |	Документ.ЗаказПокупателя КАК ЗаказПокупателя
	               |ГДЕ
	               |	ЗаказПокупателя.Ссылка = &Ссылка
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	Основная.ORDER_NR + &Год КАК ORDER_NR,
	               |	Основная.FIRM_ID КАК FIRM_ID,
	               |	Основная.FIRM_NAME КАК FIRM_NAME,
	               |	Основная.SHIP_DATE КАК SHIP_DATE,
	               |	Основная.ADDRESS КАК ADDRESS,
	               |	Основная.SQ КАК SQ,
	               |	Основная.INFO КАК INFO,
	               |	"""" КАК INFO1,
	               |	Основная.DOCK КАК DOCK,
	               |	Основная.DELIV_POST КАК DELIV_POST,
	               |	Основная.TRACK_NUMBER КАК TRACK_NUMBER,
	               |	&Приоритет КАК PICK_PRIORITY
	               |ИЗ
	               |	Основная КАК Основная";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Ссылка",Регистратор);
	Запрос.УстановитьПараметр("Приоритет",Приоритет);
	Запрос.УстановитьПараметр("Год",СтрЗаменить(Год(ДатаДок),Символы.НПП,""));
	РезультатШапка = Запрос.Выполнить().Выгрузить();
	
	ТекстЗапроса = "ВЫБРАТЬ
	               |	ВозвратТоваровПоставщикуТовары.Количество КАК BU_QUANTITY,
	               |	ЕСТЬNULL(ВозвратТоваровПоставщикуТовары.Номенклатура.Код, """") КАК PROD_NR,
	               |	ЕСТЬNULL(ВозвратТоваровПоставщикуТовары.Номенклатура.Наименование, """") КАК PROD_NAME,
	               |	ЕСТЬNULL(ВозвратТоваровПоставщикуТовары.СерияНоменклатуры.СерийныйНомер, """") КАК PART_NR,
	               |	"""" КАК INFO,
	               |	ВозвратТоваровПоставщикуТовары.Цена КАК PRICE
	               |ПОМЕСТИТЬ Основная
	               |ИЗ
	               |	Документ.ВозвратТоваровПоставщику.Товары КАК ВозвратТоваровПоставщикуТовары
	               |ГДЕ
	               |	ВозвратТоваровПоставщикуТовары.Ссылка = &Ссылка
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	РеализацияТоваровУслугТовары.Количество,
	               |	ЕСТЬNULL(РеализацияТоваровУслугТовары.Номенклатура.Код, """"),
	               |	ЕСТЬNULL(РеализацияТоваровУслугТовары.Номенклатура.Наименование, """"),
	               |	ЕСТЬNULL(РеализацияТоваровУслугТовары.СерияНоменклатуры.СерийныйНомер, """"),
	               |	"""",
	               |	РеализацияТоваровУслугТовары.Цена
	               |ИЗ
	               |	Документ.РеализацияТоваровУслуг.Товары КАК РеализацияТоваровУслугТовары
	               |ГДЕ
	               |	РеализацияТоваровУслугТовары.Ссылка = &Ссылка
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	СписаниеТоваровТовары.Количество,
	               |	ЕСТЬNULL(СписаниеТоваровТовары.Номенклатура.Код, """"),
	               |	ЕСТЬNULL(СписаниеТоваровТовары.Номенклатура.Наименование, """"),
	               |	ЕСТЬNULL(СписаниеТоваровТовары.СерияНоменклатуры.СерийныйНомер, """"),
	               |	"""",
	               |	СписаниеТоваровТовары.Цена
	               |ИЗ
	               |	Документ.СписаниеТоваров.Товары КАК СписаниеТоваровТовары
	               |ГДЕ
	               |	СписаниеТоваровТовары.Ссылка = &Ссылка
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	СУММА(Основная.BU_QUANTITY) КАК BU_QUANTITY,
	               |	Основная.PROD_NR КАК PROD_NR,
	               |	Основная.PART_NR,
	               |	Основная.PRICE КАК PRICE,
	               |	Основная.INFO КАК INFO
	               |ИЗ
	               |	Основная КАК Основная
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	Основная.INFO,
	               |	Основная.PROD_NR,
	               |	Основная.PRICE,
	               |	Основная.PROD_NAME,
	               |	Основная.PART_NR";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Ссылка",Регистратор);
	РезультатТЧ = Запрос.Выполнить().Выгрузить();
	
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.ПроверятьСтруктуру = Ложь;
	ПараметрыЗаписиJSON = Новый ПараметрыЗаписиJSON(, Символы.Таб);
	ЗаписьJSON.УстановитьСтроку(ПараметрыЗаписиJSON);
	
	ЗаписьJSON.ЗаписатьНачалоОбъекта();
	ЗаписьJSON.ЗаписатьИмяСвойства("header");
	ЗаписьJSON.ЗаписатьНачалоМассива();
	Для Каждого СтрокаРезультат Из РезультатШапка Цикл
		ЗаписьJSON.ЗаписатьНачалоОбъекта();
		Для Каждого СтрокаКолонка Из РезультатШапка.Колонки Цикл
			ЗаписьJSON.ЗаписатьИмяСвойства(СтрокаКолонка.Имя);
			ЗначениеКолонки = СтрокаРезультат[СтрокаКолонка.Имя];
			Если СтрокаКолонка.Имя = "FIRM_NAME" Или СтрокаКолонка.Имя = "INFO" Тогда
				ЗначениеКолонки = СтрЗаменить(ЗначениеКолонки,"+","");	
				ЗначениеКолонки = СтрЗаменить(ЗначениеКолонки,"\","");
				ЗначениеКолонки = СтрЗаменить(ЗначениеКолонки,"/","");
			КонецЕсли;
			Если СтрокаКолонка.Имя = "SHIP_DATE" Тогда 
				Если ЗначениеЗаполнено(СтрокаРезультат[СтрокаКолонка.Имя]) Тогда 
					ЗначениеКолонки = Формат(СтрокаРезультат[СтрокаКолонка.Имя],"ДФ='yyyy-MM-dd HH:mm:ss'");
				КонецЕсли;
			КонецЕсли;
			Попытка
				ЗаписьJSON.ЗаписатьЗначение(ЗначениеКолонки);
			Исключение 
				#Если Клиент Тогда
					Сообщить("Ошибка записи файла документа отгрузки по колонке: " + СтрокаКолонка.Имя);
				#КонецЕсли
			КонецПопытки;
		КонецЦикла;	
		ЗаписьJSON.ЗаписатьКонецОбъекта();
	КонецЦикла;
	ЗаписьJSON.ЗаписатьКонецМассива();
	
	ЗаписьJSON.ЗаписатьИмяСвойства("items");
	ЗаписьJSON.ЗаписатьНачалоМассива();
	Для Каждого СтрокаРезультат Из РезультатТЧ Цикл
		ЗаписьJSON.ЗаписатьНачалоОбъекта();
		Для Каждого СтрокаКолонка Из РезультатТЧ.Колонки Цикл
			ЗаписьJSON.ЗаписатьИмяСвойства(СтрокаКолонка.Имя);
			ЗначениеКолонки = СтрокаРезультат[СтрокаКолонка.Имя];
			Попытка
				ЗаписьJSON.ЗаписатьЗначение(ЗначениеКолонки);
			Исключение 
				#Если Клиент Тогда
					Сообщить("Ошибка записи файла документа отгрузки по колонке: " + СтрокаКолонка.Имя);
				#КонецЕсли
			КонецПопытки;
		КонецЦикла;	
		ЗаписьJSON.ЗаписатьКонецОбъекта();
	КонецЦикла;
	ЗаписьJSON.ЗаписатьКонецМассива();
	ЗаписьJSON.ЗаписатьКонецОбъекта();
	СтрокаJS = ЗаписьJSON.Закрыть();
	
	ОтветСервера = ОтправитьДанныеJSON(СтруктураПодключения.АдресСервера,СтруктураПодключения.URLДокументовОтгрузки,СтруктураПодключения.GUID,СтрокаJS,Регистратор,Истина,СтатусВыгрузки);
	
КонецПроцедуры

// Процедура получает статусы по документам выгруженным в WMS
//
Процедура ПолучитьСтатусыДокументовLogisticonWMS(Регистратор) Экспорт
	
	СтруктураПодключения = ПолучитьДанныеПодключенияКWMS();
	
	Если ТипЗнч(Регистратор) = Тип("Массив") Тогда 
		Для Каждого СтрокаРегистратор Из Регистратор Цикл
			ПрефиксДокумента = ПолучитьПрефиксДокумента(СтрокаРегистратор);
			НомерДокумента = ПрефиксДокумента + СтрокаРегистратор.Номер + "_" + СтрЗаменить(Год(СтрокаРегистратор.Дата),Символы.НПП,"");
			Если ТипЗнч(Регистратор) = Тип("ДокументСсылка.ПоступлениеТоваровУслуг") Или ТипЗнч(Регистратор) = Тип("ДокументСсылка.ВозвратТоваровОтПокупателя")
				Или ТипЗнч(Регистратор) = Тип("ДокументСсылка.ОприходованиеТоваров") Тогда 
				СтрокаJS = ПолучитьДанныеJSON(СтруктураПодключения.АдресСервера,СтруктураПодключения.URLСтатусПриемки,СтруктураПодключения.GUID,НомерДокумента);
			Иначе
				СтрокаJS = ПолучитьДанныеJSON(СтруктураПодключения.АдресСервера,СтруктураПодключения.URLСтатусОтгрузки,СтруктураПодключения.GUID,НомерДокумента);
			КонецЕсли;			
			ЗаписатьСтатусыДокументовWMS(СтрокаРегистратор,СтрокаJS);		
		КонецЦикла;
	Иначе
		ПрефиксДокумента = ПолучитьПрефиксДокумента(Регистратор);
		НомерДокумента = ПрефиксДокумента + Регистратор.Номер + "_" + СтрЗаменить(Год(Регистратор.Дата),Символы.НПП,"");
		Если ТипЗнч(Регистратор) = Тип("ДокументСсылка.ПоступлениеТоваровУслуг") Или ТипЗнч(Регистратор) = Тип("ДокументСсылка.ВозвратТоваровОтПокупателя")
			Или ТипЗнч(Регистратор) = Тип("ДокументСсылка.ОприходованиеТоваров") Тогда 
			СтрокаJS = ПолучитьДанныеJSON(СтруктураПодключения.АдресСервера,СтруктураПодключения.URLСтатусПриемки,СтруктураПодключения.GUID,НомерДокумента);
		Иначе
			СтрокаJS = ПолучитьДанныеJSON(СтруктураПодключения.АдресСервера,СтруктураПодключения.URLСтатусОтгрузки,СтруктураПодключения.GUID,НомерДокумента);
		КонецЕсли;
		ЗаписатьСтатусыДокументовWMS(Регистратор,СтрокаJS);	
	КонецЕсли;	
	
КонецПроцедуры

// Процедура получает фактический статус по документу выгруженному в WMS
//
Процедура ПолучитьФактическиеСтатусыДокументаLogisticonWMS(Регистратор) Экспорт
	
	СтруктураПодключения = ПолучитьДанныеПодключенияКWMS();
	
	Если ТипЗнч(Регистратор) = Тип("Массив") Тогда 
		Для Каждого СтрокаРегистратор Из Регистратор Цикл
			ПрефиксДокумента = ПолучитьПрефиксДокумента(СтрокаРегистратор);
			НомерДокумента = ПрефиксДокумента + СтрокаРегистратор.Номер + "_" + СтрЗаменить(Год(СтрокаРегистратор.Дата),Символы.НПП,"");
			Если ТипЗнч(Регистратор) = Тип("ДокументСсылка.ПоступлениеТоваровУслуг") Или ТипЗнч(Регистратор) = Тип("ДокументСсылка.ВозвратТоваровОтПокупателя")
				Или ТипЗнч(Регистратор) = Тип("ДокументСсылка.ОприходованиеТоваров") Тогда 
