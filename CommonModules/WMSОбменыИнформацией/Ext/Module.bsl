	ТЗ.Колонки.Добавить("qty");
	ТЗ.Колонки.Добавить("sq_from");
	ТЗ.Колонки.Добавить("sq_name_from");
	ТЗ.Колонки.Добавить("sq_to");
	ТЗ.Колонки.Добавить("sq_name_to");
	ТЗ.Колонки.Добавить("date_prod");
	ТЗ.Колонки.Добавить("date_expire");
	ТЗ.Колонки.Добавить("part_nr");
	
	Для Каждого СтрокаСтруктуры Из СтруктураJS.items Цикл
		НС = ТЗ.Добавить();
		ЗаполнитьЗначенияСвойств(НС,СтрокаСтруктуры);		
	КонецЦикла;
	
	Возврат ТЗ;
	
