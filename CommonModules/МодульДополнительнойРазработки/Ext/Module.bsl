Функция ПолучитьПринтерПоУмолчанию() Экспорт
    
    Скрипт = Новый COMОбъект("MSScriptControl.ScriptControl");
    Скрипт.Language = "vbscript";                 
    Скрипт.AddCode("
         |Function GetDefaultPrinter()
         |GetDefaultPrinter=vbNullString
         |Set objWMIService=GetObject(""winmgmts:"" _
         |& ""{impersonationLevel=impersonate}!\\.\root\cimv2"")
         |Set colInstalledPrinters=objWMIService.ExecQuery _
         |(""Select * from Win32_Printer"")
         |For Each objPrinter in colInstalledPrinters
         |If objPrinter.Attributes and 4 Then
         |GetDefaultPrinter=objPrinter.Name
         |Exit For
         |End If
         |Next
         |End Function");
         
    Возврат СокрЛП(Скрипт.run("GetDefaultPrinter"));
    
КонецФункции

Функция ПолучитьПринтерыСистемы() Экспорт
	
	СписокПринтеров = Новый СписокЗначений;
	
	Принтеры 			= Новый COMОбъект("WScript.Network");
    АктивныеПринтеры	= Принтеры.EnumPrinterConnections();
    i = 0;
    Пока i < АктивныеПринтеры.Count() - 1 Цикл
        СписокПринтеров.Добавить(АктивныеПринтеры.Item(i + 1));
        i = i + 2;
    КонецЦикла;
	
	Возврат СписокПринтеров;
	
КонецФункции

Процедура ПечатьСертификатов(Серии = Неопределено, СтруктураОформленияДокументов = Неопределено) Экспорт

	ОбработкиСертификатов = Обработки.ПечатьСертификатов.Создать();
	Если ТипЗнч(Серии) = Тип("ДокументСсылка.РеализацияТоваровУслуг")
		Или ТипЗнч(Серии) = Тип("ДокументСсылка.ПеремещениеТоваров") Тогда
		ОбработкиСертификатов.ВнешнийДокумент = Серии;
	ИначеЕсли ТипЗнч(Серии) = Тип ("СправочникСсылка.СерииНоменклатуры") Тогда
		ОбработкиСертификатов.ВнешнийЭлементСерии = Серии;
	КонецЕсли;
	
	Если СтруктураОформленияДокументов = Неопределено Тогда
		
		ФормаОбработкиСертификатов = ОбработкиСертификатов.ПолучитьФорму();
		ФормаОбработкиСертификатов.Открыть();
		
	Иначе
		
		ФормаОбработкиСертификатов = ОбработкиСертификатов.ПолучитьФорму("Форма",,СтруктураОформленияДокументов);
		ФормаОбработкиСертификатов.Открыть();
		
	КонецЕсли;

КонецПроцедуры // ПечатьЭтикеток()

Процедура ПриВыводеСтрокиСерий(ОформлениеСтроки, ДанныеСтроки) Экспорт
	
	Если ДанныеСтроки.РазрешеноПродажу И НЕ ДанныеСтроки.Фальсификат Тогда
		ОформлениеСтроки.ЦветТекста = WebЦвета.Зеленый;
	ИначеЕсли ДанныеСтроки.Фальсификат Тогда
		ОформлениеСтроки.ЦветТекста = WebЦвета.Красный;	
	ИначеЕсли НЕ ДанныеСтроки.РазрешеноПродажу Тогда
		ОформлениеСтроки.ЦветТекста = WebЦвета.Серый;	
	КонецЕсли;
	
КонецПроцедуры

Процедура УправлениеПризнакомЕстьОригинал(ДокументСсылка) Экспорт
	
	Если НЕ ЗначениеЗаполнено(ДокументСсылка) Тогда
		Возврат;
	КонецЕсли;
	
	ОбъектДокумент 							= ДокументСсылка.ПолучитьОбъект();
	ОбъектДокумент.ЕстьОригинал				= НЕ ОбъектДокумент.ЕстьОригинал;
	ОбъектДокумент.ОбменДанными.Загрузка	= Истина;
	ОбъектДокумент.Записать(РежимЗаписиДокумента.Запись);
	
КонецПроцедуры


Процедура ПечатьЗаключений(Характеристики = Неопределено, СтруктураОформленияДокументов = Неопределено) Экспорт

