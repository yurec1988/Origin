Процедура ВыбратьАдресДоставкиДляРегионов(ТекущаяСтрока, СтандартнаяОбработка, ЭтаФорма, Контрагент) Экспорт
	
	СтандартнаяОбработка = Ложь;
	
	Если Контрагент.Пустая() Тогда
		Возврат
	КонецЕсли;
	
	ФормаВыбора = РегистрыСведений.КонтактнаяИнформация.ПолучитьФормуСписка("ФормаСписка", ЭтаФорма);
	ФормаВыбора.РежимВыбора = Истина;
	ФормаВыбора.мВозвратДанныхКонтактнойИнформации = Истина;
	
	ФормаВыбора.РегистрСведенийСписок.Отбор.Объект.Значение = Контрагент;
	ФормаВыбора.РегистрСведенийСписок.Отбор.Объект.Использование = Истина;
	
	СтруктураОтбораАдресов = Новый СписокЗначений;
	СтруктураОтбораАдресов.Добавить(Перечисления.ТипыКонтактнойИнформации.Адрес);
	ФормаВыбора.РегистрСведенийСписок.Отбор.Тип.ВидСравнения = ВидСравнения.ВСписке;
	ФормаВыбора.РегистрСведенийСписок.Отбор.Тип.Значение = СтруктураОтбораАдресов;
	ФормаВыбора.РегистрСведенийСписок.Отбор.Тип.Использование = Истина;
	ФормаВыбора.ЭлементыФормы.РегистрСведенийСписок.Колонки.Тип.Видимость = Ложь;
	
	СтруктураАдреса = ФормаВыбора.ОткрытьМодально();
	
	// Устанавливаем адрес доставки и его комментарий
	Если СтруктураАдреса <> Неопределено Тогда
		
		ТекущаяСтрока.Адрес = УправлениеКонтактнойИнформацией.ПолучитьПолныйАдрес(СтруктураАдреса);
		
	КонецЕсли;
	
КонецПроцедуры

Функция ПроверитьАптекиКонтрагента(Контрагент) Экспорт
	
	Если Контрагент.Пустая() Тогда
		
		Возврат Ложь;
		
	КонецЕсли;
	
	СпрАптеки = Справочники.Аптеки;
	Выборка = СпрАптеки.Выбрать(,Контрагент);
	
	Если НЕ Выборка.Следующий() Тогда
		
		Возврат Ложь;
		
	КонецЕсли;
	
	Возврат Истина;	
	
КонецФункции


Процедура ИнвентироватьПроцентСкидкиНаценки(Объект, ТаблицаТоваров, ТекущаяСтрока, ТекущаяКолонка) Экспорт
	
	Если ТекущаяКолонка = "Наценка" Тогда
		
		ТекущаяСтрока.ПроцентСкидкиНаценки = ТекущаяСтрока.Наценка * -1;
		
	ИначеЕсли ТекущаяКолонка = "ПроцентСкидкиНаценки" Тогда
		
		ТекущаяСтрока.Наценка = ТекущаяСтрока.ПроцентСкидкиНаценки * -1;	
		
	КонецЕсли;
	//ОбработкаТабличныхЧастей.РассчитатьСуммуТабЧасти(ТекущаяСтрока, Объект);
	//ОбработкаТабличныхЧастей.РассчитатьСуммуНДСТабЧасти(ТекущаяСтрока, Объект);
	//РасчитатьОтпускнуюЦенуДокумента(ТекущаяСтрока);
	
	Для Каждого ТекСтрока Из ТаблицаТоваров Цикл
		
		Если ТекСтрока <> ТекущаяСтрока И ТекСтрока.Наценка = 0 Тогда
			
			ТекСтрока.Наценка 				= ТекущаяСтрока.Наценка;	
			ТекСтрока.ПроцентСкидкиНаценки 	= ТекущаяСтрока.ПроцентСкидкиНаценки;	
			
			ОбработкаТабличныхЧастей.РассчитатьСуммуТабЧасти(ТекСтрока, Объект);
			ОбработкаТабличныхЧастей.РассчитатьСуммуНДСТабЧасти(ТекСтрока, Объект);
			//РасчитатьОтпускнуюЦенуДокумента(ТекСтрока);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ПересчитатьСкидкуНаЦену(СтрокаТабличнойЧасти, ИмяТабличнойЧасти, МетаданныеДокумента, СпособРасчета = Неопределено) Экспорт
	
	НадоПерерасчет = Истина;
	
	Если НадоПерерасчет Тогда
		
		Если (СпособРасчета = Неопределено)
		 Или (СпособРасчета = Перечисления.СпособРасчетаСуммыДокумента.СУчетомВсехСкидок)
		 Или (СпособРасчета = Перечисления.СпособРасчетаСуммыДокумента.БезУчетаРучнойСкидки) Тогда
			Если (СпособРасчета <> Перечисления.СпособРасчетаСуммыДокумента.БезУчетаРучнойСкидки)Тогда
				Если ОбщегоНазначения.ЕстьРеквизитТабЧастиДокумента("Наценка", МетаданныеДокумента, ИмяТабличнойЧасти) Тогда
					
					Попытка
						НацененнаяЦена 				= Окр(СтрокаТабличнойЧасти.Цена + СтрокаТабличнойЧасти.Цена * СтрокаТабличнойЧасти.Наценка / 100, 2);						
						СтрокаТабличнойЧасти.Сумма	= НацененнаяЦена * СтрокаТабличнойЧасти.Количество;		
					Исключение
					КонецПопытки;
					
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
				
	КонецЕсли;
	
КонецПроцедуры


Процедура РасчитатьОтпускнуюЦенуДокумента(СтрокаТабличнойЧасти) Экспорт
	
	Попытка
		Если СтрокаТабличнойЧасти.Количество = 0 Тогда
			
			СтрокаТабличнойЧасти.ОтпускнаяЦена = 0;
			Возврат;
			
		КонецЕсли;
		
		СтрокаТабличнойЧасти.ОтпускнаяЦена = Окр(СтрокаТабличнойЧасти.Сумма / СтрокаТабличнойЧасти.Количество,2); 	
	Исключение
	КонецПопытки;
	
КонецПроцедуры

Процедура ПересчитатьОтпускнуюЦенуДокумента(ТабличнаяЧасть) Экспорт
	
	Для Каждого СтрокаТабличнойЧасти ИЗ ТабличнаяЧасть Цикл
		
		Если СтрокаТабличнойЧасти.Количество = 0 Тогда
			
			ОтпускнаяЦена = 0;
			
			Если СтрокаТабличнойЧасти.ОтпускнаяЦена <> ОтпускнаяЦена Тогда
				
				СтрокаТабличнойЧасти.ОтпускнаяЦена = ОтпускнаяЦена;
				
			КонецЕсли;
			
			Продолжить;		
			
		КонецЕсли;
		
		//... получим цену сразу
		ОтпускнаяЦена = Окр(СтрокаТабличнойЧасти.Сумма / СтрокаТабличнойЧасти.Количество,2); 	
		
		Если СтрокаТабличнойЧасти.ОтпускнаяЦена <> ОтпускнаяЦена Тогда
			
			СтрокаТабличнойЧасти.ОтпускнаяЦена = ОтпускнаяЦена;
			
		КонецЕсли; 
		
	КонецЦикла;
	
КонецПроцедуры

//используется в РеализацииТоваровУслуг  (вытянул из списания партий в БУ)
Функция ВычислитьСебестоимостьТовара(СтрокаТовар,ДокументОбъект)   Экспорт 
	
	СебестоимостьПозиции = 0;
	
	Запрос = Новый Запрос;
	
	ВидСубконтоНоменклатура          = ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.Номенклатура;
	ВидСубконтоПартии                = ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.Партии;
	ВидСубконтоСклады                = ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.Склады;
	ВидСубконтоКонтрагенты           = ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.Контрагенты;
	ВидСубконтоОтгрузки              = ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.ДокументыРасчетовСКонтрагентами;
	ВидСубконтоНоменклатурныеПозиции = ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.НоменклатурныеПозиции;
	
	ВидыСубконтоНСПД = Новый Массив;
	ВидысубконтоНСПД.Добавить(ВидСубконтоНоменклатура);
	ВидысубконтоНСПД.Добавить(ВидСубконтоПартии);
	ВидысубконтоНСПД.Добавить(ВидСубконтоСклады);
	ВидысубконтоНСПД.Добавить(ВидСубконтоНоменклатурныеПозиции);
	
	МоментКон = ДокументОбъект.МоментВремени();
	
	НалоговыеНазначения = Новый Массив;
	НалоговыеНазначения.Добавить(Справочники.НалоговыеНазначенияАктивовИЗатрат.НайтиПоКоду("000031"));//	"Необл. НДС, любая хоз.;
	НалоговыеНазначения.Добавить(Справочники.НалоговыеНазначенияАктивовИЗатрат.НайтиПоКоду("000033"));//	"Обл. НДС";
	
	Номенклатура = Новый Массив;
	Номенклатура.Добавить(СтрокаТовар.Номенклатура);
	
	Организации = Новый Массив;
	Организации.Добавить(ДокументОбъект.Организация);
	
	ПустаяДата = Дата("00010101");
	ПустаяОтгрузка = Документы.ДокументРасчетовСКонтрагентом.ПустаяСсылка();
	
	Склады = Новый Массив;
	//Серж
	//Склады.Добавить(ДокументОбъект.Склад);
	Склады.Добавить(СтрокаТовар.Склад);
	//...Серж
	
	СчетаУчетаНСПД = Новый СписокЗначений;
	СчетаУчетаНСПД.Добавить(ПланыСчетов.Хозрасчетный.ТоварыНаСкладе);//281
	
	Запрос.УстановитьПараметр("ВидысубконтоНСПД", ВидысубконтоНСПД);
	Запрос.УстановитьПараметр("МоментКон", МоментКон);
	Запрос.УстановитьПараметр("НалоговыеНазначения", НалоговыеНазначения);
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.УстановитьПараметр("Организации", Организации);
	Запрос.УстановитьПараметр("ПустаяДата", ПустаяДата);
	Запрос.УстановитьПараметр("ПустаяОтгрузка", ПустаяОтгрузка);
	Запрос.УстановитьПараметр("Склады", Склады);
	Запрос.УстановитьПараметр("СчетаУчетаНСПД", СчетаУчетаНСПД);
	
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Остатки.Счет КАК СчетУчета,
	|	Остатки.Субконто1 КАК Номенклатура,
	|	Остатки.Субконто4.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
	|	Остатки.Субконто4.СерияНоменклатуры КАК СерияНоменклатуры,
	|	Остатки.Субконто4.ЗаказПокупателя КАК ЗаказПокупателя,
	|	0 КАК СовпалЗаказ,
	|	Остатки.Субконто4.Качество КАК Качество,
	|	Остатки.Субконто4 КАК НоменклатурнаяПозиция,
	|	ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0) КАК ДокументОприходованияДата,
	|	Остатки.Субконто2 КАК ДокументОприходования,
	|	&ПустаяДата КАК ДокументОтгрузкиДата,
	|	&ПустаяОтгрузка КАК ДокументОтгрузки,
	|	Остатки.Субконто3 КАК Склад,
	|	Остатки.Организация КАК Организация,
	|	Остатки.НалоговоеНазначение КАК НалоговоеНазначение,
	|	СУММА(ВЫБОР
	|			КОГДА Остатки.КоличествоОстатокДт ЕСТЬ NULL 
	|				ТОГДА 0
	|			ИНАЧЕ Остатки.КоличествоОстатокДт
	|		КОНЕЦ) КАК Количество,
	|	СУММА(ВЫБОР
	|			КОГДА Остатки.СуммаОстатокДт ЕСТЬ NULL 
	|				ТОГДА 0
	|			ИНАЧЕ Остатки.СуммаОстатокДт
	|		КОНЕЦ) КАК Стоимость,
	|	СУММА(ВЫБОР
	|			КОГДА Остатки.СуммаНУОстатокДт ЕСТЬ NULL 
	|				ТОГДА 0
	|			ИНАЧЕ Остатки.СуммаНУОстатокДт
	|		КОНЕЦ) КАК СтоимостьНУ
	|ИЗ
	|	РегистрБухгалтерии.Хозрасчетный.Остатки(
	|			&МоментКон,
	|			Счет В (&СчетаУчетаНСПД),
	|			&ВидысубконтоНСПД,
	|			Субконто1 В (&Номенклатура)
	|				И Субконто3 В (&Склады)
	|				И Организация В (&Организации)
	|				И НалоговоеНазначение В (&НалоговыеНазначения)) КАК Остатки
	|
	|СГРУППИРОВАТЬ ПО
	|	Остатки.Счет,
	|	Остатки.Субконто1,
	|	Остатки.Субконто2,
	|	Остатки.Субконто3,
	|	Остатки.Субконто4.ХарактеристикаНоменклатуры,
	|	Остатки.Субконто4.СерияНоменклатуры,
	|	Остатки.Субконто4.ЗаказПокупателя,
	|	Остатки.Субконто4.Качество,
	|	Остатки.Субконто4,
	|	Остатки.Организация,
	|	Остатки.НалоговоеНазначение
	|ИТОГИ ПО
	|	Номенклатура";
	
	
	Результат = Запрос.Выполнить();
	
	ВыборкаНоменклатура = Результат.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаНоменклатура.Следующий() Цикл
		// Вставить обработку выборки ВыборкаНоменклатура
		
		ВыборкаДетальныеЗаписи = ВыборкаНоменклатура.Выбрать();
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			
			Если ВыборкаДетальныеЗаписи.НоменклатурнаяПозиция.СерияНоменклатуры = СтрокаТовар.СерияНоменклатуры 
				и ВыборкаДетальныеЗаписи.НоменклатурнаяПозиция.ХарактеристикаНоменклатуры = СтрокаТовар.ХарактеристикаНоменклатуры
				и ВыборкаДетальныеЗаписи.Количество <> 0 Тогда
				
				СебестоимостьПозиции = Окр(ВыборкаДетальныеЗаписи.Стоимость/ВыборкаДетальныеЗаписи.Количество,2);
				
			КонецЕсли;
			// Вставить обработку выборки ВыборкаДетальныеЗаписи
		КонецЦикла;
	КонецЦикла;
	
	Возврат СебестоимостьПозиции;
	
КонецФункции // ВычислитьСебестоимостьТовара(СтрокаТовар,ЭтотОбъект)()


//записываем цены поступления в долларах
Процедура ЗаписатьЦеныПоступленияВДолларах(ДокументОбъект) Экспорт 
	
	Если ДокументОбъект.Товары.Количество()=0 Тогда
		Возврат;	
	КонецЕсли;
	
	ВалютаГривна = Справочники.Валюты.НайтиПоКоду("980");//грн
	ВалютаДоллар =  Справочники.Валюты.НайтиПоКоду("840");//USD
	
	Если ДокументОбъект.ВалютаДокумента<>ВалютаГривна и  ДокументОбъект.ВалютаДокумента<>ВалютаДоллар  Тогда
		//Предупреждение("В этом режиме можно установить цены только если валюта документа гривна или доллар");
		Возврат;
	КонецЕсли;
	
	ТипЦенПоступлениеВДолларах = Справочники.ТипыЦенНоменклатуры.НайтиПоКоду("000000004");//Цена поступления USD	
	КурсВалютыЧисло = МодульВалютногоУчета.ПолучитьКурсВалюты(ВалютаДоллар,ДокументОбъект.Дата)["Курс"];
	
	УстановкаЦенОбъект = НайтиУстановкуЦен(ДокументОбъект);
	Если УстановкаЦенОбъект=Неопределено Тогда
		УстановкаЦенОбъект = Документы.УстановкаЦенНоменклатуры.СоздатьДокумент();
	КонецЕсли;
	
	УстановкаЦенОбъект.Дата = ДокументОбъект.Дата;
	УстановкаЦенОбъект.ДокументОснование = ДокументОбъект.Ссылка;
	УстановкаЦенОбъект.Комментарий = "Создан автоматически при проведении "+ДокументОбъект.Ссылка;
	
	//очищаем все значения (если документ уже существует)
	УстановкаЦенОбъект.ТипыЦен.Очистить();
	УстановкаЦенОбъект.Товары.Очистить();
	
	СтрокаТипыЦен = УстановкаЦенОбъект.ТипыЦен.Добавить();
	СтрокаТипыЦен.ТипЦен = ТипЦенПоступлениеВДолларах;
	
	               
	Для каждого СтрокаТовары Из ДокументОбъект.Товары Цикл
		//при возврате записываем цены только для вновь созданной характеристики
		Если ТипЗнч(ДокументОбъект)=Тип("ДокументОбъект.ВозвратТоваровОтПокупателя") 
			и Сред(СтрокаТовары.ХарактеристикаНоменклатуры.Наименование,1,2) <> "ВН" Тогда
			Продолжить;
		КонецЕсли;
		//Леонид 111213
		Если СтрокаТовары.Номенклатура.ВидНоменклатуры<>Справочники.ВидыНоменклатуры.НайтиПоКоду("000000001") Тогда  //товар
			Продолжить;
		КонецЕсли;
		//...Леонид 111213
		
		НоваяСтрокаТоваров = УстановкаЦенОбъект.Товары.Добавить();
		НоваяСтрокаТоваров.Номенклатура = СтрокаТовары.Номенклатура;
		НоваяСтрокаТоваров.ХарактеристикаНоменклатуры = СтрокаТовары.ХарактеристикаНоменклатуры;
		НоваяСтрокаТоваров.Валюта = ВалютаДоллар;
		НоваяСтрокаТоваров.ИндексСтрокиТаблицыЦен = 0;
		НоваяСтрокаТоваров.ТипЦен = ТипЦенПоступлениеВДолларах;
		НоваяСтрокаТоваров.ЕдиницаИзмерения = СтрокаТовары.ЕдиницаИзмерения;
		НоваяСтрокаТоваров.СпособРасчетаЦены = ТипЦенПоступлениеВДолларах.СпособРасчетаЦены;
		
		Если ДокументОбъект.ВалютаДокумента = ВалютаДоллар  Тогда
			НоваяСтрокаТоваров.Цена = СтрокаТовары.Цена;
		ИначеЕсли ДокументОбъект.ВалютаДокумента = ВалютаГривна тогда	
			НоваяСтрокаТоваров.Цена = Окр(СтрокаТовары.Цена/КурсВалютыЧисло,2);
		КонецЕсли;
	КонецЦикла; 
	
	//проверяем на заполненность товаров в установке цен
	Если УстановкаЦенОбъект.Товары.Количество()=0 Тогда
		Возврат;
	КонецЕсли;
	
	//убираем дубли
	ТаблицаПодготовленная = УстановкаЦенОбъект.Товары.Выгрузить();
	ТаблицаПодготовленная.Свернуть("Номенклатура,ХарактеристикаНоменклатуры,Валюта,ИндексСтрокиТаблицыЦен,ТипЦен,ЕдиницаИзмерения,СпособРасчетаЦены,Цена");
	УстановкаЦенОбъект.Товары.Загрузить(ТаблицаПодготовленная);	
	
	Попытка
		//Серж
		//УстановкаЦенОбъект.Записать(РежимЗаписиДокумента.Проведение);	
		УстановкаЦенОбъект.Записать(РежимЗаписиДокумента.Запись);
		//...Серж
	Исключение
		Сообщить("Не удалось записать и провести установку цен поступления в долларах!");
		Сообщить(ОписаниеОшибки());
		Возврат;
	КонецПопытки;	
	 Сообщить("Записан документ "+УстановкаЦенОбъект);
	
КонецПроцедуры

Функция НайтиУстановкуЦен(ДокументОбъект)
	
	СписокТиповЦен = Новый СписокЗначений;
	СписокТиповЦен.Добавить(Справочники.ТипыЦенНоменклатуры.НайтиПоКоду("000000004"));//Цена поступления USD
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	УстановкаЦенНоменклатуры.Ссылка
	|ИЗ
	|	Документ.УстановкаЦенНоменклатуры КАК УстановкаЦенНоменклатуры
	|ГДЕ
	|	УстановкаЦенНоменклатуры.ДокументОснование = &ДокументОснование
	|	И УстановкаЦенНоменклатуры.ТипыЦен.ТипЦен В (&ТипЦен)";
	
	Запрос.УстановитьПараметр("ДокументОснование", ДокументОбъект.ссылка);
	Запрос.УстановитьПараметр("ТипЦен",СписокТиповЦен );
	
	Результат = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = Результат.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() тогда
		Возврат ВыборкаДетальныеЗаписи.ссылка.ПолучитьОбъект();
	иначе
		Возврат Неопределено;
	КонецЕсли;
	
	
КонецФункции // НайтиСоздатьУстановкуЦен(ДокументОбъект)()

//============================ПРОЦЕДУРЫ АВТОМАТИЧЕСКОЙ РАССЫЛКИ ДОКУМЕНТОВ====================================
#Если Клиент Тогда

Функция ПолучитьГруппуПисемУчетнойЗаписи(УчетнаяЗапись, НаименованиеГруппы)
	ГруппыПисем = Справочники.ГруппыПисемЭлектроннойПочты;
	Возврат ГруппыПисем.НайтиПоНаименованию(НаименованиеГруппы,Истина,,УчетнаяЗапись);
КонецФункции	
	
Функция ПолучитьНазваниеДокумента(НазваниеФайла) 
	
	Если НазваниеФайла = "Накладная_2" Тогда
		
		Возврат "'ОЛФА' Расходная накладная № ";
		
	ИначеЕсли НазваниеФайла = "Накладная" Тогда
		
		Возврат "'ОЛФА' Расходная накладная №";
		
	ИначеЕсли НазваниеФайла = "Акт" Тогда
		
		Возврат "'ОЛФА' Акт об оказании услуг №";	
		
	ИначеЕсли НазваниеФайла = "Сертификаты" Тогда
		
		Возврат "'ОЛФА' Печать сертификатов по расходной накладной №";
		
	ИначеЕсли НазваниеФайла = "Реестр" Тогда
		
		Возврат "'ОЛФА' Реестр № ";
		
	ИначеЕсли НазваниеФайла = "АдресДоставки" Тогда
		
		Возврат "'ОЛФА' Адрес доставки по расходной накладной № ";
		
	ИначеЕсли НазваниеФайла = "СчетФактура" Тогда
		
		Возврат "'ОЛФА' Счет-фактура № ";
		
	ИначеЕсли НазваниеФайла = "Бланк" Тогда
		
		Возврат "'ОЛФА' Бланк товарного наполнения № ";
		
	ИначеЕсли НазваниеФайла = "СерийныеНомера" Тогда
		
		Возврат "'ОЛФА' Список серийных номеров по расходной накладной № ";
		
	ИначеЕсли НазваниеФайла = "РасходСРозничныхСкладовВЦенахАТТ" Тогда
		
		Возврат "Расход с розничных складов в ценах АТТ";
		
	ИначеЕсли НазваниеФайла = "ТТН" Тогда
		
		Возврат "'ОЛФА' ТТН по расходной накладной № ";
		
	ИначеЕсли НазваниеФайла = "ТТН" Тогда
		
		Возврат "'ОЛФА' Налоговая накладная № ";
		
	КонецЕсли;		
	
	Возврат НазваниеФайла;
	
КонецФункции

Процедура ЗаписатьПечатнуюФормуВФайл(Ссылка, НазваниеФайла, ТабДокумент) Экспорт
	
	КаталогСохранения = КаталогВременныхФайлов()+"\Docs";
	
	МассивНайденныхКаталогов = НайтиФайлы(КаталогСохранения);
	
	Если МассивНайденныхКаталогов.Количество() = 0 Тогда
		
		СоздатьКаталог(КаталогСохранения);
				
	КонецЕсли;
	
	НазваниеФайла = ПолучитьНазваниеДокумента(НазваниеФайла);
	
	Если ТипЗнч(Ссылка) = Тип("Дата") Тогда
		
		ПолныйПутьФайла = КаталогСохранения +"\"+ НазваниеФайла + "_" + Формат(Ссылка,"ДЛФ=ДД")+".XLS"; 
		
	Иначе
		
		ПолныйПутьФайла = КаталогСохранения +"\"+ НазваниеФайла + "" + СокрЛП(Ссылка.Номер)+".XLS"; 	
		
	КонецЕсли;
	
	Если ТипЗнч(ТабДокумент) = Тип("ТабличныйДокумент") Тогда
		
		ТабДокумент.Записать(ПолныйПутьФайла,ТипФайлаТабличногоДокумента.XLS97);
        УстановитьПарольНаИзмененияФайла(ПолныйПутьФайла);
			
	КонецЕсли;
	
КонецПроцедуры

