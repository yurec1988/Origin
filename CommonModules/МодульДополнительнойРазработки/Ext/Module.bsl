Процедура ЗаполнитьДанныеХарактеристикиВСтроке(СтрокаТабличнойЧасти) Экспорт 
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ХарактеристикиНоменклатуры.Ссылка,
	|	ЕСТЬNULL(ЗначенияСвойствОбъектовСертификат.Значение, """") КАК НомерСертификата,
	|	ЕСТЬNULL(ЗначенияСвойствОбъектовДатаСертификата.Значение, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаСертификата,
	|	ЕСТЬNULL(ЗначенияСвойствОбъектовВисновок.Значение, """") КАК НомерВисновка,
	|	ЕСТЬNULL(ЗначенияСвойствОбъектовДатаВисновка.Значение, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаВисновка
	|ИЗ
	|	Справочник.ХарактеристикиНоменклатуры КАК ХарактеристикиНоменклатуры
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК ЗначенияСвойствОбъектовСертификат
	|		ПО ХарактеристикиНоменклатуры.Ссылка = ЗначенияСвойствОбъектовСертификат.Объект
	|			И (ЗначенияСвойствОбъектовСертификат.Свойство = &СвойствоСертификат)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК ЗначенияСвойствОбъектовДатаСертификата
	|		ПО ХарактеристикиНоменклатуры.Ссылка = ЗначенияСвойствОбъектовДатаСертификата.Объект
	|			И (ЗначенияСвойствОбъектовДатаСертификата.Свойство = &СвойствоДатаСертификата)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК ЗначенияСвойствОбъектовВисновок
	|		ПО ХарактеристикиНоменклатуры.Ссылка = ЗначенияСвойствОбъектовВисновок.Объект
	|			И (ЗначенияСвойствОбъектовВисновок.Свойство = &СвойствоВисновок)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК ЗначенияСвойствОбъектовДатаВисновка
	|		ПО ХарактеристикиНоменклатуры.Ссылка = ЗначенияСвойствОбъектовДатаВисновка.Объект
	|			И (ЗначенияСвойствОбъектовДатаВисновка.Свойство = &СвойствоДатаВисновка)
	|ГДЕ
	|	ХарактеристикиНоменклатуры.Ссылка = &ХарактеристикаСсылка";
	
	Запрос.УстановитьПараметр("СвойствоВисновок", ПланыВидовХарактеристик.СвойстваОбъектов.НомерВисновка);
	Запрос.УстановитьПараметр("СвойствоДатаВисновка", ПланыВидовХарактеристик.СвойстваОбъектов.ДатаВисновка);
	Запрос.УстановитьПараметр("СвойствоДатаСертификата", ПланыВидовХарактеристик.СвойстваОбъектов.ДатаСертификата);
	Запрос.УстановитьПараметр("СвойствоСертификат", ПланыВидовХарактеристик.СвойстваОбъектов.НомерСертификата);
	Запрос.УстановитьПараметр("ХарактеристикаСсылка", СтрокаТабличнойЧасти.ХарактеристикаНоменклатуры);
	
	Результат = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = Результат.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		
		СтрокаТабличнойЧасти.НомерСертификата = ВыборкаДетальныеЗаписи.НомерСертификата;
		СтрокаТабличнойЧасти.ДатаСертификата = ВыборкаДетальныеЗаписи.ДатаСертификата;
		СтрокаТабличнойЧасти.НомерВисновка = ВыборкаДетальныеЗаписи.НомерВисновка;
		СтрокаТабличнойЧасти.ДатаВисновка = ВыборкаДетальныеЗаписи.ДатаВисновка;
		
	КонецЕсли;;
	
КонецПроцедуры

//проверим заполнение свойств  характеристик при открытии документов поступления на случай возможного изменения их в карточке номенклатуры
Процедура ПерезаполнитьПоляПоСвойствамХарактеристик(Объект)   Экспорт 
	ДокуменИзменен = Ложь;
	Для каждого СтрокаТабличнойЧасти Из Объект.Товары Цикл
		Если ЗначениеЗаполнено(СтрокаТабличнойЧасти.ХарактеристикаНоменклатуры) Тогда
			
			
			Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ
			|	ХарактеристикиНоменклатуры.Ссылка,
			|	ЕСТЬNULL(ЗначенияСвойствОбъектовСертификат.Значение, """") КАК НомерСертификата,
			|	ЕСТЬNULL(ЗначенияСвойствОбъектовДатаСертификата.Значение, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаСертификата,
			|	ЕСТЬNULL(ЗначенияСвойствОбъектовВисновок.Значение, """") КАК НомерВисновка,
			|	ЕСТЬNULL(ЗначенияСвойствОбъектовДатаВисновка.Значение, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаВисновка
			|ИЗ
			|	Справочник.ХарактеристикиНоменклатуры КАК ХарактеристикиНоменклатуры
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК ЗначенияСвойствОбъектовСертификат
			|		ПО ХарактеристикиНоменклатуры.Ссылка = ЗначенияСвойствОбъектовСертификат.Объект
			|			И (ЗначенияСвойствОбъектовСертификат.Свойство = &СвойствоСертификат)
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК ЗначенияСвойствОбъектовДатаСертификата
			|		ПО ХарактеристикиНоменклатуры.Ссылка = ЗначенияСвойствОбъектовДатаСертификата.Объект
			|			И (ЗначенияСвойствОбъектовДатаСертификата.Свойство = &СвойствоДатаСертификата)
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК ЗначенияСвойствОбъектовВисновок
			|		ПО ХарактеристикиНоменклатуры.Ссылка = ЗначенияСвойствОбъектовВисновок.Объект
			|			И (ЗначенияСвойствОбъектовВисновок.Свойство = &СвойствоВисновок)
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК ЗначенияСвойствОбъектовДатаВисновка
			|		ПО ХарактеристикиНоменклатуры.Ссылка = ЗначенияСвойствОбъектовДатаВисновка.Объект
			|			И (ЗначенияСвойствОбъектовДатаВисновка.Свойство = &СвойствоДатаВисновка)
			|ГДЕ
			|	ХарактеристикиНоменклатуры.Ссылка = &ХарактеристикаСсылка";
			
			Запрос.УстановитьПараметр("СвойствоВисновок", ПланыВидовХарактеристик.СвойстваОбъектов.НомерВисновка);
			Запрос.УстановитьПараметр("СвойствоДатаВисновка", ПланыВидовХарактеристик.СвойстваОбъектов.ДатаВисновка);
			Запрос.УстановитьПараметр("СвойствоДатаСертификата", ПланыВидовХарактеристик.СвойстваОбъектов.ДатаСертификата);
			Запрос.УстановитьПараметр("СвойствоСертификат", ПланыВидовХарактеристик.СвойстваОбъектов.НомерСертификата);
			Запрос.УстановитьПараметр("ХарактеристикаСсылка", СтрокаТабличнойЧасти.ХарактеристикаНоменклатуры);
			
			Результат = Запрос.Выполнить();
			
			ВыборкаДетальныеЗаписи = Результат.Выбрать();
			
			Если ВыборкаДетальныеЗаписи.Следующий() Тогда
				
				Если СтрокаТабличнойЧасти.НомерСертификата <> ВыборкаДетальныеЗаписи.НомерСертификата Тогда
					СтрокаТабличнойЧасти.НомерСертификата = ВыборкаДетальныеЗаписи.НомерСертификата;
					ДокуменИзменен = Истина;
				КонецЕсли;
				
				Если СтрокаТабличнойЧасти.ДатаСертификата <> ВыборкаДетальныеЗаписи.ДатаСертификата Тогда
					СтрокаТабличнойЧасти.ДатаСертификата = ВыборкаДетальныеЗаписи.ДатаСертификата;
					ДокуменИзменен = Истина;
				КонецЕсли;
				
				Если СтрокаТабличнойЧасти.НомерВисновка <> ВыборкаДетальныеЗаписи.НомерВисновка Тогда
					СтрокаТабличнойЧасти.НомерВисновка = ВыборкаДетальныеЗаписи.НомерВисновка;
					ДокуменИзменен = Истина;
				КонецЕсли;
				
				Если СтрокаТабличнойЧасти.ДатаВисновка <> ВыборкаДетальныеЗаписи.ДатаВисновка Тогда
					СтрокаТабличнойЧасти.ДатаВисновка = ВыборкаДетальныеЗаписи.ДатаВисновка;
					ДокуменИзменен = Истина;
				КонецЕсли;
				
			КонецЕсли;;
		КонецЕсли;
	КонецЦикла;
	
	Если ДокуменИзменен  Тогда
		Объект.Записать();
	КонецЕсли;
	
	
КонецПроцедуры


//...используется при отборе характеристик с учетом остатков
Функция  ВыбратьТаблицуХарактеристикСОстаткамиНаСкладах(ПредварительныеХарактеристики,ДатаОстатков) Экспорт 
	ГотоваяТаблица = ПредварительныеХарактеристики.Скопировать();
	ГотоваяТаблица.Очистить();
	Для каждого строка Из ПредварительныеХарактеристики Цикл
		
		//СерияНоменклатуры = 
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПартииТоваровНаСкладахОстатки.КоличествоОстаток
		|ИЗ
		|	РегистрНакопления.ПартииТоваровНаСкладах.Остатки(
		|			&Период,
		|			Номенклатура = &Номенклатура
		//|				И СерияНоменклатуры = &СерияНоменклатуры
		|				И ХарактеристикаНоменклатуры = &ХарактеристикаНоменклатуры) КАК ПартииТоваровНаСкладахОстатки";
		
		Запрос.УстановитьПараметр("Номенклатура", строка.Характеристика.Владелец);
		Запрос.УстановитьПараметр("Период", ДатаОстатков);
		//Запрос.УстановитьПараметр("СерияНоменклатуры", СерияНоменклатуры);
		Запрос.УстановитьПараметр("ХарактеристикаНоменклатуры", строка.Характеристика);
		
		Результат = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = Результат.Выбрать();
		Если ВыборкаДетальныеЗаписи.Следующий() Тогда
			Если ВыборкаДетальныеЗаписи.КоличествоОстаток>0 Тогда
				НоваяСтрока = ГотоваяТаблица.Добавить();
				НоваяСтрока.ПометкаУдаления = строка.ПометкаУдаления;
				НоваяСтрока.Характеристика = строка.Характеристика;
			КонецЕсли; 
		КонецЕсли;
		
		
	КонецЦикла;	
	Возврат ГотоваяТаблица;
КонецФункции


Функция НайтиСериюПоХарактеристике(Характеристика)  Экспорт 
	
	СерияНоменклатуры = Справочники.СерииНоменклатуры.ПустаяСсылка();
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЗначенияСвойствОбъектов.Объект,
	|	ЗначенияСвойствОбъектов.Свойство,
	|	ЗначенияСвойствОбъектов.Значение
	|ИЗ
	|	РегистрСведений.ЗначенияСвойствОбъектов КАК ЗначенияСвойствОбъектов
	|ГДЕ
	|	ЗначенияСвойствОбъектов.Объект = &Объект
	|	И ЗначенияСвойствОбъектов.Свойство = &Свойство";
	
	Запрос.УстановитьПараметр("Объект", Характеристика);
	Запрос.УстановитьПараметр("Свойство", ПланыВидовХарактеристик.СвойстваОбъектов.Серия);
	
	Результат = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = Результат.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		СерияНоменклатуры=ВыборкаДетальныеЗаписи.Значение;
	КонецЕсли;
	
	Возврат СерияНоменклатуры;	
	
КонецФункции // НайтиСериюПоХарактеристике(Характеристика)()

Функция НайтиПартиюПоХарактеистике(Характеристика) Экспорт 
	Партия = Неопределено;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЗначенияСвойствОбъектов.Объект,
	|	ЗначенияСвойствОбъектов.Свойство,
	|	ЗначенияСвойствОбъектов.Значение
	|ИЗ
	|	РегистрСведений.ЗначенияСвойствОбъектов КАК ЗначенияСвойствОбъектов
	|ГДЕ
	|	ЗначенияСвойствОбъектов.Объект = &Объект
	|	И ЗначенияСвойствОбъектов.Свойство = &Свойство";
	
	Запрос.УстановитьПараметр("Объект", Характеристика);
	Запрос.УстановитьПараметр("Свойство", ПланыВидовХарактеристик.СвойстваОбъектов.Партия);
	
	Результат = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = Результат.Выбрать();
	
	Если  ВыборкаДетальныеЗаписи.Следующий() тогда
		Партия = ВыборкаДетальныеЗаписи.Значение;
	КонецЕсли;
	
	Возврат Партия;
	
КонецФункции // НайтиПартиюПоХарактеистике()

