Процедура ОтослатьДокументы(Объект, Email, КомуОтсылаем, ОткрыватьЭлектронноеПисьмо = Ложь ,КомуКопии = "", ЗапрашиватьТему = Ложь, ТемаИТекстПисьма = "") Экспорт
	
	Если НЕ ПустаяСтрока(Email) ИЛИ ОткрыватьЭлектронноеПисьмо Тогда
		
		СписокАдресовДляОтправки = РазобратьEMailАдреса(СокрЛП(Email));
		
		Если СписокАдресовДляОтправки.Количество() > 0 ИЛИ ОткрыватьЭлектронноеПисьмо Тогда
			
			//КомуАдресЭлектроннойПочты = КомуОтсылаем;
			КомуАдресЭлектроннойПочты = Email;
			
			УчетнаяЗаписьОтКого = УправлениеПользователями.ПолучитьЗначениеПоУмолчанию(глЗначениеПеременной("глТекущийПользователь"), "ОсновнаяУчетнаяЗапись");
			
			КаталогСохранения = КаталогВременныхФайлов()+"\Docs";
						
			МассивФайловОтправки = НайтиФайлы(КаталогСохранения,"*.*");//Ищем все что есть!!!!!!!!
			
			Если НЕ ЗначениеЗаполнено(УчетнаяЗаписьОтКого) Тогда
				
				Предупреждение("Для текущего пользователя не задана учетная запись электронной почты!");
				Возврат;
				
			КонецЕсли;
			
			Если МассивФайловОтправки.Количество() = 0 Тогда
				
				Сообщить("Нету файлов для отправки!",СтатусСообщения.Важное);
				Возврат;
				
			КонецЕсли;
			
			Если ПустаяСтрока(ТемаИТекстПисьма) Тогда
				ТемаИТекстПисьма = СформироватьТемуПисьма(Объект);
			КонецЕсли;
			
			//Юрий -- 24.06.2010 {UASOFT}
			Если ЗапрашиватьТему Тогда
				
				ВведеннаяСтрока = ВвестиСтроку(ТемаИТекстПисьма, "Введите тему письма...");
	            							
			КонецЕсли;
			//...Юрий -- 24.06.2010 {UASOFT}
			
			ЭлектронноеПисьмо 				= Документы.ЭлектронноеПисьмо.СоздатьДокумент();
			ЭлектронноеПисьмо.Дата 			= ТекущаяДата();
			ЭлектронноеПисьмо.Тема 			= ТемаИТекстПисьма;
			ЭлектронноеПисьмо.ТекстПисьма 	= ТемаИТекстПисьма;
			ЭлектронноеПисьмо.Кому 			= КомуАдресЭлектроннойПочты;	
			ЭлектронноеПисьмо.Копии			= КомуКопии;	
			
			ЭлектронноеПисьмо.ОтправительИмя 					= УчетнаяЗаписьОтКого.Наименование;
			ЭлектронноеПисьмо.ОтправительАдресЭлектроннойПочты	= УчетнаяЗаписьОтКого.АдресЭлектроннойПочты;
			ЭлектронноеПисьмо.ОтправительПредставление 			= УчетнаяЗаписьОтКого.Наименование + " <" + УчетнаяЗаписьОтКого.АдресЭлектроннойПочты + ">";
			
			ЭлектронноеПисьмо.УчетнаяЗапись 		= УчетнаяЗаписьОтКого;
			ЭлектронноеПисьмо.ГруппаУчетнойЗаписи	= ПолучитьГруппуПисемУчетнойЗаписи(УчетнаяЗаписьОтКого, "Исходящие");
			ЭлектронноеПисьмо.Ответственный 		= глЗначениеПеременной("глТекущийПользователь");
			ЭлектронноеПисьмо.Комментарий 			= "Сформировано автоматически. Момент формирования: " + ТекущаяДата();
			ЭлектронноеПисьмо.СтатусПисьма 			= Перечисления.СтатусыПисем.Исходящее;
			ЭлектронноеПисьмо.ВидТекстаПисьма 		= Перечисления.ВидыТекстовЭлектронныхПисем.Текст;
			ЭлектронноеПисьмо.ЕстьВложения 			= Истина;
			ИдентификаторПисьма 					= Строка(Новый УникальныйИдентификатор);
			ЭлектронноеПисьмо.ИдентификаторПисьма 	= ИдентификаторПисьма;
			
			Для Каждого ТекАдрес ИЗ СписокАдресовДляОтправки Цикл
			
				СтрокаКомуТЧ 						= ЭлектронноеПисьмо.КомуТЧ.Добавить();
				СтрокаКомуТЧ.Представление 			= КомуАдресЭлектроннойПочты + " <" + ТекАдрес + ">";;
				СтрокаКомуТЧ.АдресЭлектроннойПочты	= ТекАдрес;
				
			КонецЦикла;	
			
			ЭлектронноеПисьмо.Записать();
			
			Для Каждого ТекФайл ИЗ МассивФайловОтправки Цикл
				
				ВложениеЭлектронногоПисьма 				= Справочники.ВложенияЭлектронныхПисем.СоздатьЭлемент();
				ВложениеЭлектронногоПисьма.Объект 		= ЭлектронноеПисьмо.Ссылка;
				ВложениеЭлектронногоПисьма.ИмяФайла 	= ТекФайл.Имя;		
				ВложениеЭлектронногоПисьма.Хранилище 	= Новый ХранилищеЗначения(Новый ДвоичныеДанные(ТекФайл.ПолноеИмя));
				ВложениеЭлектронногоПисьма.Записать();	
				
				//Сразу удаляем файлы
				УдалитьФайлы(ТекФайл.ПолноеИмя);
				
			КонецЦикла;	
			
			
			Если ОткрыватьЭлектронноеПисьмо Тогда
				
				ЭлектронноеПисьмо.ПолучитьФорму().Открыть();	
				
			Иначе
				
				//...Отправляем
				ЭлектронноеПисьмо.ОтправитьПисьмо();
				
			КонецЕсли;
			
		КонецЕсли;		
		
	КонецЕсли; 				
	
КонецПроцедуры

Функция РазобратьEMailАдреса(СтрокаАдресовЭлектроннойПочты) Экспорт
	
	//Будем считать, что адреса разделяются символом ";"
	
	СписокАдресовДляОтправки = Новый СписокЗначений;
    
	ПозицияРазделителяАдресов = 100;
	
	Пока ПозицияРазделителяАдресов <> 0 Цикл
		
		ДлиннаСтрокиСАдресами = СтрДлина(СокрЛП(СтрокаАдресовЭлектроннойПочты));
		
		//... найдем первый разделитель
		ПозицияНайденногоРазделителя = Найти(СтрокаАдресовЭлектроннойПочты,";");
		
		Если ПозицияНайденногоРазделителя = 0 Тогда
			//... разделителя не нашли, адрес один всего
			
			СписокАдресовДляОтправки.Добавить(СокрЛП(СтрокаАдресовЭлектроннойПочты));
						
		Иначе	
			//... нашли символ разделителя
			
			СтрокаАдреса = СокрЛП(Лев(СтрокаАдресовЭлектроннойПочты,ПозицияНайденногоРазделителя - 1));
			СписокАдресовДляОтправки.Добавить(СтрокаАдреса);
			СтрокаАдресовЭлектроннойПочты = Сред(СтрокаАдресовЭлектроннойПочты,ПозицияНайденногоРазделителя + 1,ДлиннаСтрокиСАдресами - ПозицияНайденногоРазделителя + 1);
		
		КонецЕсли;
		
		ПозицияРазделителяАдресов = ПозицияНайденногоРазделителя;
		
	КонецЦикла;
	
	Возврат СписокАдресовДляОтправки;		
	
КонецФункции

Функция СформироватьТемуПисьма(Объект) Экспорт
	
	СтрокаТемы = "";
	КодЯзыкаПечать = Локализация.ПолучитьЯзыкФормированияПечатныхФорм(УправлениеПользователями.ПолучитьЗначениеПоУмолчанию(глЗначениеПеременной("глТекущийПользователь"), "РежимФормированияПечатныхФорм"));
	
	Если ТипЗнч(Объект) = Тип("ДокументОбъект.ЗаказПокупателя")
		ИЛИ ТипЗнч(Объект) = Тип("ДокументСсылка.ЗаказПокупателя") Тогда
		
		СтрокаТемы = НСтр("ru='Пакет документов по : ';uk='Пакет документів по: '",КодЯзыкаПечать)+Объект.Ссылка;
		
	ИначеЕсли ТипЗнч(Объект) = Тип("ДокументСсылка.РеализацияТоваровУслуг")
		ИЛИ ТипЗнч(Объект) = Тип("ДокументОбъект.РеализацияТоваровУслуг") Тогда
		
		Если НЕ ЗначениеЗаполнено(Объект.Сделка) Тогда
			
			СтрокаТемы = НСтр("ru='Пакет документов по : ';uk='Пакет документів по: '",КодЯзыкаПечать)+Объект.Ссылка;
			
		Иначе
			
			Если ТипЗнч(Объект.Сделка) = Тип("ДокументСсылка.ЗаказПокупателя") Тогда
				
				СтрокаТемы = НСтр("ru='Пакет документов по : ';uk='Пакет документів по: '",КодЯзыкаПечать)+Объект.Сделка;	
				
			Иначе
				
				СтрокаТемы = НСтр("ru='Пакет документов по : ';uk='Пакет документів по: '",КодЯзыкаПечать)+Объект.Ссылка;	
				
			КонецЕсли;
			
		КонецЕсли;
		
	ИначеЕсли ТипЗнч(Объект) = Тип("Строка") Тогда
		
		СтрокаТемы = НСтр("ru='Рассылка документов от : ';uk='Розсилка документів від : '",КодЯзыкаПечать)+УправлениеПользователями.ПолучитьЗначениеПоУмолчанию(глЗначениеПеременной("глТекущийПользователь"), "ОсновнаяОрганизация");;		
		
	Иначе
		
		СтрокаТемы = НСтр("ru='Рассылка документов от : ';uk='Розсилка документів від : '",КодЯзыкаПечать)+Объект.Организация;	
		
	КонецЕсли;	
	
	Возврат СтрокаТемы; 
	
КонецФункции
