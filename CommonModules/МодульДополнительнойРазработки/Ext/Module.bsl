//процедура запрета изменения документов вчерашним числом
Процедура ЗапретИзмененияДокументаПередЗаписью(Источник, Отказ, РежимЗаписи, РежимПроведения) Экспорт
	Если РольДоступна(Метаданные.Роли.ПравоИзменятьДокументыЗаднимЧислом)=Ложь Тогда
		//ДатаД=НачалоДня(Источник.Дата+60*60*24*15);
		ДатаД=НачалоДня(Источник.Дата);
		ДатаТ=НачалоДня(ТекущаяДата());
		Если ДатаТ>ДатаД Тогда
			Отказ=Истина;
			Сообщить("У пользователя нет права редактировать документ задним числом!",СтатусСообщения.Важное);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры


Процедура ПодпискаНаСобытие1ОбработкаПроведения(Источник, Отказ, РежимПроведения) Экспорт
	Если РольДоступна(Метаданные.Роли.ПравоПроводитьДокументы)=Ложь Тогда
					Отказ=Истина;
			Сообщить("У пользователя нет права проводить документы!",СтатусСообщения.Важное);
	КонецЕсли;

КонецПроцедуры


//процедуры создания серии и характеристики
Процедура ПроверитьЗаполнениеИСоздатьСерию(Объект,Отказ,ВидПрихода)Экспорт 
	
	ПроверитьЗаполнениеРеквизитовПоСерии(Объект,Отказ);
	
	СпрХарактеристики 			= Справочники.ХарактеристикиНоменклатуры;
	СпрСправочникСерии 			= Справочники.СерииНоменклатуры;
	ПустаяСерия 				= СпрСправочникСерии.ПустаяСсылка();
	
	Если НЕ Отказ Тогда
		
		Для Каждого ТекущаяСтрока ИЗ Объект.Товары Цикл                                                        
			
			Если НЕ ТекущаяСтрока.Номенклатура.ВестиУчетПоСериям ИЛИ НЕ ТекущаяСтрока.Номенклатура.ВестиУчетПоХарактеристикам Тогда                                        
				Продолжить;                                                                                    
			КонецЕсли;                                                                               
			
			//ИмяСерии =  СокрЛП(ТекущаяСтрока.НомерСерии)+", "+ТекущаяСтрока.НомерСертификата + ", "+Формат(ТекущаяСтрока.СрокГодности,"ДФ=dd.MM.yyyy");
			ИмяСерии =  СокрЛП(ТекущаяСтрока.НомерСерии)+ ", " + Формат(ТекущаяСтрока.СрокГодности,"ДФ=dd.MM.yyyy");
			
			Если НЕ ЗначениеЗаполнено(ТекущаяСтрока.СерияНоменклатуры)                                    
				ИЛИ НЕ ЗначениеЗаполнено(ТекущаяСтрока.СерияНоменклатуры.Владелец) Тогда                      
				
				//На всякий случай еще раз проверим присутсвие серии в справочнике
				
				ЗапросСерии = Новый Запрос;
				ЗапросСерии.Текст = 
				"ВЫБРАТЬ
				|	СерииНоменклатуры.Ссылка
				|ИЗ
				|	Справочник.СерииНоменклатуры КАК СерииНоменклатуры
				|ГДЕ
				|	СерииНоменклатуры.Владелец = &Владелец
				|	И СерииНоменклатуры.Наименование = &Наименование";
				
				ЗапросСерии.УстановитьПараметр("Владелец", ТекущаяСтрока.Номенклатура);
				ЗапросСерии.УстановитьПараметр("Наименование", ИмяСерии);
				
				
				ВыборкаДетальныеЗаписиСерии =  ЗапросСерии.Выполнить().Выбрать();
				
				Если ВыборкаДетальныеЗаписиСерии.Следующий() Тогда
					НайденнаяСерия = ВыборкаДетальныеЗаписиСерии.Ссылка;
				Иначе
					НайденнаяСерия = ПустаяСерия;
				КонецЕсли;
				
				
				//НайденнаяСерия 		= СпрСправочникСерии.НайтиПоРеквизиту("Наименование",СокрЛП(ТекущаяСтрока.НомерСерии)+" "+Формат(ТекущаяСтрока.СрокГодности,"ДФ=dd.MM.yy"),,ТекущаяСтрока.Номенклатура);
				
				Если НайденнаяСерия <> ПустаяСерия Тогда
					
					ТекущаяСтрока.СерияНоменклатуры = НайденнаяСерия;
					//Проверим характеристику и создадим ее если нету
					ПроверитьСоздатьХарактеристикуСтроки(Объект, ТекущаяСтрока, СпрХарактеристики, Отказ, ВидПрихода);
					
				Иначе
					//...создаем новые серии
					
					НоваяСерия 				= СпрСправочникСерии.СоздатьЭлемент();
					НоваяСерия.Владелец 	= ТекущаяСтрока.Номенклатура;
					НоваяСерия.СерийныйНомер= СокрЛП(ТекущаяСтрока.НомерСерии);       
					НоваяСерия.СрокГодности = ТекущаяСтрока.СрокГодности;
					//НоваяСерия.Сертификат 	= ТекущаяСтрока.НомерСертификата;
					НоваяСерия.Наименование = ИмяСерии ;
					//НоваяСерия.НомерВисновка 	= ТекущаяСтрока.НомерВисновка;
					//НоваяСерия.ДатаВисновка 	= ТекущаяСтрока.ДатаВисновка;
					//НоваяСерия.ТаможеннаяЦена 	= ТекущаяСтрока.ТаможеннаяЦена;
					//НоваяСерия.ТаможеннаяЦенаВалютная 	= ТекущаяСтрока.ТаможеннаяЦенаВалютная;
					//Пытаемся записать                          
					Попытка
						
						НоваяСерия.Записать();	
						
						ТекущаяСтрока.СерияНоменклатуры = НоваяСерия.Ссылка;
						//Проверим характеристику и создадим ее если нету
						ПроверитьСоздатьХарактеристикуСтроки(Объект, ТекущаяСтрока, СпрХарактеристики, Отказ, ВидПрихода);
						
					Исключение
						
						ТекстСообщения = "В строке № "+ТекущаяСтрока.НомерСтроки+" не записан элемент справочника Серии номенклатуры '"+ТекущаяСтрока.НомерСерии+"'
						|"+ОписаниеОшибки();
						
						ОбщегоНазначения.СообщитьОбОшибке(ТекстСообщения, Отказ);	
						
					КонецПопытки;
					
				КонецЕсли;				
				
			Иначе
				
				ПроверитьСоздатьХарактеристикуСтроки(Объект, ТекущаяСтрока, СпрХарактеристики, Отказ, ВидПрихода);
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;	
	
	
	
КонецПроцедуры

Процедура ПроверитьЗаполнениеРеквизитовПоСерии(Объект,Отказ) Экспорт
	
	Для Каждого ТекущаяСтрока ИЗ Объект.Товары Цикл
		
		Если НЕ ТекущаяСтрока.Номенклатура.ВестиУчетПоСериям ИЛИ НЕ ТекущаяСтрока.Номенклатура.ВестиУчетПоХарактеристикам Тогда
			Продолжить;                                                       
		КонецЕсли;
		
		//Если ТекущаяСтрока.НоваяСерия Тогда                                
		
		Если НЕ ЗначениеЗаполнено(ТекущаяСтрока.НомерСерии) Тогда
			
			ОбщегоНазначения.СообщитьОбОшибке("В строке № "+ТекущаяСтрока.НомерСтроки+" не заполнено поле 'НомерСерии'!", Отказ);	
			
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(ТекущаяСтрока.СрокГодности) Тогда
			
			ОбщегоНазначения.СообщитьОбОшибке("В строке № "+ТекущаяСтрока.НомерСтроки+" не заполнено поле 'Срок годности'!", Отказ);	
			
		КонецЕсли;
		
		//Если НЕ ЗначениеЗаполнено(ТекущаяСтрока.НомерСертификата) Тогда
		//	
		//	ОбщегоНазначения.СообщитьОбОшибке("В строке № "+ТекущаяСтрока.НомерСтроки+" не заполнено поле 'Номер сертификата'!", Отказ);	
		//	
		//КонецЕсли;                                        
		//
		//Если НЕ ЗначениеЗаполнено(ТекущаяСтрока.ДатаСертификата) Тогда
		//	
		//	ОбщегоНазначения.СообщитьОбОшибке("В строке № "+ТекущаяСтрока.НомерСтроки+" не заполнено поле 'Дата сертификата'!", Отказ);	
		//	
		//КонецЕсли;
		
		
		//Иначе
		//	
		//	Если НЕ ЗначениеЗаполнено(ТекущаяСтрока.СерияНоменклатуры) ИЛИ НЕ ЗначениеЗаполнено(ТекущаяСтрока.Серия) Тогда
		//		
		//		ОбщегоНазначения.СообщитьОбОшибке("В строке № "+ТекущаяСтрока.НомерСтроки+" не заполнено поле 'Cерия' или 'Серия номенклатуры'!", Отказ);	
		//		
		//	КонецЕсли;
		//	
		//КонецЕсли;
		
	КонецЦикла;	
	
КонецПроцедуры

Процедура ПроверитьСоздатьХарактеристикуСтроки(Объект, ТекущаяСтрока, СпрХарактеристики, Отказ, ЭтоОприходование = 2, СоздаватьХарактеристику = Истина) Экспорт
	
	Если ТипЗнч(Объект)=Тип("ДокументОбъект.ВозвратТоваровОтПокупателя") Тогда
		СоздаватьХарактеристику = Ложь;
	КонецЕсли;
	
	//Выясним заполнена ли характеристика или нет
	Если НЕ СоздаватьХарактеристику Тогда		
		Если ЗначениеЗаполнено(ТекущаяСтрока.ХарактеристикаНоменклатуры) Тогда
			Возврат;
		КонецЕсли;		
	КонецЕсли;                                                                        
	
	Если ЭтоОприходование = 1 Тогда 		//Оприходование
		НаименованиеХарактеристики = "ОП "+Объект.Номер+" "+ Формат(Объект.Дата,"ДФ=dd.MM.yy")+ "; "+ТекущаяСтрока.СерияНоменклатуры.Наименование;
	ИначеЕсли ЭтоОприходование = 2 Тогда	//Приходная
		НаименованиеХарактеристики = "ПН "+Объект.Номер+" "+ Формат(Объект.Дата,"ДФ=dd.MM.yy")+ "; "+ТекущаяСтрока.СерияНоменклатуры.Наименование;
	ИначеЕсли ЭтоОприходование = 3 Тогда	//Возврат				
		НаименованиеХарактеристики = "ВН "+Объект.Номер+" "+ Формат(Объект.Дата,"ДФ=dd.MM.yy")+ "; "+ТекущаяСтрока.СерияНоменклатуры.Наименование;
	ИначеЕсли ЭтоОприходование = 4 Тогда	//Приходный ордер на товары
		НаименованиеХарактеристики = "ПОТ "+Объект.Номер+" "+ Формат(Объект.Дата,"ДФ=dd.MM.yy")+ "; "+ТекущаяСтрока.СерияНоменклатуры.Наименование;		
	Иначе //ХЗ		
		НаименованиеХарактеристики = "ПН "+Объект.Номер+" "+ Формат(Объект.Дата,"ДФ=dd.MM.yy")+ "; "+ТекущаяСтрока.СерияНоменклатуры.Наименование;		
	КонецЕсли;	
	
	Если ЗначениеЗаполнено(ТекущаяСтрока.ХарактеристикаНоменклатуры) Тогда
		
		Попытка
			НоваяХарактеристика = ТекущаяСтрока.ХарактеристикаНоменклатуры.ПолучитьОбъект();
			
			Если СокрЛП(НоваяХарактеристика.Наименование) = НаименованиеХарактеристики  Тогда
				//Менять ничего не нужно
				
				
				НаборЗаписейЗначенияСвойств = РегистрыСведений.ЗначенияСвойствОбъектов.СоздатьНаборЗаписей();
				
				//.... партия
				Запись = НаборЗаписейЗначенияСвойств.Добавить();
				
				Запись.Объект   = НоваяХарактеристика.Ссылка;
				Запись.Свойство = ПланыВидовХарактеристик.СвойстваОбъектов.Партия;
				Запись.Значение = Объект.Ссылка;
				
				//.... Серия
				Запись = НаборЗаписейЗначенияСвойств.Добавить();
				
				Запись.Объект   = НоваяХарактеристика.Ссылка;
				Запись.Свойство = ПланыВидовХарактеристик.СвойстваОбъектов.Серия;
				Запись.Значение = ТекущаяСтрока.СерияНоменклатуры;
				
				//.... НомерСертификата
				Запись = НаборЗаписейЗначенияСвойств.Добавить();
				
				Запись.Объект   = НоваяХарактеристика.Ссылка;
				Запись.Свойство = ПланыВидовХарактеристик.СвойстваОбъектов.НомерСертификата;
				Запись.Значение = ТекущаяСтрока.НомерСертификата;
				
				//.... ДатаСертификата
				Запись = НаборЗаписейЗначенияСвойств.Добавить();
				
				Запись.Объект   = НоваяХарактеристика.Ссылка;
				Запись.Свойство = ПланыВидовХарактеристик.СвойстваОбъектов.ДатаСертификата;
				Запись.Значение = ТекущаяСтрока.ДатаСертификата;
				
				//.... НомерВисновка
				Запись = НаборЗаписейЗначенияСвойств.Добавить();                                        
				
				Запись.Объект   = НоваяХарактеристика.Ссылка;                                           
				Запись.Свойство = ПланыВидовХарактеристик.СвойстваОбъектов.НомерВисновка;
				Запись.Значение = ТекущаяСтрока.НомерВисновка;                                      
				
				//.... ДатаВисновка
				Запись = НаборЗаписейЗначенияСвойств.Добавить();
				
				Запись.Объект   = НоваяХарактеристика.Ссылка;
				Запись.Свойство = ПланыВидовХарактеристик.СвойстваОбъектов.ДатаВисновка;
				Запись.Значение = ТекущаяСтрока.ДатаВисновка;
				
				
				
				НаборЗаписейЗначенияСвойств.Отбор.Объект.Установить(НоваяХарактеристика.Ссылка);
				
				НаборЗаписейЗначенияСвойств.Записать();
				
				Возврат;
				//ИначеЕсли  СокрЛП(НоваяХарактеристика.Наименование) <> НаименованиеХарактеристики и ЭтоОприходование=3 тогда  //для возврата создаем новую характеристику
				//	
				//	НоваяХарактеристика = СпрХарактеристики.СоздатьЭлемент();
				
			КонецЕсли;
		Исключение
			
			//Если  СокрЛП(НоваяХарактеристика.Наименование) <> НаименованиеХарактеристики и ЭтоОприходование=3 тогда  //для возврата создаем новую характеристику
			//	
			//	НоваяХарактеристика = СпрХарактеристики.СоздатьЭлемент();
			//Иначе	
			
			НоваяХарактеристика = СпрХарактеристики.НайтиПоНаименованию(НаименованиеХарактеристики,Истина,,ТекущаяСтрока.Номенклатура);
			
			Если НоваяХарактеристика = СпрХарактеристики.ПустаяСсылка() Тогда 
				
				НоваяХарактеристика = СпрХарактеристики.СоздатьЭлемент();	
				
			Иначе
				
				ТекущаяСтрока.ХарактеристикаНоменклатуры = НоваяХарактеристика.Ссылка;
				
				
				НаборЗаписейЗначенияСвойств = РегистрыСведений.ЗначенияСвойствОбъектов.СоздатьНаборЗаписей();
				
				//.... партия
				Запись = НаборЗаписейЗначенияСвойств.Добавить();
				
				Запись.Объект   = НоваяХарактеристика.Ссылка;
				Запись.Свойство = ПланыВидовХарактеристик.СвойстваОбъектов.Партия;
				Запись.Значение = Объект.Ссылка;
				
				//.... Серия
				Запись = НаборЗаписейЗначенияСвойств.Добавить();
				
				Запись.Объект   = НоваяХарактеристика.Ссылка;
				Запись.Свойство = ПланыВидовХарактеристик.СвойстваОбъектов.Серия;
				Запись.Значение = ТекущаяСтрока.СерияНоменклатуры;
				
				//.... НомерСертификата
				Запись = НаборЗаписейЗначенияСвойств.Добавить();
				
				Запись.Объект   = НоваяХарактеристика.Ссылка;
				Запись.Свойство = ПланыВидовХарактеристик.СвойстваОбъектов.НомерСертификата;
				Запись.Значение = ТекущаяСтрока.НомерСертификата;
				
				//.... ДатаСертификата
				Запись = НаборЗаписейЗначенияСвойств.Добавить();
				
				Запись.Объект   = НоваяХарактеристика.Ссылка;
				Запись.Свойство = ПланыВидовХарактеристик.СвойстваОбъектов.ДатаСертификата;
				Запись.Значение = ТекущаяСтрока.ДатаСертификата;
				
				//.... НомерВисновка
				Запись = НаборЗаписейЗначенияСвойств.Добавить();                                        
				
				Запись.Объект   = НоваяХарактеристика.Ссылка;                                           
				Запись.Свойство = ПланыВидовХарактеристик.СвойстваОбъектов.НомерВисновка;
				Запись.Значение = ТекущаяСтрока.НомерВисновка;                                      
				
				//.... ДатаВисновка
				Запись = НаборЗаписейЗначенияСвойств.Добавить();
				
				Запись.Объект   = НоваяХарактеристика.Ссылка;
				Запись.Свойство = ПланыВидовХарактеристик.СвойстваОбъектов.ДатаВисновка;
				Запись.Значение = ТекущаяСтрока.ДатаВисновка;
				
				НаборЗаписейЗначенияСвойств.Отбор.Объект.Установить(НоваяХарактеристика.Ссылка);
				
				НаборЗаписейЗначенияСвойств.Записать();
				
				Возврат;
				//КонецЕсли;	
			КонецЕсли;		
		КонецПопытки;
		
	Иначе
		
		//не заполнена, создаем ее на базе серии
		
		//...Сразу попробуем найти по наименованию
		НоваяХарактеристика = СпрХарактеристики.НайтиПоНаименованию(НаименованиеХарактеристики,Истина,,ТекущаяСтрока.Номенклатура);
		
		Если НоваяХарактеристика = СпрХарактеристики.ПустаяСсылка() Тогда 
			
			НоваяХарактеристика = СпрХарактеристики.СоздатьЭлемент();	
			
		Иначе
			
			ТекущаяСтрока.ХарактеристикаНоменклатуры = НоваяХарактеристика.Ссылка;
			
			НаборЗаписейЗначенияСвойств = РегистрыСведений.ЗначенияСвойствОбъектов.СоздатьНаборЗаписей();
			
			//.... партия
			Запись = НаборЗаписейЗначенияСвойств.Добавить();
			
			Запись.Объект   = НоваяХарактеристика.Ссылка;
			Запись.Свойство = ПланыВидовХарактеристик.СвойстваОбъектов.Партия;
			Запись.Значение = Объект.Ссылка;
			
			//.... Серия
			Запись = НаборЗаписейЗначенияСвойств.Добавить();
			
			Запись.Объект   = НоваяХарактеристика.Ссылка;
			Запись.Свойство = ПланыВидовХарактеристик.СвойстваОбъектов.Серия;
			Запись.Значение = ТекущаяСтрока.СерияНоменклатуры;
			
			//.... НомерСертификата
			Запись = НаборЗаписейЗначенияСвойств.Добавить();
			
			Запись.Объект   = НоваяХарактеристика.Ссылка;
			Запись.Свойство = ПланыВидовХарактеристик.СвойстваОбъектов.НомерСертификата;
			Запись.Значение = ТекущаяСтрока.НомерСертификата;
			
			//.... ДатаСертификата
			Запись = НаборЗаписейЗначенияСвойств.Добавить();
			
			Запись.Объект   = НоваяХарактеристика.Ссылка;
			Запись.Свойство = ПланыВидовХарактеристик.СвойстваОбъектов.ДатаСертификата;
			Запись.Значение = ТекущаяСтрока.ДатаСертификата;
			
			//.... НомерВисновка
			Запись = НаборЗаписейЗначенияСвойств.Добавить();                                        
			
			Запись.Объект   = НоваяХарактеристика.Ссылка;                                           
			Запись.Свойство = ПланыВидовХарактеристик.СвойстваОбъектов.НомерВисновка;
			Запись.Значение = ТекущаяСтрока.НомерВисновка;                                      
			
			//.... ДатаВисновка
			Запись = НаборЗаписейЗначенияСвойств.Добавить();
			
			Запись.Объект   = НоваяХарактеристика.Ссылка;
			Запись.Свойство = ПланыВидовХарактеристик.СвойстваОбъектов.ДатаВисновка;
			Запись.Значение = ТекущаяСтрока.ДатаВисновка;
			
			НаборЗаписейЗначенияСвойств.Отбор.Объект.Установить(НоваяХарактеристика.Ссылка);
			
			НаборЗаписейЗначенияСвойств.Записать();
			
			Возврат;
			
		КонецЕсли;
		
	КонецЕсли;
	
	НоваяХарактеристика.Наименование	= НаименованиеХарактеристики;
	НоваяХарактеристика.Владелец 		= ТекущаяСтрока.Номенклатура;
	НоваяХарактеристика.НоменклатураГТД	= ТекущаяСтрока.Номенклатура.НоменклатураГТД;
	
	Попытка
		
		НоваяХарактеристика.Записать();
		ТекущаяСтрока.ХарактеристикаНоменклатуры = НоваяХарактеристика.Ссылка;
		
	Исключение
		
		ТекстСообщения = "В строке № "+ТекущаяСтрока.НомерСтроки+" не записан элемент справочника Характеристика номенклатуры '"+ТекущаяСтрока.Серия+"'
		|"+ОписаниеОшибки();
		
		ОбщегоНазначения.СообщитьОбОшибке(ТекстСообщения, Отказ);
		Возврат;
		
	КонецПопытки;
	
	//Запишем теперь свойства характеристики
	Попытка
		
		НаборЗаписейЗначенияСвойств = РегистрыСведений.ЗначенияСвойствОбъектов.СоздатьНаборЗаписей();
		
		//.... партия
		Запись = НаборЗаписейЗначенияСвойств.Добавить();
		
		Запись.Объект   = НоваяХарактеристика.Ссылка;
		Запись.Свойство = ПланыВидовХарактеристик.СвойстваОбъектов.Партия;
		Запись.Значение = Объект.Ссылка;
		
		//.... Серия
		Запись = НаборЗаписейЗначенияСвойств.Добавить();
		
		Запись.Объект   = НоваяХарактеристика.Ссылка;
		Запись.Свойство = ПланыВидовХарактеристик.СвойстваОбъектов.Серия;
		Запись.Значение = ТекущаяСтрока.СерияНоменклатуры;
		
		//.... НомерСертификата
		Запись = НаборЗаписейЗначенияСвойств.Добавить();
		
		Запись.Объект   = НоваяХарактеристика.Ссылка;
		Запись.Свойство = ПланыВидовХарактеристик.СвойстваОбъектов.НомерСертификата;
		Запись.Значение = ТекущаяСтрока.НомерСертификата;
		
		//.... ДатаСертификата
		Запись = НаборЗаписейЗначенияСвойств.Добавить();
		
		Запись.Объект   = НоваяХарактеристика.Ссылка;
		Запись.Свойство = ПланыВидовХарактеристик.СвойстваОбъектов.ДатаСертификата;
		Запись.Значение = ТекущаяСтрока.ДатаСертификата;
		
		//.... НомерВисновка
		Запись = НаборЗаписейЗначенияСвойств.Добавить();                                        
		
		Запись.Объект   = НоваяХарактеристика.Ссылка;                                           
		Запись.Свойство = ПланыВидовХарактеристик.СвойстваОбъектов.НомерВисновка;
		Запись.Значение = ТекущаяСтрока.НомерВисновка;                                      
		
		//.... ДатаВисновка
		Запись = НаборЗаписейЗначенияСвойств.Добавить();
		
		Запись.Объект   = НоваяХарактеристика.Ссылка;
		Запись.Свойство = ПланыВидовХарактеристик.СвойстваОбъектов.ДатаВисновка;
		Запись.Значение = ТекущаяСтрока.ДатаВисновка;
		
		НаборЗаписейЗначенияСвойств.Отбор.Объект.Установить(НоваяХарактеристика.Ссылка);
		
		НаборЗаписейЗначенияСвойств.Записать();
		
	Исключение
		
		ТекстСообщения = "В строке № "+ТекущаяСтрока.НомерСтроки+" не записан элемент справочника Характеристика номенклатуры '"+ТекущаяСтрока.Серия+"'
		|"+ОписаниеОшибки();
		
		ОбщегоНазначения.СообщитьОбОшибке(ТекстСообщения, Отказ);
		Возврат;
		
	КонецПопытки;	
	
КонецПроцедуры

