			лпПроводка = лпДвижения_Хозрасчетный.Получить(лпНомерПров - 1);
			// схема оптовый
			// удаляем 
			// схема розничный
			// удаляем 
			лпДвижения_Хозрасчетный.Удалить(лпНомерПров - 1);
			// проводка по строке
			лпНомерПров = лпНомерПров - 1;
		КонецЦикла;
		
		
		//	//***** Регистр накопления "Партии товаров на складах (налоговый учет)"
		//	лпДвижения_ПартииНУ =  прДвижения.ПартииТоваровНаСкладахНалоговыйУчет;
		//	лпНомерПров = лпДвижения_ПартииНУ.Количество();
		//	Пока лпНомерПров > 0 Цикл
		//		лпПроводка = лпДвижения_ПартииНУ.Получить(лпНомерПров - 1);
