// 
// Функция возвращает параметры учета по выбранному складу.
//
// Параметры:
//  прСклад         - место хранения, по которому определяются счета учета
//
// Возвращаемое значение:
//  Структура - структура содержащая параметры учета
// 
Функция ПолучитьТО_ПараметрыСкладов(прСклад = Неопределено) Экспорт
	
	СтруктураВозврата = Новый Структура("
	|Касса,
	|КассаККМ,
	|ВидОплаты,
	|БанковскийСчетЭквайринга,
	|ДоговорЭквайринга,
	|Склад");
	
	
	МассивСкладов = Новый Массив();
	
	МассивСкладов.Добавить(Справочники.Склады.ПустаяСсылка());
	
	Если ЗначениеЗаполнено(прСклад) Тогда
		МассивСкладов.Добавить(прСклад);
		//СписокГрупп = ПолучитьСписокВышестоящихГрупп(прСклад);
		Если ЗначениеЗаполнено(прСклад.Родитель) Тогда
			МассивСкладов.Добавить(прСклад.Родитель);
		КонецЕсли;
		Если ЗначениеЗаполнено(прСклад.Родитель.Родитель) Тогда
			МассивСкладов.Добавить(прСклад.Родитель.Родитель);
		КонецЕсли;
	КонецЕсли;
	
	ТестЗапрос = Новый Запрос();
	ТестЗапрос.УстановитьПараметр("Склад",МассивСкладов);
	
	ТестЗапрос.Текст = "
	|ВЫБРАТЬ
	|	ТО_ПараметрыСкладов.Склад КАК Склад,
	|	ТО_ПараметрыСкладов.Склад.ЭтоГруппа КАК ЭтоГруппа,
	|	ТО_ПараметрыСкладов.Касса КАК Касса,
	|	ТО_ПараметрыСкладов.КассаККМ КАК КассаККМ,
	|	ТО_ПараметрыСкладов.ДоговорЭквайринга КАК ДоговорЭквайринга,
	|	ТО_ПараметрыСкладов.БанковскийСчетЭквайринга КАК БанковскийСчетЭквайринга,
	|	ТО_ПараметрыСкладов.ВидОплаты КАК ВидОплаты
	|ИЗ
	|	РегистрСведений.ТО_ПараметрыСкладов КАК ТО_ПараметрыСкладов
	|ГДЕ
	|	ТО_ПараметрыСкладов.Склад В (&Склад)";
	
	ТаблицаЗапроса = ТестЗапрос.Выполнить().Выгрузить();
	ТаблицаЗапроса.Колонки.Добавить("Глубина");
	Для Каждого Строка Из ТаблицаЗапроса Цикл
		Если Строка.Склад = Справочники.Склады.ПустаяСсылка() Тогда
			Строка.Глубина = 0;
		Иначе
			Строка.Глубина = СтрДлина(Строка.Склад.ПолныйКод());
		КонецЕсли;
	КонецЦикла;
	
	ТаблицаЗапроса.Сортировать("Глубина Убыв, Склад Убыв");
	
	Если ТаблицаЗапроса.Количество() > 0 Тогда
		лпПараметрыСкладов = ТаблицаЗапроса[0];
		// параметры для ОтчетОРозничныхПродажах
		СтруктураВозврата.Касса          = лпПараметрыСкладов.Касса;
		СтруктураВозврата.КассаККМ          = лпПараметрыСкладов.КассаККМ;
		СтруктураВозврата.ДоговорЭквайринга = лпПараметрыСкладов.ДоговорЭквайринга;
		СтруктураВозврата.ВидОплаты         = лпПараметрыСкладов.ВидОплаты;
		СтруктураВозврата.БанковскийСчетЭквайринга         = лпПараметрыСкладов.БанковскийСчетЭквайринга;
		//измерения
		СтруктураВозврата.Склад = лпПараметрыСкладов.Склад;
	КонецЕсли;
	
	Возврат СтруктураВозврата;
	
КонецФункции // ПолучитьТО_ПараметрыСкладов()

Функция ПолучитьДопРеквизитТабличнойЧастиСумма(прЭлементСправочника, прИмяТабличнойЧасти, прНоменклатура, прИмяДопРеквизита) Экспорт
	Для Каждого ТекущаяСтрока Из прЭлементСправочника.ДопКолонкиТабличнойЧасти Цикл
		Если (СокрЛП(ТекущаяСтрока.ИмяТабличнойЧасти) = прИмяТабличнойЧасти)И(ТекущаяСтрока.Номенклатура = прНоменклатура)И(СокрЛП(ТекущаяСтрока.ИмяДопРеквизита) = прИмяДопРеквизита) Тогда
			Возврат ТекущаяСтрока.СуммаДопРеквизита;
		КонецЕсли;
	КонецЦикла;
	
	Возврат 0;
	
КонецФункции // ПолучитьДопРеквизитТабличнойЧастиСумма()

Функция ПолучитьДопРеквизитШапкиСумма(прЭлементСправочника, прИмяДопРеквизита) Экспорт
	Для Каждого ТекущаяСтрока Из прЭлементСправочника.ДопШапкаДокумента Цикл
		Если (СокрЛП(ТекущаяСтрока.ИмяДопРеквизита) = прИмяДопРеквизита) Тогда
			Возврат ТекущаяСтрока.СуммаДопРеквизита;
		КонецЕсли;
	КонецЦикла;
	
	Возврат 0;
	
КонецФункции // ПолучитьДопРеквизитШапкиСумма()

Функция ПолучитьДопРеквизитШапкиЗначение(прЭлементСправочника, прИмяДопРеквизита) Экспорт
	Для Каждого ТекущаяСтрока Из прЭлементСправочника.ДопШапкаДокумента Цикл
		Если (СокрЛП(ТекущаяСтрока.ИмяДопРеквизита) = прИмяДопРеквизита) Тогда
			Возврат ТекущаяСтрока.ЗначениеДопРеквизита;
		КонецЕсли;
	КонецЦикла;
	
	Возврат 0;
	
КонецФункции // ПолучитьДопРеквизитШапкиЗначение()


