	лпНайденнаяСсылка = лпСоответствиеДок.НайтиПоРеквизиту("Документ", лпДокСсылка);
	Если лпНайденнаяСсылка <> Справочники.ТО_СоответствияДокументов.ПустаяСсылка() Тогда
		лпДопДанныеДокументаСсылка = лпНайденнаяСсылка.ДопДанныеДокумента;
	Иначе
		лпДопДанныеДокументаСсылка = Справочники.ТО_ДополнительныеДанныеДокументов.ПустаяСсылка();
	КонецЕсли;
	
	Если лпДопДанныеДокументаСсылка.Пустая() Тогда
		Возврат;
	КонецЕсли;
	лпДопДанныеДокумента = лпДопДанныеДокументаСсылка.ПолучитьОбъект();
	
	//удалим неподходящие стандартные проводки
	Если "УдалитьПроводки" = "УдалитьПроводки" Тогда
		
		//***** ТоварыВНТТВПродажныхЦенах
		прДвижения.ТоварыВНТТВПродажныхЦенах.Очистить();
		
		
		//***** Хозрасчетный
		лпДвижения_Хозрасчетный = прДвижения.Хозрасчетный;
		лпНомерПров = лпДвижения_Хозрасчетный.Количество();
		Пока лпНомерПров > 0 Цикл
			лпПроводка = лпДвижения_Хозрасчетный.Получить(лпНомерПров - 1);
			// схема оптовый
			// удаляем (содержание - "Возврат поставщику. Неоплаченная часть.") и 281
			// схема розничный
			
			// схема оптовый
			Если (прСтруктураШапкиДокумента.Склад.ВидСклада = Перечисления.ВидыСкладов.Оптовый) Тогда
				// движение по документу
				Если (лпПроводка.СчетДт = прСтруктураШапкиДокумента.СчетУчетаРасчетовСКонтрагентом) Тогда
					лпДвижения_Хозрасчетный.Удалить(лпНомерПров - 1);
				КонецЕсли;
				Если (лпПроводка.СчетДт = прСтруктураШапкиДокумента.СчетУчетаРасходовБУ) Тогда
					лпДвижения_Хозрасчетный.Удалить(лпНомерПров - 1);
				КонецЕсли;
				//лпДвижения_Хозрасчетный.Удалить(лпНомерПров - 1);
			КонецЕсли;
			// схема розничный
			Если (прСтруктураШапкиДокумента.Склад.ВидСклада = Перечисления.ВидыСкладов.Розничный) Тогда
				// движение по документу
				Если (лпПроводка.СчетДт = ПланыСчетов.Хозрасчетный.ТорговаяНаценкаАТТ) Тогда
					лпДвижения_Хозрасчетный.Удалить(лпНомерПров - 1);
				КонецЕсли;
				Если (лпПроводка.СчетДт = прСтруктураШапкиДокумента.СчетУчетаРасчетовСКонтрагентом) Тогда
					лпДвижения_Хозрасчетный.Удалить(лпНомерПров - 1);
				КонецЕсли;
				Если (лпПроводка.СчетДт = прСтруктураШапкиДокумента.СчетУчетаРасходовБУ) Тогда
					лпДвижения_Хозрасчетный.Удалить(лпНомерПров - 1);
				КонецЕсли;
