				Проводка.СуммаНУКт = Проводка.Сумма;
			КонецЕсли;
			
			Если (прСтруктураШапкиДокумента.Склад.ВидСклада = Перечисления.ВидыСкладов.Розничный) Тогда 
				Если (лпСуммаРеальнойНаценки > 0) Тогда
					//глПроводка(Контекст,"28.5",ТО_ДатьСчетСклада(МестоХранения),(СуммаВозв + Сумма) - СуммаЗакБезНДС,"Розн.продажа: списана сумма торговой наценки" + "   (стр. №" + НомерСтроки + ")",, 
					//	МестоХранения,ТМЦ,Партия,
					//	МестоХранения,ТМЦ,Партия, ,,"РЗ");
					
					// 285 - 282 торговая наценка
					Проводка = прДвижения.Хозрасчетный.Добавить();
					Проводка.Период      = прСтруктураШапкиДокумента.Дата;
					Проводка.Организация = прСтруктураШапкиДокумента.Организация;
					Проводка.Содержание  = НСтр("ru='Розн.продажа: списана сумма торговой наценки';uk='Розд.продаж: списана торгова націнка'",Локализация.КодЯзыкаИнформационнойБазы());
					
					Проводка.СчетДт      = ПланыСчетов.Хозрасчетный.ТорговаяНаценкаАТТ;
					Проводка.СчетКт      = Строка.СчетУчетаБУ;
					
					УстановитьСубконто(Проводка.СчетДт, Проводка.СубконтоДт, "Склады",  прСтруктураШапкиДокумента.Склад);
					УстановитьСубконто(Проводка.СчетКт, Проводка.СубконтоКт, "Склады",  прСтруктураШапкиДокумента.Склад);
					УстановитьСубконто(Проводка.СчетДт, Проводка.СубконтоДт, "Номенклатура",  Строка.Номенклатура);
					УстановитьСубконто(Проводка.СчетКт, Проводка.СубконтоКт, "Номенклатура",  Строка.Номенклатура);
					//УстановитьСубконто(Проводка.СчетДт, Проводка.СубконтоДт, "Партии",  Партия.Партия);
					//УстановитьСубконто(Проводка.СчетКт, Проводка.СубконтоКт, "Партии",  Партия.Партия);
					//Проводка.Сумма  = лпСуммаРознРеализацииСНДС;
					Проводка.Сумма  = лпСуммаРеальнойНаценки;
					
