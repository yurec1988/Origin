//взято из УТП
// Возвращает сокращенный уникальный идентификатор текущей конфигурации.
Функция ИДКонфигурации() Экспорт
	// Условие ИЛИ было добавлено для совместимости с данной конфигурацией
	Если Метаданные.Имя = "БухгалтерияДляУкраины" ИЛИ Метаданные.Имя = "БухгалтерияДляУкраиныБазовая" ИЛИ Метаданные.Имя = "РегламентированнаяОтчетность"  Тогда
		Возврат "БП";
	ИначеЕсли Метаданные.Имя = "ЗарплатаИУправлениеПерсоналомДляУкраины" Тогда
		Возврат "ЗУП";
	ИначеЕсли Метаданные.Имя = "УправлениеПроизводственнымПредприятиемДляУкраины" Тогда
		Возврат "УПП";
	ИначеЕсли (Метаданные.Имя = "BASУправлениеТорговымПредприятием") ИЛИ (Метаданные.Имя = "УправлениеТорговымПредприятиемДляУкраины") Тогда
		Возврат "УТП";	
	Иначе
		Возврат Метаданные.Имя;
	КонецЕсли;
КонецФункции // ИДКонфигурации()

//взято из УТП
// Возвращает номер редакции текущей конфигурации.
//  Номер редакции выделяется из полного номера версии конфигурации 
// и представляет собой все символы до второй точки.
//
Функция РедакцияКонфигурации() Экспорт
	
	Перем Версия;
	Перем ПерваяТочка;
	
	Версия = Метаданные.Версия;
	ПерваяТочка = Найти(Версия, ".");
	
	Возврат СокрЛП(Лев(Версия, Найти(Сред(Версия, ПерваяТочка + 1), ".") + ПерваяТочка - 1));
	
КонецФункции // РедакцияКонфигурации()

