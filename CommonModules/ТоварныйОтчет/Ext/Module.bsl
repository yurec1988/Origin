// Функция возвращает субконто по входной операции и складу.
//
// Параметры:
//  прСклад         - место хранения, по которому определяются счета учета
//
// Возвращаемое значение:
//  Структура - структура содержащая параметры учета
// 
Функция ПолучитьТО_ПараметрыКассовыхОпераций(прСклад = Неопределено, прКодУчета = Неопределено, прВидДок = Неопределено) Экспорт
	
	СтруктураВозврата = Новый Структура("
	|Счет,
	|КодУчета,
	|ВидДок,
	|Субконто1,
	|Субконто2,
	|Субконто3,
	|СтатьяДвиженияДенежныхСредств,
	|Склад");
	
	
	МассивСкладов = Новый Массив();
	МассивСкладов.Добавить(Справочники.Склады.ПустаяСсылка());
	
	Если ЗначениеЗаполнено(прСклад) Тогда
		МассивСкладов.Добавить(прСклад);
		//СписокГрупп = ПолучитьСписокВышестоящихГрупп(прСклад);
		Если ЗначениеЗаполнено(прСклад.Родитель) Тогда
			МассивСкладов.Добавить(прСклад.Родитель);
		КонецЕсли;
		//Если ЗначениеЗаполнено(прСклад.Родитель.Родитель) Тогда
		//	МассивСкладов.Добавить(прСклад.Родитель.Родитель);
		//КонецЕсли;
	КонецЕсли;
	
	МассивВидовДок = Новый Массив();
	МассивВидовДок.Добавить("");
	Если ЗначениеЗаполнено(прВидДок) Тогда
		МассивВидовДок.Добавить(прВидДок);
	КонецЕсли;
	
	ТестЗапрос = Новый Запрос();
	ТестЗапрос.УстановитьПараметр("Склад",МассивСкладов);
	ТестЗапрос.УстановитьПараметр("ВидДок",МассивВидовДок);
	ТестЗапрос.УстановитьПараметр("КодУчета",прКодУчета);
	
	ТестЗапрос.Текст = "
	|ВЫБРАТЬ
	|	ТО_КассовыеОперации.Склад КАК Склад,
	|	ТО_КассовыеОперации.Склад.ЭтоГруппа КАК ЭтоГруппа,
	|	ТО_КассовыеОперации.КодУчета КАК КодУчета,
	|	ТО_КассовыеОперации.ВидДок КАК ВидДок,
	|	ТО_КассовыеОперации.Счет КАК Счет,
	|	ТО_КассовыеОперации.Субконто1 КАК Субконто1,
	|	ТО_КассовыеОперации.Субконто2 КАК Субконто2,
	|	ТО_КассовыеОперации.Субконто3 КАК Субконто3,
	|	ТО_КассовыеОперации.СтатьяДвиженияДенежныхСредств КАК СтатьяДвиженияДенежныхСредств
	|ИЗ
	|	РегистрСведений.ТО_КассовыеОперации КАК ТО_КассовыеОперации
	|ГДЕ
	|	ТО_КассовыеОперации.Склад В (&Склад)
	|	И ТО_КассовыеОперации.ВидДок В (&ВидДок)
	|	И ТО_КассовыеОперации.КодУчета В (&КодУчета)";
	
	ТаблицаЗапроса = ТестЗапрос.Выполнить().Выгрузить();
	ТаблицаЗапроса.Колонки.Добавить("Глубина");
	Для Каждого Строка Из ТаблицаЗапроса Цикл
		Если Строка.Склад = Справочники.Склады.ПустаяСсылка() Тогда
			Строка.Глубина = 0;
		Иначе
			Строка.Глубина = СтрДлина(Строка.Склад.ПолныйКод());
		КонецЕсли;
	КонецЦикла;
	
	ТаблицаЗапроса.Сортировать("Глубина Убыв, Склад Убыв");
	
	Если ТаблицаЗапроса.Количество() > 0 Тогда
		лпВыборка = ТаблицаЗапроса[0];
		// параметры для 
		СтруктураВозврата.Счет           = лпВыборка.Счет;
		СтруктураВозврата.Субконто1 = лпВыборка.Субконто1;
		СтруктураВозврата.Субконто2 = лпВыборка.Субконто2;
		СтруктураВозврата.Субконто3 = лпВыборка.Субконто3;
		СтруктураВозврата.СтатьяДвиженияДенежныхСредств = лпВыборка.СтатьяДвиженияДенежныхСредств;
		//измерения
		СтруктураВозврата.Склад = лпВыборка.Склад;
		СтруктураВозврата.КодУчета   = лпВыборка.КодУчета;
		СтруктураВозврата.ВидДок   = лпВыборка.ВидДок;
	КонецЕсли;
	
	Возврат СтруктураВозврата;
	
КонецФункции // 

