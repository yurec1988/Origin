					Проводка.НалоговоеНазначениеКт = Строка.НалоговоеНазначение;
					Проводка.СуммаНУКт = Проводка.Сумма;
					
					// 285 - 282 скидка
					Если лпСуммаРознРеализацииСкидка > 0 Тогда 
						//глПроводка(Контекст,"28.5",ТО_ДатьСчетСклада(МестоХранения), СуммаДельта,"Розн.продажа: списана сумма скидки" + "   (стр. №" + НомерСтроки + ")",, 
						//МестоХранения,ТМЦ,Партия,
						//МестоХранения,ТМЦ,Партия, ,,"РЗ");
						
						Проводка = прДвижения.Хозрасчетный.Добавить();
