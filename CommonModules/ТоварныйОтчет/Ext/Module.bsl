	КонецЕсли;
	
	// ****
	НаправлениеДвижения = УправлениеВзаиморасчетами.ОпределениеНаправленияДвиженияДляДокументаПриобретенияРеализации(лпДокСсылка.Метаданные().Имя,, прСтруктураШапкиДокумента).Направление;
