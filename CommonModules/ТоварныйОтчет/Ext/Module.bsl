				Если лпДокОбъект.Дата < Дата(2015,01,01,0,0,0) Тогда
					Проводка.НалоговоеНазначениеДт = Строка.НалоговоеНазначениеДоходовИЗатрат; 
					Проводка.СуммаНУДт = Проводка.Сумма; 
				КонецЕсли;

			КонецЕсли;
			
			
			// ***** регистр ОжидаемыйИПодтвержденныйНДСПродаж
			НовоеДвижение = прДвижения.ОжидаемыйИПодтвержденныйНДСПродаж.Добавить();   			
			НовоеДвижение.Активность  = Истина;
			НовоеДвижение.ВидДвижения = ВидДвиженияНакопления.Приход;  
			НовоеДвижение.Период 	   = лпДокСсылка.Дата;  
			НовоеДвижение.Регистратор = лпДокСсылка;  			
			НовоеДвижение.Организация 	   = прСтруктураШапкиДокумента.Организация;  			
			НовоеДвижение.ДоговорКонтрагента = "";
			НовоеДвижение.Сделка = "";
			НовоеДвижение.ВозвратнаяТара = "";   				
			НовоеДвижение.СобытиеНДС = Перечисления.СобытияОжидаемыйИПодтвержденныйНДСПродаж.РеализацияРозница;
			НовоеДвижение.СтавкаНДС = Строка.СтавкаНДС;
			НовоеДвижение.БазаНДС = лпСуммаРознРеализацииБезНДС;
			НовоеДвижение.СуммаНДС = лпСуммаРознРеализацииНДС;
			НовоеДвижение.КодОперации = Перечисления.КодыОперацийОжидаемыйИПодтвержденныйНДСПродаж.ОжидаемыйНДС;
			
			
			
			// ***** регистр ТоварыВНТТВПродажныхЦенах
			НовоеДвижение = прДвижения.ТоварыВНТТВПродажныхЦенах.Добавить();   			
			НовоеДвижение.Активность  = Истина;
			НовоеДвижение.ВидДвижения = ВидДвиженияНакопления.Расход;  
			НовоеДвижение.Период 	   = лпДокСсылка.Дата;  
			НовоеДвижение.Регистратор = лпДокСсылка;  			
			НовоеДвижение.Склад 	   = прСтруктураШапкиДокумента.Склад;  			
			НовоеДвижение.СтавкаНДС= Строка.СтавкаНДС;
			НовоеДвижение.Сумма 		 = АБС(лпСуммаРознУчетСНДС);
			Если ОбщегоНазначения.ПолучитьСхемуНалогообложения(лпДокСсылка.Дата,лпДокСсылка.Организация).НДС = Ложь Тогда
				лпСуммаНаценки = АБС(лпСуммаРознУчетСНДС - лпСебестоимость); 
			Иначе
				лпСуммаНаценки = АБС(лпСуммаРознУчетСНДС - лпСебестоимость - лпСуммаЗакНДС);
			КонецЕсли;
			НовоеДвижение.СуммаНаценки  = лпСуммаНаценки;  			
			НовоеДвижение.Номенклатура  = Строка.Номенклатура;
			НовоеДвижение.ХарактеристикаНоменклатуры  = Строка.ХарактеристикаНоменклатуры; 			
			НовоеДвижение.КодОперации   = Перечисления.КодыОперацийТоварыВНТТВПродажныхЦенах.Реализация;    	
			
		КонецЦикла; // Для каждого Строка Из прТаблицаПоТоварам Цикл
		
		//прТекущиеДвижения.мДействияПередЗаписьюВыполнены = Истина;
		//прТекущиеДвижения.Записать(Истина);
	КонецЕсли;
	
	лпДокОбъект = 0;
КонецПроцедуры


Процедура ДвиженияПоРегистрам_БП_РеализацияТоваровУслуг(прДвижения,прРежимПроведения, прСтруктураШапкиДокумента) Экспорт
	
КонецПроцедуры

Процедура ДвиженияПоРегистрам_УТП_РеализацияТоваровУслуг(прДвижения,прРежимПроведения, прСтруктураШапкиДокумента) Экспорт
	
	лпДокСсылка = прСтруктураШапкиДокумента.Ссылка;
	лпДокОбъект = лпДокСсылка.ПолучитьОбъект();
	
	//определим наш ли это документ
	лпДокСсылка = прСтруктураШапкиДокумента.Ссылка;
	лпСоответствиеДок = Справочники.ТО_СоответствияДокументов;
	лпНайденнаяСсылка = лпСоответствиеДок.НайтиПоРеквизиту("Документ", лпДокСсылка);
	Если лпНайденнаяСсылка <> Справочники.ТО_СоответствияДокументов.ПустаяСсылка() Тогда
		лпДопДанныеДокументаСсылка = лпНайденнаяСсылка.ДопДанныеДокумента;
	Иначе
		лпДопДанныеДокументаСсылка = Справочники.ТО_ДополнительныеДанныеДокументов.ПустаяСсылка();
	КонецЕсли;
	
	Если лпДопДанныеДокументаСсылка.Пустая() Тогда
		Возврат;
	КонецЕсли;
	лпДопДанныеДокумента = лпДопДанныеДокументаСсылка.ПолучитьОбъект();
	
	прДвижения.ПартииТоваровНаСкладах.Очистить();
	прДвижения.ТоварыОрганизаций.Очистить();
	
	
	//удалим неподходящие стандартные проводки
	Если "УдалитьПроводки" = "УдалитьПроводки" Тогда
		
		прДвижения.ТоварыОрганизаций.Очистить();
		
		//***** Хозрасчетный
		лпДвижения_Хозрасчетный = прДвижения.Хозрасчетный;
		лпНомерПров = лпДвижения_Хозрасчетный.Количество();
		Пока лпНомерПров > 0 Цикл
			
			лпПроводка = лпДвижения_Хозрасчетный.Получить(лпНомерПров - 1);
			// схема оптовый
			// удаляем 
			// схема розничный
			// удаляем 
			
			// проводка по строке
			Если (Лев(лпПроводка.СчетДт.Код, 2) = "90") Тогда
				лпДвижения_Хозрасчетный.Удалить(лпНомерПров - 1);
			КонецЕсли;
			// схема розничный
			Если (прСтруктураШапкиДокумента.Склад.ВидСклада = Перечисления.ВидыСкладов.Розничный) Тогда
				// движение по документу
				Если (лпПроводка.СчетКт = ПланыСчетов.Хозрасчетный.ТорговаяНаценкаАТТ) Тогда
					лпДвижения_Хозрасчетный.Удалить(лпНомерПров - 1);
				КонецЕсли;
			КонецЕсли;
			// схема НТТ
			Если (прСтруктураШапкиДокумента.Склад.ВидСклада = Перечисления.ВидыСкладов.НТТ) Тогда
				// движение по документу
				Если (лпПроводка.СчетКт = ПланыСчетов.Хозрасчетный.ТорговаяНаценкаНТТ) Тогда
					лпДвижения_Хозрасчетный.Удалить(лпНомерПров - 1);
				КонецЕсли;
			КонецЕсли;   			
			лпНомерПров = лпНомерПров - 1;
		КонецЦикла;
		
		
	КонецЕсли;
	
	лпДвижения_Продажи = прДвижения.Продажи;
	лпНомерПров = лпДвижения_Продажи.Количество();
	Пока лпНомерПров > 0 Цикл
		лпПроводка = лпДвижения_Продажи.Получить(лпНомерПров - 1);
		лпПроводка.Количество = "";
		лпНомерПров = лпНомерПров - 1; 
	КонецЦикла; 
	
	
	
	
	// проводки по строке
	Если "СформироватьПроводкиСтрока" = "СформироватьПроводкиСтрока" Тогда
		
		Для каждого Строка Из лпДокСсылка.Товары Цикл
			//лпСебестоимость     = ПолучитьДопРеквизитТабличнойЧастиСумма(лпДопДанныеДокумента, "Товары", Строка.Номенклатура, "Себестоимость");
			лпСуммаЗакБезНДС     = ПолучитьДопРеквизитТабличнойЧастиСумма(лпДопДанныеДокумента, "Товары", Строка.Номенклатура, "СуммаЗакБезНДС");
			
			лпСуммаЗакБезНДС = ПолучитьДопРеквизитТабличнойЧастиСумма(лпДопДанныеДокумента, "Товары", Строка.Номенклатура, "СуммаЗакБезНДС");
			лпСуммаЗакНДС = ПолучитьДопРеквизитТабличнойЧастиСумма(лпДопДанныеДокумента, "Товары", Строка.Номенклатура, "СуммаЗакНДС");
			лпСуммаЗакСНДС = ПолучитьДопРеквизитТабличнойЧастиСумма(лпДопДанныеДокумента, "Товары", Строка.Номенклатура, "СуммаЗакСНДС");
			//// !!!
			Если ОбщегоНазначения.ПолучитьСхемуНалогообложения(лпДокСсылка.Дата,лпДокСсылка.Организация).НДС = Ложь Тогда
				лпСебестоимость = лпСуммаЗакСНДС;
			Иначе
				лпСебестоимость = лпСуммаЗакБезНДС;
			КонецЕсли;
			
			лпСуммаРознРеализацииБезНДС = ПолучитьДопРеквизитТабличнойЧастиСумма(лпДопДанныеДокумента, "Товары", Строка.Номенклатура, "СуммаРознРеализацииБезНДС");
			лпСуммаРознРеализацииНДС = ПолучитьДопРеквизитТабличнойЧастиСумма(лпДопДанныеДокумента, "Товары", Строка.Номенклатура, "СуммаРознРеализацииНДС");
			лпСуммаРознРеализацииСНДС = ПолучитьДопРеквизитТабличнойЧастиСумма(лпДопДанныеДокумента, "Товары", Строка.Номенклатура, "СуммаРознРеализацииСНДС");
			
			лпСуммаВозвратаБезНДС = ПолучитьДопРеквизитТабличнойЧастиСумма(лпДопДанныеДокумента, "Товары", Строка.Номенклатура, "СуммаВозвратаБезНДС");
			лпСуммаВозвратаНДС = ПолучитьДопРеквизитТабличнойЧастиСумма(лпДопДанныеДокумента, "Товары", Строка.Номенклатура, "СуммаВозвратаНДС");
			лпСуммаВозвратаСНДС = ПолучитьДопРеквизитТабличнойЧастиСумма(лпДопДанныеДокумента, "Товары", Строка.Номенклатура, "СуммаВозвратаСНДС");
			
			//лпСуммаРознРеализацииСкидка = ПолучитьДопРеквизитТабличнойЧастиСумма(лпДопДанныеДокумента, "Товары", Строка.Номенклатура, "СуммаРознРеализацииСкидка");
			
			лпСуммаРознУчетБезНДС = ПолучитьДопРеквизитТабличнойЧастиСумма(лпДопДанныеДокумента, "Товары", Строка.Номенклатура, "СуммаРознУчетБезНДС");
			лпСуммаРознУчетНДС = ПолучитьДопРеквизитТабличнойЧастиСумма(лпДопДанныеДокумента, "Товары", Строка.Номенклатура, "СуммаРознУчетНДС");
			лпСуммаРознУчетСНДС = ПолучитьДопРеквизитТабличнойЧастиСумма(лпДопДанныеДокумента, "Товары", Строка.Номенклатура, "СуммаРознУчетСНДС");
			
			лпСуммаРознРеализацииСкидка = лпСуммаРознУчетСНДС - (лпСуммаРознРеализацииСНДС + лпСуммаВозвратаСНДС);
			лпСуммаРеальнойНаценки = (лпСуммаРознРеализацииСНДС + лпСуммаВозвратаСНДС) - лпСебестоимость;
			лпСуммаСписываемойНаценки = лпСуммаРознУчетСНДС - лпСебестоимость;
			
			//***** Хозрасчетный - проводки
			//Списание себестоимости продаваемого товара
			// 902 - 282
			Проводка = прДвижения.Хозрасчетный.Добавить();
