			//Проводка.СчетКт = ПланыСчетов.Налоговый.Запасы;
			//ЗаполнитьСубконто(Проводка, прСтруктураШапкиДокумента, Строка,,,,,Строка.СтатьяПриростаУбылиЗапасов);
			//Проводка.Сумма = лпСебестоимость;
			//Если Проводка.СчетДт.Количественный Тогда
			//	Проводка.КоличествоДт = Строка.Количество;
			//КонецЕсли;
			//Если Проводка.СчетКт.Количественный Тогда
			//	Проводка.КоличествоКт = Строка.Количество;
			//КонецЕсли;
			
			//***** Хозрасчетный - проводки
			//Списание себестоимости товара
			// 902(808) - 282
			Проводка = прДвижения.Хозрасчетный.Добавить();
			Проводка.Период      = прСтруктураШапкиДокумента.Дата;
			Проводка.Организация = прСтруктураШапкиДокумента.Организация;
			Проводка.Содержание  = НСтр("ru='Списание товаров: себестоимость';uk='Списання товарів: собівартість'",Локализация.КодЯзыкаИнформационнойБазы());
			Проводка.СчетДт      = прСтруктураШапкиДокумента.СчетДт;
			Проводка.СчетКт      = Строка.СчетУчетаБУ;
			
			УстановитьСубконто(Проводка.СчетДт, Проводка.СубконтоДт, 1, лпДокСсылка.СубконтоДт1);
			УстановитьСубконто(Проводка.СчетДт, Проводка.СубконтоДт, 2, лпДокСсылка.СубконтоДт2);
			УстановитьСубконто(Проводка.СчетДт, Проводка.СубконтоДт, 3, лпДокСсылка.СубконтоДт3);
			
			УстановитьСубконто(Проводка.СчетДт, Проводка.СубконтоДт, "НоменклатурныеГруппы",  Строка.Номенклатура.НоменклатурнаяГруппа);
			
			УстановитьСубконто(Проводка.СчетКт, Проводка.СубконтоКт, "Склады",  прСтруктураШапкиДокумента.Склад);
			УстановитьСубконто(Проводка.СчетКт, Проводка.СубконтоКт, "Номенклатура",  Строка.Номенклатура);
			УстановитьСубконто(Проводка.СчетКт, Проводка.СубконтоКт, "СтавкиНДС",  Строка.Номенклатура.СтавкаНДС);
			
			//УстановитьСубконто(Проводка.СчетКт, Проводка.СубконтоКт, "Партии",  Партия.Партия);
			//!!!
			Проводка.Сумма  = лпСебестоимость;
			
			Проводка.НалоговоеНазначениеКт = Строка.НалоговоеНазначение;
