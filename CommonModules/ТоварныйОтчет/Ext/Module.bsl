Процедура ДвиженияПоРегистрам_УТП_ПеремещениеТоваров_ММО(прДвижения,прРежимПроведения, прСтруктураШапкиДокумента) Экспорт
	лпДокСсылка = прСтруктураШапкиДокумента.Ссылка;
	лпДокОбъект = лпДокСсылка.ПолучитьОбъект();
	
	//***** ТоварыВНТТВПродажныхЦенах
	прДвижения.ТоварыВНТТВПродажныхЦенах.Очистить(); 
	
	//***** ПартииТоваровНаСкладах   
	прДвижения.ПартииТоваровНаСкладах.Очистить();
	
	//***** Хозрасчетный
	//Регистр бухгалтерии "Журнал проводок (бухгалтерский учет)"
	лпДвижения_Хозрасчетный = прДвижения.Хозрасчетный;
	лпНомерПров = лпДвижения_Хозрасчетный.Количество();
	Пока лпНомерПров > 0 Цикл
		лпПроводка = лпДвижения_Хозрасчетный.Получить(лпНомерПров - 1);
		лпДвижения_Хозрасчетный.Удалить(лпНомерПров - 1);
		лпНомерПров = лпНомерПров - 1;
	КонецЦикла;
	
	// сформируем проводки
	Для каждого Строка Из лпДокСсылка.Товары Цикл
		лпСебестоимость     = Строка.СебестоимостьАНР;
		
		Если лпСебестоимость = 0 Тогда
			Сообщить("В строке "+Строка.НомерСтроки+" себестоимость равна нулю!!!",СтатусСообщения.ОченьВажное);
		КонецЕсли;
				
		лпСуммаРозн = Строка.СуммаВРознице;
		лпСуммаНаценкиОтправителя = лпСуммаРозн - лпСебестоимость;
		
		//***** Хозрасчетный - проводки
		Проводка = прДвижения.Хозрасчетный.Добавить();
		Проводка.Период      = прСтруктураШапкиДокумента.Дата;
		Проводка.Организация = прСтруктураШапкиДокумента.Организация;
		Проводка.Содержание  = НСтр("ru='Перемещение: себестоимость';uk='Переміщення: собівартість'",Локализация.КодЯзыкаИнформационнойБазы());
		Проводка.СчетДт      = Строка.НовыйСчетУчетаБУ; // 281
		Проводка.СчетКт      = Строка.СчетУчетаБУ; // 2822
		
		
		ОбщегоНазначения.УстановитьСубконто(Проводка.СчетДт, Проводка.СубконтоДт, "Склады",  прСтруктураШапкиДокумента.СкладПолучатель);   
		ОбщегоНазначения.УстановитьСубконто(Проводка.СчетКт, Проводка.СубконтоКт, "Склады",  прСтруктураШапкиДокумента.СкладОтправитель);
		ОбщегоНазначения.УстановитьСубконто(Проводка.СчетДт, Проводка.СубконтоДт, "Номенклатура",  Строка.Номенклатура);
		ОбщегоНазначения.УстановитьСубконто(Проводка.СчетКт, Проводка.СубконтоКт, "Номенклатура",  Строка.Номенклатура);
		ОбщегоНазначения.УстановитьСубконто(Проводка.СчетКт, Проводка.СубконтоКт, "СтавкиНДС",  Строка.СтавкаНДСВРознице);
		ОбщегоНазначения.УстановитьСубконто(Проводка.СчетДт, Проводка.СубконтоДт, "НоменклатурныеПозиции",  Строка.НоменклатурнаяПозиция);
		
		ОбщегоНазначения.УстановитьСубконто(Проводка.СчетДт, Проводка.СубконтоДт, "Партии",  лпДокСсылка);
		//ОбщегоНазначения.УстановитьСубконто(Проводка.СчетКт, Проводка.СубконтоКт, "Партии",  Партия.Партия);
		Проводка.Сумма  = лпСебестоимость;
		
		Проводка.НалоговоеНазначениеДт = Строка.НалоговоеНазначение; 
		Проводка.НалоговоеНазначениеКт = Строка.НалоговоеНазначение;
		Если лпДокОбъект.Дата < Дата(2015,01,01,0,0,0) Тогда
			Проводка.СуммаНУДт = Проводка.Сумма; 				
			Проводка.СуммаНУКт = Проводка.Сумма;
		КонецЕсли;
		
		Если Проводка.СчетДт.Количественный Тогда
			Проводка.КоличествоДт = Строка.Количество;
		КонецЕсли;
		Если Проводка.СчетКт.Количественный Тогда
			Проводка.КоличествоКт = Строка.Количество;
		КонецЕсли;
		
		Если лпСуммаНаценкиОтправителя <> 0 Тогда
			Проводка = прДвижения.Хозрасчетный.Добавить();
			Проводка.Период      = прСтруктураШапкиДокумента.Дата;
			Проводка.Организация = прСтруктураШапкиДокумента.Организация;
			Проводка.Содержание  = НСтр("ru='Перемещение: сумма торговой наценки';uk='Переміщення: торгова націнка'",Локализация.КодЯзыкаИнформационнойБазы());
			
			Проводка.СчетДт      = ПланыСчетов.Хозрасчетный.ТорговаяНаценкаНТТ; // 2852 
			Проводка.СчетКт      = Строка.СчетУчетаБУ; // 2822
			
			ОбщегоНазначения.УстановитьСубконто(Проводка.СчетДт, Проводка.СубконтоДт, "Склады",  прСтруктураШапкиДокумента.СкладОтправитель);
			ОбщегоНазначения.УстановитьСубконто(Проводка.СчетКт, Проводка.СубконтоКт, "Склады",  прСтруктураШапкиДокумента.СкладОтправитель);
			ОбщегоНазначения.УстановитьСубконто(Проводка.СчетДт, Проводка.СубконтоДт, "Номенклатура",  Строка.Номенклатура);
			ОбщегоНазначения.УстановитьСубконто(Проводка.СчетКт, Проводка.СубконтоКт, "Номенклатура",  Строка.Номенклатура);
			ОбщегоНазначения.УстановитьСубконто(Проводка.СчетДт, Проводка.СубконтоДт, "СтавкиНДС",  Строка.СтавкаНДСВРознице);
			ОбщегоНазначения.УстановитьСубконто(Проводка.СчетКт, Проводка.СубконтоКт, "СтавкиНДС",  Строка.СтавкаНДСВРознице);    
			Проводка.Сумма  = лпСуммаНаценкиОтправителя;
			
			Проводка.НалоговоеНазначениеДт = Строка.НалоговоеНазначение; 
			Проводка.НалоговоеНазначениеКт = Строка.НалоговоеНазначение;
			Если лпДокОбъект.Дата < Дата(2015,01,01,0,0,0) Тогда
				Проводка.СуммаНУДт = Проводка.Сумма;					
				Проводка.СуммаНУКт = Проводка.Сумма;
			КонецЕсли;
			
		КонецЕсли; 	
		
		// ***** регистр ТоварыВНТТВПродажныхЦенах
		Если ОбщегоНазначения.ПолучитьСхемуНалогообложения(лпДокСсылка.Дата,лпДокСсылка.Организация).НДС = Ложь Тогда
			лпСуммаНаценкиОтправителя_упр = лпСуммаРозн - лпСебестоимость; 
		Иначе
			УчитыватьНДС = Истина;
			СуммаВключаетНДС = Ложь;
			лпСуммаЗакНДС = УчетНДС.РассчитатьСуммуНДС(лпСебестоимость,
			УчитыватьНДС, СуммаВключаетНДС,
			УчетНДС.ПолучитьСтавкуНДС(Строка.СтавкаНДСВРознице));   					
			лпСуммаНаценкиОтправителя_упр = лпСуммаРозн - лпСебестоимость - лпСуммаЗакНДС; 
		КонецЕсли;
		
		Если лпСуммаРозн <> 0 Тогда
			НовоеДвижение = прДвижения.ТоварыВНТТВПродажныхЦенах.Добавить();   			
			НовоеДвижение.Активность  = Истина;
			НовоеДвижение.ВидДвижения = ВидДвиженияНакопления.Расход;  
			НовоеДвижение.Период 	   = лпДокСсылка.Дата;  
			НовоеДвижение.Регистратор = лпДокСсылка;  			
			НовоеДвижение.Склад 	   = прСтруктураШапкиДокумента.СкладОтправитель;  			
			НовоеДвижение.СтавкаНДС = Строка.СтавкаНДСВРознице;
			НовоеДвижение.Сумма 		 = АБС(лпСуммаРозн);
			НовоеДвижение.СуммаНаценки  = АБС(лпСуммаНаценкиОтправителя_упр);  			
			НовоеДвижение.Номенклатура  = Строка.Номенклатура;
			НовоеДвижение.ХарактеристикаНоменклатуры  = Строка.ХарактеристикаНоменклатуры; 			
			НовоеДвижение.КодОперации   = Перечисления.КодыОперацийТоварыВНТТВПродажныхЦенах.Возврат; 
		КонецЕсли;	
		
		// ***** регистр ПартииТоваровНаСкладах
		НовоеДвижениеПартии = прДвижения.ПартииТоваровНаСкладах.Добавить();  
		НовоеДвижениеПартии.Активность  = Истина;
		НовоеДвижениеПартии.ВидДвижения = ВидДвиженияНакопления.Приход;  
		НовоеДвижениеПартии.Период 	   = лпДокСсылка.Дата;  
		НовоеДвижениеПартии.Регистратор = лпДокСсылка;  
		НовоеДвижениеПартии.Номенклатура  = Строка.Номенклатура;
		НовоеДвижениеПартии.Склад 	   = прСтруктураШапкиДокумента.СкладПолучатель;  
		НовоеДвижениеПартии.ХарактеристикаНоменклатуры  = Строка.ХарактеристикаНоменклатуры; 
		НовоеДвижениеПартии.СерияНоменклатуры =  Строка.СерияНоменклатуры;
		НовоеДвижениеПартии.ДокументОприходования = лпДокСсылка;
		НовоеДвижениеПартии.СтатусПартии = Перечисления.СтатусыПартийТоваров.Купленный;
		НовоеДвижениеПартии.Качество = Строка.Качество;
		
		НовоеДвижениеПартии.Количество = Строка.Количество;
		НовоеДвижениеПартии.Стоимость = лпСебестоимость;
		НовоеДвижениеПартии.КодОперации = Перечисления.КодыОперацийПартииТоваров.Оприходование;
		НовоеДвижениеПартии.СписаниеПартий = Ложь;
	КонецЦикла;
	
	
КонецПроцедуры

	
Процедура ДвиженияПоРегистрам_УТП_ПеремещениеТоваров(прДвижения,прРежимПроведения, прСтруктураШапкиДокумента) Экспорт
	
	лпДокСсылка = прСтруктураШапкиДокумента.Ссылка;
	лпДокОбъект = лпДокСсылка.ПолучитьОбъект();
	
	//определим наш ли это документ
	лпДокСсылка = прСтруктураШапкиДокумента.Ссылка;
	лпСоответствиеДок = Справочники.ТО_СоответствияДокументов;
	лпНайденнаяСсылка = лпСоответствиеДок.НайтиПоРеквизиту("Документ", лпДокСсылка);
	Если лпНайденнаяСсылка <> Справочники.ТО_СоответствияДокументов.ПустаяСсылка() Тогда
		лпДопДанныеДокументаСсылка = лпНайденнаяСсылка.ДопДанныеДокумента;
	Иначе
		лпДопДанныеДокументаСсылка = Справочники.ТО_ДополнительныеДанныеДокументов.ПустаяСсылка();
	КонецЕсли;
	
	Если лпДопДанныеДокументаСсылка.Пустая() Тогда
		Если ПустаяСтрока(лпДокСсылка.НомерВход_АНР) Тогда
			Возврат;
		Иначе
			// документ загружен из файла .mmo
			ДвиженияПоРегистрам_УТП_ПеремещениеТоваров_ММО(прДвижения,прРежимПроведения, прСтруктураШапкиДокумента);
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	лпДопДанныеДокумента = лпДопДанныеДокументаСсылка.ПолучитьОбъект();
	
	//удалим неподходящие стандартные проводки
	Если "УдалитьПроводки" = "УдалитьПроводки" Тогда
		
		//***** ТоварыВНТТВПродажныхЦенах
		прДвижения.ТоварыВНТТВПродажныхЦенах.Очистить();   
		
		
		//***** Хозрасчетный
		//Регистр бухгалтерии "Журнал проводок (бухгалтерский учет)"
		лпДвижения_Хозрасчетный = прДвижения.Хозрасчетный;
		лпНомерПров = лпДвижения_Хозрасчетный.Количество();
		Пока лпНомерПров > 0 Цикл
			лпПроводка = лпДвижения_Хозрасчетный.Получить(лпНомерПров - 1);
			// схема оптовый-розничный
			Если (прСтруктураШапкиДокумента.СкладОтправитель.ВидСклада = Перечисления.ВидыСкладов.Оптовый)И(прСтруктураШапкиДокумента.СкладПолучатель.ВидСклада = Перечисления.ВидыСкладов.Розничный) Тогда
				Если (Лев(лпПроводка.СчетДт.Код, 2) = "28")ИЛИ(Лев(лпПроводка.СчетКт.Код, 2) = "28") Тогда
					лпДвижения_Хозрасчетный.Удалить(лпНомерПров - 1);
				КонецЕсли; 
			КонецЕсли;
			// схема розничный-оптовый
			Если (прСтруктураШапкиДокумента.СкладОтправитель.ВидСклада = Перечисления.ВидыСкладов.Розничный)И(прСтруктураШапкиДокумента.СкладПолучатель.ВидСклада = Перечисления.ВидыСкладов.Оптовый) Тогда
				Если (Лев(лпПроводка.СчетДт.Код, 2) = "28")ИЛИ(Лев(лпПроводка.СчетКт.Код, 2) = "28") Тогда
					лпДвижения_Хозрасчетный.Удалить(лпНомерПров - 1);
				КонецЕсли; 
			КонецЕсли;
			
			// схема оптовый-НТТ
			Если (прСтруктураШапкиДокумента.СкладОтправитель.ВидСклада = Перечисления.ВидыСкладов.Оптовый)И(прСтруктураШапкиДокумента.СкладПолучатель.ВидСклада = Перечисления.ВидыСкладов.НТТ) Тогда
				Если (Лев(лпПроводка.СчетДт.Код, 2) = "28")ИЛИ(Лев(лпПроводка.СчетКт.Код, 2) = "28") Тогда
					лпДвижения_Хозрасчетный.Удалить(лпНомерПров - 1);
				КонецЕсли; 
			КонецЕсли;
			
			// схема НТТ-оптовый
			Если (прСтруктураШапкиДокумента.СкладОтправитель.ВидСклада = Перечисления.ВидыСкладов.НТТ)И(прСтруктураШапкиДокумента.СкладПолучатель.ВидСклада = Перечисления.ВидыСкладов.Оптовый) Тогда
				Если (Лев(лпПроводка.СчетДт.Код, 2) = "28")ИЛИ(Лев(лпПроводка.СчетКт.Код, 2) = "28") Тогда
					лпДвижения_Хозрасчетный.Удалить(лпНомерПров - 1);
				КонецЕсли; 
			КонецЕсли;
			
			// схема НТТ-НТТ
			Если (прСтруктураШапкиДокумента.СкладОтправитель.ВидСклада = Перечисления.ВидыСкладов.НТТ)И(прСтруктураШапкиДокумента.СкладПолучатель.ВидСклада = Перечисления.ВидыСкладов.НТТ) Тогда
				Если (Лев(лпПроводка.СчетДт.Код, 2) = "28")ИЛИ(Лев(лпПроводка.СчетКт.Код, 2) = "28") Тогда
					лпДвижения_Хозрасчетный.Удалить(лпНомерПров - 1);
				КонецЕсли; 
			КонецЕсли;
			
			
			лпНомерПров = лпНомерПров - 1;
		КонецЦикла;
		
	КонецЕсли;
	
	// проводки по строке
	Если "СформироватьПроводкиСтрока" = "СформироватьПроводкиСтрока" Тогда
		Для каждого Строка Из лпДокСсылка.Товары Цикл
			лпСуммаЗакБезНДС     = ПолучитьДопРеквизитТабличнойЧастиСумма(лпДопДанныеДокумента, "Товары", Строка.Номенклатура, "СуммаЗакБезНДС");
			
			лпСуммаЗакБезНДС = ПолучитьДопРеквизитТабличнойЧастиСумма(лпДопДанныеДокумента, "Товары", Строка.Номенклатура, "СуммаЗакБезНДС");
			лпСуммаЗакНДС = ПолучитьДопРеквизитТабличнойЧастиСумма(лпДопДанныеДокумента, "Товары", Строка.Номенклатура, "СуммаЗакНДС");
			лпСуммаЗакСНДС = ПолучитьДопРеквизитТабличнойЧастиСумма(лпДопДанныеДокумента, "Товары", Строка.Номенклатура, "СуммаЗакСНДС");
			// !!!
			Если ОбщегоНазначения.ПолучитьСхемуНалогообложения(лпДокСсылка.Дата,лпДокСсылка.Организация).НДС = Ложь Тогда
				лпСебестоимость = лпСуммаЗакСНДС;
			Иначе
				лпСебестоимость = лпСуммаЗакБезНДС;
			КонецЕсли;
			лпСуммаРознУчетСНДС = ПолучитьДопРеквизитТабличнойЧастиСумма(лпДопДанныеДокумента, "Товары", Строка.Номенклатура, "СуммаРознУчетСНДС");
			лпСуммаРознРеализацииСНДС     = ПолучитьДопРеквизитТабличнойЧастиСумма(лпДопДанныеДокумента, "Товары", Строка.Номенклатура, "СуммаРознРеализацииСНДС");
			лпСуммаРознРеализацииСкидка   = ПолучитьДопРеквизитТабличнойЧастиСумма(лпДопДанныеДокумента, "Товары", Строка.Номенклатура, "СуммаРознРеализацииСкидка");
			лпСуммаНаценкиОтправителя = лпСуммаРознУчетСНДС - лпСебестоимость;
			лпСуммаНаценкиПолучателя = лпСуммаРознРеализацииСНДС - лпСебестоимость;
			
			//***** Хозрасчетный - проводки
			// схема оптовый-розничный
			Если (прСтруктураШапкиДокумента.СкладОтправитель.ВидСклада = Перечисления.ВидыСкладов.Оптовый)И(прСтруктураШапкиДокумента.СкладПолучатель.ВидСклада = Перечисления.ВидыСкладов.Розничный) Тогда
				//***** Хозрасчетный - проводки
				Проводка = прДвижения.Хозрасчетный.Добавить();
				Проводка.Период      = прСтруктураШапкиДокумента.Дата;
				Проводка.Организация = прСтруктураШапкиДокумента.Организация;
				Проводка.Содержание  = НСтр("ru='Перемещение: себестоимость';uk='Переміщення: собівартість'",Локализация.КодЯзыкаИнформационнойБазы());
				
				//Проводка.СчетДт      = ПланыСчетов.Хозрасчетный.ТорговаяНаценкаАТТ;
				//Проводка.СчетКт      = Строка.НовыйСчетУчетаБУ;
				Проводка.СчетДт      = Строка.НовыйСчетУчетаБУ; // 281
				Проводка.СчетКт      = Строка.СчетУчетаБУ; // 282
				
				ОбщегоНазначения.УстановитьСубконто(Проводка.СчетДт, Проводка.СубконтоДт, "Склады",  прСтруктураШапкиДокумента.СкладПолучатель);
				ОбщегоНазначения.УстановитьСубконто(Проводка.СчетКт, Проводка.СубконтоКт, "Склады",  прСтруктураШапкиДокумента.СкладОтправитель);
				ОбщегоНазначения.УстановитьСубконто(Проводка.СчетДт, Проводка.СубконтоДт, "Номенклатура",  Строка.Номенклатура);
				ОбщегоНазначения.УстановитьСубконто(Проводка.СчетКт, Проводка.СубконтоКт, "Номенклатура",  Строка.Номенклатура);
				//ОбщегоНазначения.УстановитьСубконто(Проводка.СчетДт, Проводка.СубконтоДт, "Партии",  Партия.Партия);
				//ОбщегоНазначения.УстановитьСубконто(Проводка.СчетКт, Проводка.СубконтоКт, "Партии",  Партия.Партия);
				Проводка.Сумма  = лпСебестоимость;
				
				Проводка.НалоговоеНазначениеДт = Строка.НалоговоеНазначение;
				Проводка.НалоговоеНазначениеКт = Строка.НалоговоеНазначение;
				Если лпДокОбъект.Дата < Дата(2015,01,01,0,0,0) Тогда
					Проводка.СуммаНУДт = Проводка.Сумма;   				
					Проводка.СуммаНУКт = Проводка.Сумма;
				КонецЕсли;
				
				Если Проводка.СчетДт.Количественный Тогда
					Проводка.КоличествоКт = Строка.Количество;
				КонецЕсли;
				Если Проводка.СчетКт.Количественный Тогда
					Проводка.КоличествоКт = Строка.Количество;
				КонецЕсли;
				
				Если лпСуммаНаценкиПолучателя <> 0 Тогда
					Проводка = прДвижения.Хозрасчетный.Добавить();
					Проводка.Период      = прСтруктураШапкиДокумента.Дата;
					Проводка.Организация = прСтруктураШапкиДокумента.Организация;
					Проводка.Содержание  = НСтр("ru='Перемещение: сумма торговой наценки';uk='Переміщення: торгова націнка'",Локализация.КодЯзыкаИнформационнойБазы());
					
					//Проводка.СчетДт      = ПланыСчетов.Хозрасчетный.ТорговаяНаценкаАТТ;
					//Проводка.СчетКт      = Строка.НовыйСчетУчетаБУ;
					Проводка.СчетДт      = Строка.НовыйСчетУчетаБУ; // 282
					Проводка.СчетКт      = ПланыСчетов.Хозрасчетный.ТорговаяНаценкаАТТ; // 285
					
					ОбщегоНазначения.УстановитьСубконто(Проводка.СчетДт, Проводка.СубконтоДт, "Склады",  прСтруктураШапкиДокумента.СкладПолучатель);
					ОбщегоНазначения.УстановитьСубконто(Проводка.СчетКт, Проводка.СубконтоКт, "Склады",  прСтруктураШапкиДокумента.СкладПолучатель);
					ОбщегоНазначения.УстановитьСубконто(Проводка.СчетДт, Проводка.СубконтоДт, "Номенклатура",  Строка.Номенклатура);
					ОбщегоНазначения.УстановитьСубконто(Проводка.СчетКт, Проводка.СубконтоКт, "Номенклатура",  Строка.Номенклатура);
					//ОбщегоНазначения.УстановитьСубконто(Проводка.СчетДт, Проводка.СубконтоДт, "Партии",  Партия.Партия);
					//ОбщегоНазначения.УстановитьСубконто(Проводка.СчетКт, Проводка.СубконтоКт, "Партии",  Партия.Партия);
					Проводка.Сумма  = лпСуммаНаценкиПолучателя;
					
					Проводка.НалоговоеНазначениеДт = Строка.НалоговоеНазначение; 
					Проводка.НалоговоеНазначениеКт = Строка.НалоговоеНазначение;
					Если лпДокОбъект.Дата < Дата(2015,01,01,0,0,0) Тогда
						Проводка.СуммаНУДт = Проводка.Сумма;  					
						Проводка.СуммаНУКт = Проводка.Сумма;
					КонецЕсли;
					
					Если Проводка.СчетДт.Количественный Тогда
						Проводка.КоличествоКт = Строка.Количество;
					КонецЕсли;
					Если Проводка.СчетКт.Количественный Тогда
						Проводка.КоличествоКт = Строка.Количество;
					КонецЕсли;
				КонецЕсли;
				
				
			КонецЕсли;
			// схема розничный-оптовый
			//сторно
			Если (прСтруктураШапкиДокумента.СкладОтправитель.ВидСклада = Перечисления.ВидыСкладов.Розничный)И(прСтруктураШапкиДокумента.СкладПолучатель.ВидСклада = Перечисления.ВидыСкладов.Оптовый) Тогда
				//***** Хозрасчетный - проводки
				Проводка = прДвижения.Хозрасчетный.Добавить();
				Проводка.Период      = прСтруктураШапкиДокумента.Дата;
				Проводка.Организация = прСтруктураШапкиДокумента.Организация;
				Проводка.Содержание  = НСтр("ru='Перемещение: себестоимость (сторно)';uk='Переміщення: собівартість (сторно)'",Локализация.КодЯзыкаИнформационнойБазы());
				Проводка.СчетДт      = Строка.СчетУчетаБУ; // 282
				Проводка.СчетКт      = Строка.НовыйСчетУчетаБУ; // 281
				
