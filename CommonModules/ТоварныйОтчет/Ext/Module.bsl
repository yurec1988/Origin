Функция ПодготовитьТаблицуТоваров(прТаблицаТоваров, прСтруктураШапкиДокумента) Экспорт
	
	лпТаблицаТоваров = прТаблицаТоваров.Скопировать();
	
	// поиск по одному измерению или реквизиту 
	лпДокСсылка = прСтруктураШапкиДокумента.Ссылка;
	лпСоответствиеДок = Справочники.ТО_СоответствияДокументов;
	лпНайденнаяСсылка = лпСоответствиеДок.НайтиПоРеквизиту("Документ", лпДокСсылка);
	Если лпНайденнаяСсылка = Справочники.ТО_СоответствияДокументов.ПустаяСсылка() Тогда
		Возврат лпТаблицаТоваров;
	Иначе
		лпДопДанныеДокументаСсылка = лпНайденнаяСсылка.ДопДанныеДокумента;
	КонецЕсли;
	
	
	//ТО_СоответствияДокументов = РегистрыСведений.ТО_СоответствияДокументов;
	//лпДопДанныеДокументаСсылка = Справочники.ТО_ДополнительныеДанныеДокументов.ПустаяСсылка();
	//ПараметрОтбора = Новый Структура("Документ");
	//ПараметрОтбора.Документ = лпДокСсылка; 
	//Выборка = ТО_СоответствияДокументов.Выбрать(ПараметрОтбора,);
	//Пока Выборка.Следующий() Цикл
	//	//Сообщить("Дата " + Выборка.Документ);
	//	лпДопДанныеДокументаСсылка = Выборка.ДопДанныеДокумента;
	//	Прервать;
	//КонецЦикла; 
	
	Если НЕ лпДопДанныеДокументаСсылка.Пустая() Тогда
		лпДопДанныеДокумента = лпДопДанныеДокументаСсылка.ПолучитьОбъект();
		Если прСтруктураШапкиДокумента.ВидДокумента = "ПоступлениеТоваровУслуг" Тогда
			МетаданныеДокумента = лпДокСсылка.Метаданные();
			Если ИДКонфигурации() = "БП" Тогда
				Если лпДокСсылка.Склад.ВидСклада = Перечисления.ВидыСкладов.Розничный Тогда
					Для Каждого Строка из лпТаблицаТоваров Цикл
						лпСуммаРознУчетСНДС = ПолучитьДопРеквизитТабличнойЧастиСумма(лпДопДанныеДокумента, "Товары", Строка.Номенклатура, "СуммаРознУчетСНДС");
						//может не быть если учет в закуп. ценах
						Строка.РозничнаяЦена = лпСуммаРознУчетСНДС;
						Строка.УчетнаяЦена   = лпСуммаРознУчетСНДС;
					КонецЦикла;
				КонецЕсли;
				//Строка.Себестоимость = лпСебестоимость;
			КонецЕсли;
			Если ИДКонфигурации() = "УТП" Тогда
				Если МетаданныеДокумента.Реквизиты.Найти("Склад") <> Неопределено Тогда
					Если лпДокСсылка.Склад.ВидСклада = Перечисления.ВидыСкладов.Розничный Тогда
						Для Каждого Строка из лпТаблицаТоваров Цикл
							лпСуммаРознУчетСНДС = ПолучитьДопРеквизитТабличнойЧастиСумма(лпДопДанныеДокумента, "Товары", Строка.Номенклатура, "СуммаРознУчетСНДС");
							Строка.РозничнаяЦена = лпСуммаРознУчетСНДС;
							//Строка.УчетнаяЦена   = лпСуммаРознУчетСНДС;
						КонецЦикла;
					КонецЕсли;
				ИначеЕсли МетаданныеДокумента.Реквизиты.Найти("СкладОрдер") <> Неопределено Тогда
					Если лпДокСсылка.СкладОрдер.ВидСклада = Перечисления.ВидыСкладов.Розничный Тогда
						Для Каждого Строка из лпТаблицаТоваров Цикл
							//ТорговаяНаценка = СтрокаТаблицы.СуммаПродажная - СтрокаТаблицы.ПроводкиСуммаБезНДСРегл;
							лпСебестоимость = ПолучитьДопРеквизитТабличнойЧастиСумма(лпДопДанныеДокумента, "Товары", Строка.Номенклатура, "СуммаЗакБезНДС");
							Строка.Стоимость = лпСебестоимость;
							Строка.СуммаУпр = лпСебестоимость;
							лпСуммаРознУчетСНДС = ПолучитьДопРеквизитТабличнойЧастиСумма(лпДопДанныеДокумента, "Товары", Строка.Номенклатура, "СуммаРознУчетСНДС");
							Строка.СуммаПродажная = лпСуммаРознУчетСНДС;
						КонецЦикла;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
			
