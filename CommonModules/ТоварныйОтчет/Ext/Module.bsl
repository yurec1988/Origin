Процедура ДвиженияПоРегистрамПлатежноеПоручениеВход_VAV(прОтказ, прДвижения,прЗаголовок, прСтруктураШапкиДокумента) Экспорт
	лпДокСсылка = прСтруктураШапкиДокумента.Ссылка;
	лпДокОбъект = лпДокСсылка.ПолучитьОбъект();
	
	//***** Хозрасчетный
	лпДвижения_Хозрасчетный = прДвижения.Хозрасчетный;
	лпНомерПров = лпДвижения_Хозрасчетный.Количество();
	Пока лпНомерПров > 0 Цикл
		лпДвижения_Хозрасчетный.Удалить(лпНомерПров - 1);
		лпНомерПров = лпНомерПров - 1; 
	КонецЦикла;
	
	Проводка = прДвижения.Хозрасчетный.Добавить();
	Проводка.Период      = прСтруктураШапкиДокумента.Дата;
	Проводка.Организация = прСтруктураШапкиДокумента.Организация;
	Проводка.Содержание  = "Расчеты по платежным картам и банковским кредитам";
	
	Проводка.СчетДт      = прСтруктураШапкиДокумента.СчетБанк;
	Проводка.СчетКт      = ПланыСчетов.Хозрасчетный.ДенежныеСредстваВПутиВНациональнойВалюте;
	
	УстановитьСубконто(Проводка.СчетДт, Проводка.СубконтоДт, "БанковскиеСчета",  прСтруктураШапкиДокумента.СчетОрганизации);
	УстановитьСубконто(Проводка.СчетДт, Проводка.СубконтоДт, "СтатьиДвиженияДенежныхСредств", прСтруктураШапкиДокумента.СтатьяДвиженияДенежныхСредств);  
	
	УстановитьСубконто(Проводка.СчетКт, Проводка.СубконтоКт, "Контрагенты",  прСтруктураШапкиДокумента.Контрагент); 	
	Проводка.Сумма = прСтруктураШапкиДокумента.СуммаДокумента;
	
	Проводка = прДвижения.Хозрасчетный.Добавить();
	Проводка.Период      = прСтруктураШапкиДокумента.Дата;
	Проводка.Организация = прСтруктураШапкиДокумента.Организация;
	Проводка.Содержание  = "Расчеты по платежным картам и банковским кредитам";
	
	Проводка.СчетДт      = прСтруктураШапкиДокумента.СчетУчетаРасчетовСКонтрагентом;
	Проводка.СчетКт      = прСтруктураШапкиДокумента.СчетБанк;
	
	УстановитьСубконто(Проводка.СчетДт, Проводка.СубконтоДт, "СтатьиЗатрат",  прСтруктураШапкиДокумента.СубконтоКт1);
	 УстановитьСубконто(Проводка.СчетДт, Проводка.СубконтоДт, "Подразделения",  прСтруктураШапкиДокумента.Подразделение);
	
	УстановитьСубконто(Проводка.СчетКт, Проводка.СубконтоКт, "БанковскиеСчета",  прСтруктураШапкиДокумента.СчетОрганизации); 
	УстановитьСубконто(Проводка.СчетКт, Проводка.СубконтоКт,"СтатьиДвиженияДенежныхСредств", Справочники.СтатьиДвиженияДенежныхСредств.НайтиПоКоду("00024"));  
	Проводка.Сумма = прСтруктураШапкиДокумента.СуммаУслуг;
	
КонецПроцедуры

// ПеремещениеТоваров, РеализацияТоваровУслуг, ОтчетОРозничныхПродажах, СписаниеТоваров, ПереоценкаТоваровВРознице
Процедура ДвиженияПоРегистрам(прОтказ, прДвижения,прРежимПроведения, прСтруктураШапкиДокумента) Экспорт
	Если прОтказ Тогда
		Возврат;
	КонецЕсли;
	// заглушка
	Если Найти(прСтруктураШапкиДокумента.Ссылка.Комментарий, "*****") <> 0 Тогда
		Возврат;
	КонецЕсли;
	
	//***** ПоступлениеТоваровУслуг *****
	Если прСтруктураШапкиДокумента.ВидДокумента = "ПоступлениеТоваровУслуг" Тогда
		Если ИДКонфигурации() = "БП" Тогда
			ДвиженияПоРегистрам_БП_ПоступлениеТоваровУслуг(прДвижения,прРежимПроведения, прСтруктураШапкиДокумента);
		ИначеЕсли ИДКонфигурации() = "УТП" Тогда
			ДвиженияПоРегистрам_УТП_ПоступлениеТоваровУслуг(прДвижения,прРежимПроведения, прСтруктураШапкиДокумента);
		КонецЕсли;
		//***** ВозвратТоваровПоставщику *****
	ИначеЕсли прСтруктураШапкиДокумента.ВидДокумента = "ВозвратТоваровПоставщикуИзНТТ" Тогда
		Если ИДКонфигурации() = "БП" Тогда
			ДвиженияПоРегистрам_БП_ВозвратТоваровПоставщику(прДвижения,прРежимПроведения, прСтруктураШапкиДокумента);
		ИначеЕсли ИДКонфигурации() = "УТП" Тогда
			ДвиженияПоРегистрам_УТП_ВозвратТоваровПоставщикуИзНТТ(прДвижения,прРежимПроведения, прСтруктураШапкиДокумента);
		КонецЕсли;
	ИначеЕсли прСтруктураШапкиДокумента.ВидДокумента = "ПеремещениеТоваров" Тогда
		Если ИДКонфигурации() = "БП" Тогда
			ДвиженияПоРегистрам_БП_ПеремещениеТоваров(прДвижения,прРежимПроведения, прСтруктураШапкиДокумента);
		ИначеЕсли ИДКонфигурации() = "УТП" Тогда
			ДвиженияПоРегистрам_УТП_ПеремещениеТоваров(прДвижения,прРежимПроведения, прСтруктураШапкиДокумента);
		КонецЕсли;
	ИначеЕсли прСтруктураШапкиДокумента.ВидДокумента = "ОтчетОРозничныхПродажах" Тогда
		Если ИДКонфигурации() = "БП" Тогда
			ДвиженияПоРегистрам_БП_ОтчетОРозничныхПродажах(прДвижения,прРежимПроведения, прСтруктураШапкиДокумента);
		ИначеЕсли ИДКонфигурации() = "УТП" Тогда
			ДвиженияПоРегистрам_УТП_ОтчетОРозничныхПродажах(прДвижения,прРежимПроведения, прСтруктураШапкиДокумента);
		КонецЕсли;
	ИначеЕсли прСтруктураШапкиДокумента.ВидДокумента = "РеализацияТоваровУслуг" Тогда
		Если ИДКонфигурации() = "БП" Тогда
			ДвиженияПоРегистрам_БП_РеализацияТоваровУслуг(прДвижения,прРежимПроведения, прСтруктураШапкиДокумента);
		ИначеЕсли ИДКонфигурации() = "УТП" Тогда
			ДвиженияПоРегистрам_УТП_РеализацияТоваровУслуг(прДвижения,прРежимПроведения, прСтруктураШапкиДокумента);
		КонецЕсли;
	ИначеЕсли прСтруктураШапкиДокумента.ВидДокумента = "ВозвратТоваровОтПокупателя" Тогда
		Если ИДКонфигурации() = "БП" Тогда
			ДвиженияПоРегистрам_БП_ВозвратТоваровОтПокупателя(прДвижения,прРежимПроведения, прСтруктураШапкиДокумента);
		ИначеЕсли ИДКонфигурации() = "УТП" Тогда
			ДвиженияПоРегистрам_УТП_ВозвратТоваровОтПокупателя(прДвижения,прРежимПроведения, прСтруктураШапкиДокумента);
		КонецЕсли;
	ИначеЕсли прСтруктураШапкиДокумента.ВидДокумента = "СписаниеТоваров" Тогда
		Если ИДКонфигурации() = "БП" Тогда
			//ДвиженияПоРегистрам_БП_СписаниеТоваров(прДвижения,прРежимПроведения, прСтруктураШапкиДокумента);
