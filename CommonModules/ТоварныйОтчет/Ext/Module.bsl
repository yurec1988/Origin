	Если "СформироватьПроводкиИтог" = "СформироватьПроводкиИтог" Тогда
		
	КонецЕсли;
	
	лпДокОбъект = 0;
КонецПроцедуры


Процедура ДвиженияПоРегистрам_УТП_ВозвратТоваровОтПокупателя(прДвижения,прРежимПроведения, прСтруктураШапкиДокумента) Экспорт
	
	лпДокСсылка = прСтруктураШапкиДокумента.Ссылка;
	лпДокОбъект = лпДокСсылка.ПолучитьОбъект();
	
	//определим наш ли это документ
	лпДокСсылка = прСтруктураШапкиДокумента.Ссылка;
	лпСоответствиеДок = Справочники.ТО_СоответствияДокументов;
	лпНайденнаяСсылка = лпСоответствиеДок.НайтиПоРеквизиту("Документ", лпДокСсылка);
	Если лпНайденнаяСсылка <> Справочники.ТО_СоответствияДокументов.ПустаяСсылка() Тогда
		лпДопДанныеДокументаСсылка = лпНайденнаяСсылка.ДопДанныеДокумента;
	Иначе
		лпДопДанныеДокументаСсылка = Справочники.ТО_ДополнительныеДанныеДокументов.ПустаяСсылка();
	КонецЕсли;
	
	Если лпДопДанныеДокументаСсылка.Пустая() Тогда
		Возврат;
	КонецЕсли;
	лпДопДанныеДокумента = лпДопДанныеДокументаСсылка.ПолучитьОбъект();
	
	//удалим неподходящие стандартные проводки
	Если "УдалитьПроводки" = "УдалитьПроводки" Тогда
		КНТ_ЮрЛицо = Истина;
		Если лпДокСсылка.Контрагент.ЮрФизЛицо <> Перечисления.ЮрФизЛицо.ЮрЛицо Тогда
			КНТ_ЮрЛицо = Ложь;
		КонецЕсли;
		
		прДвижения.ПартииТоваровНаСкладах.Очистить();
		прДвижения.ПродажиСебестоимость.Очистить();
		прДвижения.ТоварыОрганизаций.Очистить();
		
		Если КНТ_ЮрЛицо = Ложь Тогда
			прДвижения.ПродажиНалоговыйУчет.Очистить();
			прДвижения.РасчетыСКонтрагентами.Очистить();
			прДвижения.ВзаиморасчетыСКонтрагентами.Очистить();
		КонецЕсли;   		
		
		//***** Хозрасчетный
		Если КНТ_ЮрЛицо = Ложь Тогда
			прДвижения.Хозрасчетный.Очистить();
		Иначе
			// удалим все проводки кроме НДС и 361(6811) 
			лпДвижения_Хозрасчетный = прДвижения.Хозрасчетный;
			лпНомерПров = лпДвижения_Хозрасчетный.Количество();
			Пока лпНомерПров > 0 Цикл
				лпПроводка = лпДвижения_Хозрасчетный.Получить(лпНомерПров - 1);
				// схема розничный и НТТ 
				Если (прСтруктураШапкиДокумента.СкладОрдер.ВидСклада = Перечисления.ВидыСкладов.Розничный)
					ИЛИ (прСтруктураШапкиДокумента.СкладОрдер.ВидСклада = Перечисления.ВидыСкладов.НТТ)  Тогда
					// движение по документу
					Если (лпПроводка.СчетКт = прСтруктураШапкиДокумента.СчетУчетаРасчетовСКонтрагентом) ИЛИ
						(лпПроводка.СчетДт = прСтруктураШапкиДокумента.СчетУчетаРасчетовСКонтрагентом)  ИЛИ
						(лпПроводка.СчетКт = прСтруктураШапкиДокумента.СчетУчетаРасчетовПоАвансам) ИЛИ
						(лпПроводка.СчетДт = прСтруктураШапкиДокумента.СчетУчетаРасчетовПоАвансам) ИЛИ
						(лпПроводка.СчетКт = прСтруктураШапкиДокумента.СчетУчетаНДС) ИЛИ
						(лпПроводка.СчетКт = прСтруктураШапкиДокумента.СчетУчетаНДСПодтвержденный)						
						Тогда
						// оставляем проводку
					Иначе
						лпДвижения_Хозрасчетный.Удалить(лпНомерПров - 1);   
					КонецЕсли;		
				КонецЕсли;
				лпНомерПров = лпНомерПров - 1;
			КонецЦикла;   			
		КонецЕсли;  
	КонецЕсли;
	
	лпДвижения_Продажи = прДвижения.Продажи;
	лпНомерПров = лпДвижения_Продажи.Количество();
	Пока лпНомерПров > 0 Цикл
		лпПроводка = лпДвижения_Продажи.Получить(лпНомерПров - 1);
		лпПроводка.Количество = "";
		лпНомерПров = лпНомерПров - 1; 
	КонецЦикла; 
	
	
	//
	// проводки по итогу ТЧ
	Если "СформироватьПроводкиИтогТЧ" = "СформироватьПроводкиИтогТЧ" Тогда  		
		лпСуммаПродажПоКартам = 0;
		Если КНТ_ЮрЛицо = Ложь Тогда
			лпСуммаПродажПоКартам = АБС(ПолучитьДопРеквизитШапкиСумма(лпДопДанныеДокумента, "СуммаЭквайринг"));
			лпСуммаПродажНаличние = лпДокСсылка.Товары.Итог("Сумма") - лпСуммаПродажПоКартам;
			
			Если лпСуммаПродажПоКартам <> 0 Тогда 										
				// терминал 333 - 36Р
				лпПараметрыСкладов = ПолучитьТО_ПараметрыСкладов(прСтруктураШапкиДокумента.СкладОрдер);
				КНТ = лпПараметрыСкладов.ДоговорЭквайринга.Эквайрер;
				//лпНужнСтатья = Справочники.СтатьиДоходов.НайтиПоКоду("000001001");   			
				Проводка = прДвижения.Хозрасчетный.Добавить();
				Проводка.Период      = прСтруктураШапкиДокумента.Дата;
				Проводка.Организация = прСтруктураШапкиДокумента.Организация;
				Проводка.Содержание  = НСтр("Возврат от покупателя: оплата платежными картами",Локализация.КодЯзыкаИнформационнойБазы());
				//333
				Проводка.СчетДт = ПланыСчетов.Хозрасчетный.ДенежныеСредстваВПутиВНациональнойВалюте;
				ТоварныйОтчет.УстановитьСубконто(Проводка.СчетДт, Проводка.СубконтоДт, "Контрагенты", КНТ);
				
				//36Р
				Проводка.СчетКт = ПланыСчетов.Хозрасчетный.НайтиПоКоду("36Р");
				ТоварныйОтчет.УстановитьСубконто(Проводка.СчетКт, Проводка.СубконтоКт, "Склады", прСтруктураШапкиДокумента.СкладОрдер);
				
				Проводка.Сумма = -лпСуммаПродажПоКартам;
			КонецЕсли;  			
			
			Если лпСуммаПродажНаличние > 0 Тогда
				// наличные  3331 - 36Р
				Проводка = прДвижения.Хозрасчетный.Добавить();
				Проводка.Период      = прСтруктураШапкиДокумента.Дата;
				Проводка.Организация = прСтруктураШапкиДокумента.Организация;
				Проводка.Содержание  = НСтр("ru='Возврат от покупателя: оплата наличными';uk='Повернення від покупця: оплата готівкою'",Локализация.КодЯзыкаИнформационнойБазы());
				
				Проводка.СчетДт = ПланыСчетов.Хозрасчетный.НайтиПоКоду("3331");   // 3331
				УстановитьСубконто(Проводка.СчетДт, Проводка.СубконтоДт, "Склады",  прСтруктураШапкиДокумента.СкладОрдер);
				
				Проводка.СчетКт = ПланыСчетов.Хозрасчетный.НайтиПоКоду("36Р");
				УстановитьСубконто(Проводка.СчетКт, Проводка.СубконтоКт, "Склады", прСтруктураШапкиДокумента.СкладОрдер);
				
				Проводка.Сумма = -лпСуммаПродажНаличние;  						
			КонецЕсли;  		
		КонецЕсли;
	КонецЕсли;

	
	// проводки по строке
	Если "СформироватьПроводкиСтрока" = "СформироватьПроводкиСтрока" Тогда
		Для каждого Строка Из лпДокСсылка.Товары Цикл
			// суммы отрицательные
			лпСуммаЗакБезНДС = ПолучитьДопРеквизитТабличнойЧастиСумма(лпДопДанныеДокумента, "Товары", Строка.Номенклатура, "СуммаЗакБезНДС");
			лпСуммаЗакНДС = ПолучитьДопРеквизитТабличнойЧастиСумма(лпДопДанныеДокумента, "Товары", Строка.Номенклатура, "СуммаЗакНДС");
			лпСуммаЗакСНДС = ПолучитьДопРеквизитТабличнойЧастиСумма(лпДопДанныеДокумента, "Товары", Строка.Номенклатура, "СуммаЗакСНДС");
			// !!!
			Если ОбщегоНазначения.ПолучитьСхемуНалогообложения(лпДокСсылка.Дата,лпДокСсылка.Организация).НДС = Ложь Тогда
				лпСебестоимость = лпСуммаЗакСНДС;
			Иначе
				лпСебестоимость = лпСуммаЗакБезНДС;
			КонецЕсли;
			
			лпСуммаРознРеализацииБезНДС = ПолучитьДопРеквизитТабличнойЧастиСумма(лпДопДанныеДокумента, "Товары", Строка.Номенклатура, "СуммаРознРеализацииБезНДС");
			лпСуммаРознРеализацииНДС = ПолучитьДопРеквизитТабличнойЧастиСумма(лпДопДанныеДокумента, "Товары", Строка.Номенклатура, "СуммаРознРеализацииНДС");
			лпСуммаРознРеализацииСНДС = ПолучитьДопРеквизитТабличнойЧастиСумма(лпДопДанныеДокумента, "Товары", Строка.Номенклатура, "СуммаРознРеализацииСНДС");
			
			лпСуммаВозвратаБезНДС = ПолучитьДопРеквизитТабличнойЧастиСумма(лпДопДанныеДокумента, "Товары", Строка.Номенклатура, "СуммаВозвратаБезНДС");
			лпСуммаВозвратаНДС = ПолучитьДопРеквизитТабличнойЧастиСумма(лпДопДанныеДокумента, "Товары", Строка.Номенклатура, "СуммаВозвратаНДС");
			лпСуммаВозвратаСНДС = ПолучитьДопРеквизитТабличнойЧастиСумма(лпДопДанныеДокумента, "Товары", Строка.Номенклатура, "СуммаВозвратаСНДС");
			
			лпСуммаРознРеализацииСкидка = ПолучитьДопРеквизитТабличнойЧастиСумма(лпДопДанныеДокумента, "Товары", Строка.Номенклатура, "СуммаРознРеализацииСкидка");
			
			лпСуммаРознУчетБезНДС = ПолучитьДопРеквизитТабличнойЧастиСумма(лпДопДанныеДокумента, "Товары", Строка.Номенклатура, "СуммаРознУчетБезНДС");
			лпСуммаРознУчетНДС = ПолучитьДопРеквизитТабличнойЧастиСумма(лпДопДанныеДокумента, "Товары", Строка.Номенклатура, "СуммаРознУчетНДС");
			лпСуммаРознУчетСНДС = ПолучитьДопРеквизитТабличнойЧастиСумма(лпДопДанныеДокумента, "Товары", Строка.Номенклатура, "СуммаРознУчетСНДС");
			
			лпСуммаРеальнойНаценки = (лпСуммаРознРеализацииСНДС + лпСуммаВозвратаСНДС) - лпСебестоимость;
			лпСуммаСписываемойНаценки = лпСуммаРознУчетСНДС - лпСебестоимость;
			
			
			//***** Хозрасчетный - проводки
						
			// схема НТТ
			Если (прСтруктураШапкиДокумента.СкладОрдер.ВидСклада = Перечисления.ВидыСкладов.НТТ) Тогда
				// 902 - 282
				Проводка = прДвижения.Хозрасчетный.Добавить();
				Проводка.Период      = прСтруктураШапкиДокумента.Дата;
				Проводка.Организация = прСтруктураШапкиДокумента.Организация;
				Проводка.Содержание  = НСтр("ru='Возврат товаров от покупателя';uk='Повернення товарів від покупця'",Локализация.КодЯзыкаИнформационнойБазы());
				
				Проводка.СчетДт      = Строка.СхемаРеализации.СчетСебестоимости;
				УстановитьСубконто(Проводка.СчетДт, Проводка.СубконтоДт, "СтатьиЗатрат",  Справочники.СтатьиЗатрат.НПНК_СВ_Товары);
				УстановитьСубконто(Проводка.СчетДт, Проводка.СубконтоДт, "НоменклатурныеГруппы",  Строка.Номенклатура.НоменклатурнаяГруппа); 
				УстановитьСубконто(Проводка.СчетДт, Проводка.СубконтоДт, 3,  Строка.СхемаРеализации.СубконтоСебестоимости3); 
								
				Проводка.СчетКт      = Строка.СчетУчетаБУ;
				УстановитьСубконто(Проводка.СчетКт, Проводка.СубконтоКт, "Склады",  прСтруктураШапкиДокумента.СкладОрдер);
				УстановитьСубконто(Проводка.СчетКт, Проводка.СубконтоКт, "Номенклатура",  Строка.Номенклатура);
				УстановитьСубконто(Проводка.СчетКт, Проводка.СубконтоКт, "СтавкиНДС",  Строка.СтавкаНДС);
				
				Проводка.Сумма  = -лпСебестоимость;
				
				Проводка.НалоговоеНазначениеКт = Строка.НалоговоеНазначение;
				Если лпДокОбъект.Дата < Дата(2015,01,01,0,0,0) Тогда
					Проводка.НалоговоеНазначениеДт = Строка.НалоговоеНазначениеДоходовИЗатрат; 
					Проводка.СуммаНУДт = Проводка.Сумма;  				
					Проводка.СуммаНУКт = Проводка.Сумма; 
				КонецЕсли;
				
				Если (лпСуммаРеальнойНаценки <> 0) Тогда
					// 285 - 282 торговая наценка
					Проводка = прДвижения.Хозрасчетный.Добавить();
					Проводка.Период          = лпДокСсылка.Дата;
					Проводка.Организация = лпДокСсылка.Организация;
					Проводка.Содержание = "Возврат от покупателя: торговая надбавка сторно";
					Проводка.СчетДт = ПланыСчетов.Хозрасчетный.ТорговаяНаценкаНТТ;
					Проводка.СчетКт = Строка.СчетУчетаБУ;
					УстановитьСубконто(Проводка.СчетДт, Проводка.СубконтоДт, "Склады",  прСтруктураШапкиДокумента.СкладОрдер);
					УстановитьСубконто(Проводка.СчетКт, Проводка.СубконтоКт, "Склады",  прСтруктураШапкиДокумента.СкладОрдер);
					УстановитьСубконто(Проводка.СчетДт, Проводка.СубконтоДт, "Номенклатура",  Строка.Номенклатура);
					УстановитьСубконто(Проводка.СчетКт, Проводка.СубконтоКт, "Номенклатура",  Строка.Номенклатура);
					УстановитьСубконто(Проводка.СчетДт, Проводка.СубконтоДт, "СтавкиНДС",  Строка.СтавкаНДС);
					УстановитьСубконто(Проводка.СчетКт, Проводка.СубконтоКт, "СтавкиНДС",  Строка.СтавкаНДС);  
					
					Проводка.Сумма = -лпСуммаРеальнойНаценки;
					Если Проводка.СчетДт.Количественный Тогда
						Проводка.КоличествоДт = -Строка.Количество;
					КонецЕсли;
					Если Проводка.СчетКт.Количественный Тогда
						Проводка.КоличествоКт = -Строка.Количество;
					КонецЕсли;
					
					Проводка.НалоговоеНазначениеДт = Строка.НалоговоеНазначение; 
					Проводка.НалоговоеНазначениеКт = Строка.НалоговоеНазначение;
					Если лпДокОбъект.Дата < Дата(2015,01,01,0,0,0) Тогда
						Проводка.СуммаНУДт = Проводка.Сумма;  					
						Проводка.СуммаНУКт = Проводка.Сумма;
					КонецЕсли;
					
				КонецЕсли;
				
				Если (лпСуммаРеальнойНаценки <> лпСуммаСписываемойНаценки) Тогда
					// 285 - 282 торговая наценка
					Проводка = прДвижения.Хозрасчетный.Добавить();
					Проводка.Период          = лпДокСсылка.Дата;
					Проводка.Организация = лпДокСсылка.Организация;
					Проводка.Содержание = "Переоц при возвр.:Сторнирована сумма торговой наценки.";
					Проводка.СчетДт = ПланыСчетов.Хозрасчетный.ТорговаяНаценкаНТТ;
					Проводка.СчетКт = Строка.СчетУчетаБУ;
					УстановитьСубконто(Проводка.СчетДт, Проводка.СубконтоДт, "Склады",  прСтруктураШапкиДокумента.СкладОрдер);
					УстановитьСубконто(Проводка.СчетКт, Проводка.СубконтоКт, "Склады",  прСтруктураШапкиДокумента.СкладОрдер);
					УстановитьСубконто(Проводка.СчетДт, Проводка.СубконтоДт, "Номенклатура",  Строка.Номенклатура);
					УстановитьСубконто(Проводка.СчетКт, Проводка.СубконтоКт, "Номенклатура",  Строка.Номенклатура);
					УстановитьСубконто(Проводка.СчетДт, Проводка.СубконтоДт, "СтавкиНДС",  Строка.СтавкаНДС);
					УстановитьСубконто(Проводка.СчетКт, Проводка.СубконтоКт, "СтавкиНДС",  Строка.СтавкаНДС);  
					Проводка.Сумма = -(лпСуммаСписываемойНаценки - лпСуммаРеальнойНаценки);
					Если Проводка.СчетДт.Количественный Тогда
						Проводка.КоличествоДт = -Строка.Количество;
					КонецЕсли;
					Если Проводка.СчетКт.Количественный Тогда
						Проводка.КоличествоКт = -Строка.Количество;
					КонецЕсли;
					
					Проводка.НалоговоеНазначениеДт = Строка.НалоговоеНазначение; 
					Проводка.НалоговоеНазначениеКт = Строка.НалоговоеНазначение;
					Если лпДокОбъект.Дата < Дата(2015,01,01,0,0,0) Тогда
						Проводка.СуммаНУДт = Проводка.Сумма;  					
						Проводка.СуммаНУКт = Проводка.Сумма;
					КонецЕсли;
					
				КонецЕсли;
				
				Если КНТ_ЮрЛицо = Ложь Тогда
					// 36Р - 7091
					Проводка = прДвижения.Хозрасчетный.Добавить();
					Проводка.Период      = прСтруктураШапкиДокумента.Дата;
					Проводка.Организация = прСтруктураШапкиДокумента.Организация;
					Проводка.Содержание  = НСтр("ru='Возврат от покупателя';uk='Повернення від покупця'",Локализация.КодЯзыкаИнформационнойБазы());
					
					Проводка.СчетДт = ПланыСчетов.Хозрасчетный.НайтиПоКоду("36Р");
					ТоварныйОтчет.УстановитьСубконто(Проводка.СчетДт, Проводка.СубконтоДт, "Склады", прСтруктураШапкиДокумента.СкладОрдер);

					Проводка.СчетКт =  ПланыСчетов.Хозрасчетный.ДоходОтРозницы; // 7091   			
					УстановитьСубконто(Проводка.СчетКт, Проводка.СубконтоКт, "СтатьиДоходов",  Строка.СхемаРеализации.СубконтоДоходов1);
					УстановитьСубконто(Проводка.СчетКт, Проводка.СубконтоКт, "НоменклатурныеГруппы",  Строка.Номенклатура.НоменклатурнаяГруппа); 
					УстановитьСубконто(Проводка.СчетКт, Проводка.СубконтоКт, 3, Строка.СхемаРеализации.СубконтоДоходов3); 
					
					Проводка.Сумма = -АБС(лпСуммаРознРеализацииСНДС);;
					
					Если лпДокОбъект.Дата < Дата(2015,01,01,0,0,0) Тогда
						Проводка.НалоговоеНазначениеКт = Строка.НалоговоеНазначениеДоходовИЗатрат;
						Проводка.СуммаНУКт = Проводка.Сумма;  
					КонецЕсли;
										
					лпСуммаНДС = Строка.СуммаНДС;
					Если лпСуммаНДС<>0 Тогда
						// 7091 - 6434
						Проводка = прДвижения.Хозрасчетный.Добавить();
						Проводка.Период      = прСтруктураШапкиДокумента.Дата;
						Проводка.Организация = прСтруктураШапкиДокумента.Организация;
						Проводка.Содержание  = НСтр("ru='НДС розничной выручки (возврат)';uk='НДС розничной выручки (возврат)'",Локализация.КодЯзыкаИнформационнойБазы());
						
						Проводка.СчетДт =  ПланыСчетов.Хозрасчетный.ДоходОтРозницы; // 7091   			
						УстановитьСубконто(Проводка.СчетДт, Проводка.СубконтоДт, "СтатьиДоходов",  Строка.СхемаРеализации.СубконтоДоходов1);
						УстановитьСубконто(Проводка.СчетДт, Проводка.СубконтоДт, "НоменклатурныеГруппы",  Строка.Номенклатура.НоменклатурнаяГруппа); 
						УстановитьСубконто(Проводка.СчетДт, Проводка.СубконтоДт, 3, Строка.СхемаРеализации.СубконтоДоходов3); 
					
						Проводка.СчетКт      = ПланыСчетов.Хозрасчетный.НалоговыеОбязательстваРозница;
						
						Проводка.Сумма  = - лпСуммаНДС;
						
						Если лпДокОбъект.Дата < Дата(2015,01,01,0,0,0) Тогда
							Проводка.НалоговоеНазначениеДт = Строка.НалоговоеНазначениеДоходовИЗатрат; 
							Проводка.СуммаНУДт = Проводка.Сумма;  
						КонецЕсли;
					КонецЕсли;		
					
				КонецЕсли;
				
				// ***** регистр ТоварыВНТТВПродажныхЦенах
				НовоеДвижение = прДвижения.ТоварыВНТТВПродажныхЦенах.Добавить();   			
				НовоеДвижение.Активность  = Истина;
				НовоеДвижение.ВидДвижения = ВидДвиженияНакопления.Расход;  
				НовоеДвижение.Период 	   = лпДокСсылка.Дата;  
				НовоеДвижение.Регистратор = лпДокСсылка;  			
				НовоеДвижение.Склад 	   = прСтруктураШапкиДокумента.СкладОрдер;  			
				НовоеДвижение.СтавкаНДС= Строка.СтавкаНДС;
				НовоеДвижение.Сумма 		 = -АБС(лпСуммаРознУчетСНДС);
				Если ОбщегоНазначения.ПолучитьСхемуНалогообложения(лпДокСсылка.Дата,лпДокСсылка.Организация).НДС = Ложь Тогда
					лпСуммаНаценки = АБС(лпСуммаРознУчетСНДС - лпСебестоимость); 
				Иначе
					лпСуммаНаценки = АБС(лпСуммаРознУчетСНДС - лпСебестоимость - лпСуммаЗакНДС);
				КонецЕсли;
				НовоеДвижение.СуммаНаценки  = -лпСуммаНаценки;  			
				НовоеДвижение.Номенклатура  = Строка.Номенклатура;
				НовоеДвижение.ХарактеристикаНоменклатуры  = Строка.ХарактеристикаНоменклатуры; 			
				НовоеДвижение.КодОперации   = Перечисления.КодыОперацийТоварыВНТТВПродажныхЦенах.Возврат;    	
				
			КонецЕсли;  			
		КонецЦикла;   				
	КонецЕсли; // СформироватьПроводкиСтрока
	
	Если КНТ_ЮрЛицо = Ложь Тогда
		// чтобы не формировать приложение2
		Движение_ОжидаемыйИПодтвержденныйНДСПродаж = прДвижения.ОжидаемыйИПодтвержденныйНДСПродаж;  
		лпНомерПров = Движение_ОжидаемыйИПодтвержденныйНДСПродаж.Количество();
		Пока лпНомерПров > 0 Цикл
			лпПроводка = Движение_ОжидаемыйИПодтвержденныйНДСПродаж.Получить(лпНомерПров - 1);  						
			лпПроводка.ДоговорКонтрагента = "";
			лпПроводка.СобытиеНДС = Перечисления.СобытияОжидаемыйИПодтвержденныйНДСПродаж.РеализацияРозница;
			лпПроводка.БазаНДС = -лпПроводка.БазаНДС;
			лпПроводка.СуммаНДС = -лпПроводка.СуммаНДС;
			лпНомерПров = лпНомерПров - 1; 
		КонецЦикла; 	
	КонецЕсли;	 // Если КНТ_ЮрЛицо = Ложь 
	
	лпДокОбъект = 0;
КонецПроцедуры

Процедура ДвиженияПоРегистрам_БП_ВозвратТоваровОтПокупателя(прДвижения,прРежимПроведения, прСтруктураШапкиДокумента) Экспорт
	
	лпДокСсылка = прСтруктураШапкиДокумента.Ссылка;
	лпДокОбъект = лпДокСсылка.ПолучитьОбъект();
	
	//определим наш ли это документ
	лпДокСсылка = прСтруктураШапкиДокумента.Ссылка;
	лпСоответствиеДок = Справочники.ТО_СоответствияДокументов;
	лпНайденнаяСсылка = лпСоответствиеДок.НайтиПоРеквизиту("Документ", лпДокСсылка);
	Если лпНайденнаяСсылка <> Справочники.ТО_СоответствияДокументов.ПустаяСсылка() Тогда
		лпДопДанныеДокументаСсылка = лпНайденнаяСсылка.ДопДанныеДокумента;
	Иначе
		лпДопДанныеДокументаСсылка = Справочники.ТО_ДополнительныеДанныеДокументов.ПустаяСсылка();
	КонецЕсли;
	
	Если лпДопДанныеДокументаСсылка.Пустая() Тогда
		Возврат;
	КонецЕсли;
	лпДопДанныеДокумента = лпДопДанныеДокументаСсылка.ПолучитьОбъект();
	
	//удалим неподходящие стандартные проводки
	Если "УдалитьПроводки" = "УдалитьПроводки" Тогда
		
		//***** Хозрасчетный
		лпДвижения_Хозрасчетный = прДвижения.Хозрасчетный;
		лпНомерПров = лпДвижения_Хозрасчетный.Количество();
		Пока лпНомерПров > 0 Цикл
			лпПроводка = лпДвижения_Хозрасчетный.Получить(лпНомерПров - 1);
			// схема оптовый
			// схема розничный
			
			// схема розничный
			Если (прСтруктураШапкиДокумента.Склад.ВидСклада = Перечисления.ВидыСкладов.Розничный) Тогда
				// движение по документу
				Если (лпПроводка.СчетКт = прСтруктураШапкиДокумента.СчетУчетаРасчетовСКонтрагентом) Тогда
					лпДвижения_Хозрасчетный.Удалить(лпНомерПров - 1);
				КонецЕсли;
				Если (лпПроводка.СчетКт = ПланыСчетов.Хозрасчетный.ТорговаяНаценкаАТТ) Тогда
					лпДвижения_Хозрасчетный.Удалить(лпНомерПров - 1);
				КонецЕсли;
			КонецЕсли;
			лпНомерПров = лпНомерПров - 1;
		КонецЦикла;
		
		
	КонецЕсли;
	//
	// проводки по строке
	Если "СформироватьПроводкиСтрока" = "СформироватьПроводкиСтрока" Тогда
		Для каждого Строка Из лпДокСсылка.Товары Цикл
			// суммы отрицательные
			лпСуммаЗакБезНДС = ПолучитьДопРеквизитТабличнойЧастиСумма(лпДопДанныеДокумента, "Товары", Строка.Номенклатура, "СуммаЗакБезНДС");
			лпСуммаЗакНДС = ПолучитьДопРеквизитТабличнойЧастиСумма(лпДопДанныеДокумента, "Товары", Строка.Номенклатура, "СуммаЗакНДС");
			лпСуммаЗакСНДС = ПолучитьДопРеквизитТабличнойЧастиСумма(лпДопДанныеДокумента, "Товары", Строка.Номенклатура, "СуммаЗакСНДС");
			// !!!
			лпСебестоимость = лпСуммаЗакБезНДС;
			
			лпСуммаРознРеализацииБезНДС = ПолучитьДопРеквизитТабличнойЧастиСумма(лпДопДанныеДокумента, "Товары", Строка.Номенклатура, "СуммаРознРеализацииБезНДС");
			лпСуммаРознРеализацииНДС = ПолучитьДопРеквизитТабличнойЧастиСумма(лпДопДанныеДокумента, "Товары", Строка.Номенклатура, "СуммаРознРеализацииНДС");
			лпСуммаРознРеализацииСНДС = ПолучитьДопРеквизитТабличнойЧастиСумма(лпДопДанныеДокумента, "Товары", Строка.Номенклатура, "СуммаРознРеализацииСНДС");
			
			лпСуммаВозвратаБезНДС = ПолучитьДопРеквизитТабличнойЧастиСумма(лпДопДанныеДокумента, "Товары", Строка.Номенклатура, "СуммаВозвратаБезНДС");
			лпСуммаВозвратаНДС = ПолучитьДопРеквизитТабличнойЧастиСумма(лпДопДанныеДокумента, "Товары", Строка.Номенклатура, "СуммаВозвратаНДС");
			лпСуммаВозвратаСНДС = ПолучитьДопРеквизитТабличнойЧастиСумма(лпДопДанныеДокумента, "Товары", Строка.Номенклатура, "СуммаВозвратаСНДС");
			
			лпСуммаРознРеализацииСкидка = ПолучитьДопРеквизитТабличнойЧастиСумма(лпДопДанныеДокумента, "Товары", Строка.Номенклатура, "СуммаРознРеализацииСкидка");
			
			лпСуммаРознУчетБезНДС = ПолучитьДопРеквизитТабличнойЧастиСумма(лпДопДанныеДокумента, "Товары", Строка.Номенклатура, "СуммаРознУчетБезНДС");
			лпСуммаРознУчетНДС = ПолучитьДопРеквизитТабличнойЧастиСумма(лпДопДанныеДокумента, "Товары", Строка.Номенклатура, "СуммаРознУчетНДС");
			лпСуммаРознУчетСНДС = ПолучитьДопРеквизитТабличнойЧастиСумма(лпДопДанныеДокумента, "Товары", Строка.Номенклатура, "СуммаРознУчетСНДС");
			
			лпСуммаРеальнойНаценки = (лпСуммаРознРеализацииСНДС + лпСуммаВозвратаСНДС) - лпСебестоимость;
			лпСуммаСписываемойНаценки = лпСуммаРознУчетСНДС - лпСебестоимость;
			
			
			//***** Хозрасчетный - проводки
			//Проводка = прДвижения.Хозрасчетный.Добавить();
			//Проводка.Период          = лпДокСсылка.Дата;
			//Проводка.Организация = лпДокСсылка.Организация;
			//Проводка.Содержание = "Возврат ТМЦ: себестоимость сторно";
			//Проводка.СчетДт = Строка.СчетУчетаБУ;
			//Проводка.СчетКт = прСтруктураШапкиДокумента.СчетУчетаРасчетовСКонтрагентом;
			//ЗаполнитьСубконто(Проводка, прСтруктураШапкиДокумента, Строка,,,,,Строка.СтатьяПриростаУбылиЗапасов);
			//Если Строка.НДСВключенВСтоимость Тогда
			//	Проводка.Сумма = - (Строка.Сумма - Строка.СуммаНДС);
			//Иначе
			//	Проводка.Сумма = - Строка.Сумма;
			//КонецЕсли;
			//Если Проводка.СчетКт.Количественный Тогда
			//	Проводка.КоличествоКт = - Строка.Количество;
			//КонецЕсли;
			
			// схема розничный
			Если (прСтруктураШапкиДокумента.Склад.ВидСклада = Перечисления.ВидыСкладов.Розничный) Тогда
				Если (лпСуммаРеальнойНаценки <> 0) Тогда
					// 285 - 282 торговая наценка
					Проводка = прДвижения.Хозрасчетный.Добавить();
					Проводка.Период          = лпДокСсылка.Дата;
					Проводка.Организация = лпДокСсылка.Организация;
					Проводка.Содержание = "Возврат от покупателя: торговая надбавка сторно";
					Проводка.СчетДт = ПланыСчетов.Хозрасчетный.ТорговаяНаценкаАТТ;
					Проводка.СчетКт = Строка.СчетУчетаБУ;
					УстановитьСубконто(Проводка.СчетДт, Проводка.СубконтоДт, "Склады",  прСтруктураШапкиДокумента.Склад);
					УстановитьСубконто(Проводка.СчетКт, Проводка.СубконтоКт, "Склады",  прСтруктураШапкиДокумента.Склад);
					УстановитьСубконто(Проводка.СчетДт, Проводка.СубконтоДт, "Номенклатура",  Строка.Номенклатура);
					УстановитьСубконто(Проводка.СчетКт, Проводка.СубконтоКт, "Номенклатура",  Строка.Номенклатура);
					Проводка.Сумма = -лпСуммаРеальнойНаценки;
					Если Проводка.СчетДт.Количественный Тогда
						Проводка.КоличествоДт = -Строка.Количество;
					КонецЕсли;
					Если Проводка.СчетКт.Количественный Тогда
						Проводка.КоличествоКт = -Строка.Количество;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
			
			
		КонецЦикла;
	КонецЕсли;
	
	лпДокОбъект = 0;
КонецПроцедуры

Процедура ДвиженияПоРегистрам_УТП_ПереоценкаТоваровВРознице(прДвижения,прРежимПроведения, прСтруктураШапкиДокумента) Экспорт
	
