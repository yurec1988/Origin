		СуммаДокументаСНДСВВалютеРасчетов = лпДокСсылка.Товары.Итог("Сумма");
	Иначе
		СуммаДокументаСНДСВВалютеРасчетов = лпДокСсылка.Товары.Итог("Сумма") + лпДокСсылка.Товары.Итог("СуммаНДС");
	КонецЕсли;

	Если НаправлениеДвижения=Перечисления.НаправленияДвижений.Поступление тогда
		СодержаниеОперации = "Выделение аванса (оплаченная часть при возвр.)";
	Иначе
		СодержаниеОперации = "Возврат поставщику. Неоплаченная часть.";
	КонецЕсли;
	СуфиксСчетаРасчетов = ?(НаправлениеДвижения = Перечисления.НаправленияДвижений.Поступление, "Дт", "Кт");
	СуфиксСчетаАвансов  = ?(НаправлениеДвижения = Перечисления.НаправленияДвижений.Поступление, "Кт", "Дт");
	УсловиеВалюта = Справочники.Валюты.ПустаяСсылка();
	ЗнакФильтрПоОстаткам = ?(НаправлениеДвижения = Перечисления.НаправленияДвижений.Поступление , 1, -1);    
	МоментДокумента     = Новый МоментВремени(лпДокСсылка.Дата,лпДокСсылка.Ссылка);
	Период = МоментДокумента;
	Контрагент          = прСтруктураШапкиДокумента.Контрагент;
	ДоговорКонтрагента  = прСтруктураШапкиДокумента.ДоговорКонтрагента;
	Если     ДоговорКонтрагента.ВедениеВзаиморасчетов = Перечисления.ВедениеВзаиморасчетовПоДоговорам.ПоДоговоруВЦелом 
		И НЕ ДоговорКонтрагента.ВестиПоДокументамРасчетовСКонтрагентомРегл Тогда
		Сделка = Неопределено;
	КонецЕсли;  
	ТаблицаАвансов       = ОбщегоНазначения.ПолучитьОстатокПоСчету(лпДокСсылка.Организация,Период,?(НаправлениеДвижения = Перечисления.НаправленияДвижений.Поступление и ЭтоВозврат,СчетРасчетов,СчетАвансов),УсловиеВалюта ,Контрагент, ДоговорКонтрагента,Сделка,ЗнакФильтрПоОстаткам);
	НомерСубконтоРасчетныеДокументы = 0;
	Если НЕ СчетАвансов.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.ДокументыРасчетовСКонтрагентами,"ВидСубконто") = Неопределено тогда
		НомерСубконтоРасчетныеДокументы = СчетАвансов.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.ДокументыРасчетовСКонтрагентами,"ВидСубконто").НомерСтроки;
	КонецЕсли;
	Если НЕ НомерСубконтоРасчетныеДокументы = 0 тогда
		УправлениеВзаиморасчетами.УпорядочитьТаблицуПоДокументу(ТаблицаАвансов,"Субконто"+НомерСубконтоРасчетныеДокументы);
	КонецЕсли;
	
	Если ТаблицаАвансов.Количество()<>0 тогда
		ПроводкиБУ = прДвижения.Хозрасчетный;   		
		Для каждого СтрокаАванса из ТаблицаАвансов Цикл
			//Расчет суммы перекрытия задолженности на счете, определение суммовых разниц
		ТекущийАванс = Макс(0, Мин(СуммаДокументаСНДСВВалютеРасчетов,СтрокаАванса["СуммаОстаток"]));  		
		Если ТекущийАванс = 0 тогда 
			Продолжить;
		КонецЕсли;
		ТекущийАвансРегл = ТекущийАванс;
		СуммаДокументаСНДСВВалютеРасчетов = СуммаДокументаСНДСВВалютеРасчетов - ТекущийАванс;

		Проводка = ПроводкиБУ.Добавить();
		
		Проводка.Период       = лпДокСсылка.Дата;
		Проводка.Организация  = лпДокСсылка.Организация;
		Проводка.Содержание   = СодержаниеОперации;
		
		Проводка["Счет" + СуфиксСчетаРасчетов]= СчетРасчетов;
		ОбщегоНазначения.УстановитьСубконто(Проводка["Счет" + СуфиксСчетаРасчетов], Проводка["Субконто" + СуфиксСчетаРасчетов], "Контрагенты",        Контрагент);
		ОбщегоНазначения.УстановитьСубконто(Проводка["Счет" + СуфиксСчетаРасчетов], Проводка["Субконто" + СуфиксСчетаРасчетов], "Договоры",           ДоговорКонтрагента);
		ОбщегоНазначения.УстановитьСубконто(Проводка["Счет" + СуфиксСчетаРасчетов], Проводка["Субконто" + СуфиксСчетаРасчетов], "ДокументыРасчетовСКонтрагентами", УправлениеВзаиморасчетами.ОпределитьДокументРасчетовСКонтрагентом(прСтруктураШапкиДокумента, прСтруктураШапкиДокумента.Ссылка, Сделка));
		
		Проводка["Счет" + СуфиксСчетаАвансов]= СчетАвансов;
		Для НомерСубконто = 1 по 3 Цикл
			ОбщегоНазначения.УстановитьСубконто(Проводка["Счет" + СуфиксСчетаАвансов], Проводка["Субконто" + СуфиксСчетаАвансов], НомерСубконто,СтрокаАванса["Субконто" + НомерСубконто]);
		КонецЦикла;
		
		Проводка.Сумма = ТекущийАвансРегл;  			
		КонецЦикла;
	КонецЕсли;
	// ****
	
	// проводки по строке
	Если "СформироватьПроводкиСтрока" = "СформироватьПроводкиСтрока" Тогда
		Для каждого Строка Из лпДокСсылка.Товары Цикл
			// суммы отрицательные
			лпСуммаЗакБезНДС = ПолучитьДопРеквизитТабличнойЧастиСумма(лпДопДанныеДокумента, "Товары", Строка.Номенклатура, "СуммаЗакБезНДС");
			лпСуммаЗакНДС = ПолучитьДопРеквизитТабличнойЧастиСумма(лпДопДанныеДокумента, "Товары", Строка.Номенклатура, "СуммаЗакНДС");
			лпСуммаЗакСНДС = ПолучитьДопРеквизитТабличнойЧастиСумма(лпДопДанныеДокумента, "Товары", Строка.Номенклатура, "СуммаЗакСНДС");
			// !!!
			Если ОбщегоНазначения.ПолучитьСхемуНалогообложения(лпДокСсылка.Дата,лпДокСсылка.Организация).НДС = Ложь Тогда
				лпСебестоимость = лпСуммаЗакСНДС;  				
			Иначе
				лпСебестоимость = лпСуммаЗакБезНДС;
			КонецЕсли;
			
			
			лпСуммаРознУчетБезНДС = ПолучитьДопРеквизитТабличнойЧастиСумма(лпДопДанныеДокумента, "Товары", Строка.Номенклатура, "СуммаРознУчетБезНДС");
			лпСуммаРознУчетНДС = ПолучитьДопРеквизитТабличнойЧастиСумма(лпДопДанныеДокумента, "Товары", Строка.Номенклатура, "СуммаРознУчетНДС");
			лпСуммаРознУчетСНДС = ПолучитьДопРеквизитТабличнойЧастиСумма(лпДопДанныеДокумента, "Товары", Строка.Номенклатура, "СуммаРознУчетСНДС");
			
			лпСуммаСписываемойНаценки = лпСуммаРознУчетСНДС - лпСебестоимость;
			
			// ***** регистр ТоварыВНТТВПродажныхЦенах
			НовоеДвижение = прДвижения.ТоварыВНТТВПродажныхЦенах.Добавить();   			
			НовоеДвижение.Активность  = Истина;
			НовоеДвижение.ВидДвижения = ВидДвиженияНакопления.Расход;  
			НовоеДвижение.Период 	   = лпДокСсылка.Дата;  
			НовоеДвижение.Регистратор = лпДокСсылка;  			
			НовоеДвижение.Склад 	   = прСтруктураШапкиДокумента.Склад;  			
			НовоеДвижение.СтавкаНДС= Строка.СтавкаНДСВРознице;
			НовоеДвижение.Сумма 		 = АБС(лпСуммаРознУчетСНДС);
			Если ОбщегоНазначения.ПолучитьСхемуНалогообложения(лпДокСсылка.Дата,лпДокСсылка.Организация).НДС = Ложь Тогда
				лпСуммаНаценки = АБС(лпСуммаРознУчетСНДС - лпСебестоимость); 
			Иначе
				лпСуммаНаценки = АБС(лпСуммаРознУчетСНДС - лпСебестоимость - лпСуммаЗакНДС);
			КонецЕсли;
			НовоеДвижение.СуммаНаценки  = лпСуммаНаценки;  			
			НовоеДвижение.Номенклатура  = Строка.Номенклатура;
			НовоеДвижение.ХарактеристикаНоменклатуры  = Строка.ХарактеристикаНоменклатуры; 			
			НовоеДвижение.КодОперации   = Перечисления.КодыОперацийТоварыВНТТВПродажныхЦенах.Возврат;    			
			
			
			//***** Хозрасчетный - проводки
			Проводка = прДвижения.Хозрасчетный.Добавить();
			Проводка.Период          = лпДокСсылка.Дата;
			Проводка.Организация = лпДокСсылка.Организация;
			Проводка.Содержание = "Возврат ТМЦ: себестоимость сторно";
			Проводка.СчетДт = Строка.СчетУчетаБУ;
			Проводка.СчетКт = прСтруктураШапкиДокумента.СчетУчетаРасчетовСКонтрагентом;
			ЗаполнитьСубконто(Проводка, прСтруктураШапкиДокумента, Строка,,,,,Строка.УдалитьСтатьяПриростаУбылиЗапасов);
			УстановитьСубконто(Проводка.СчетДт, Проводка.СубконтоДт, "СтавкиНДС",  Строка.СтавкаНДС);
			УстановитьСубконто(Проводка.СчетКт, Проводка.СубконтоКт, "ДокументыРасчетовСКонтрагентами",  лпДокСсылка);

			//Если Строка.НДСВключенВСтоимость Тогда
			//	Проводка.Сумма = - (Строка.Сумма - Строка.СуммаНДС);
			//Иначе
			Проводка.Сумма = - Строка.Сумма;
			//КонецЕсли;
			Если Проводка.СчетДт.Количественный Тогда
				Проводка.КоличествоДт = -Строка.Количество;
			КонецЕсли;
			Если Проводка.СчетКт.Количественный Тогда
				Проводка.КоличествоКт = -Строка.Количество;
			КонецЕсли;
			
			Проводка.НалоговоеНазначениеДт = Строка.НалоговоеНазначение; 
			//Проводка.НалоговоеНазначениеКт = Строка.НалоговоеНазначение;
			Если лпДокОбъект.Дата < Дата(2015,01,01,0,0,0) Тогда
				Проводка.СуммаНУДт = Проводка.Сумма;  			
				//Проводка.СуммаНУКт = Проводка.Сумма;
			КонецЕсли;				
			
			// схема розничный
			Если (прСтруктураШапкиДокумента.Склад.ВидСклада = Перечисления.ВидыСкладов.НТТ) Тогда
				Если (лпСуммаСписываемойНаценки <> 0) Тогда
					// 282 - 285 торговая наценка
					Проводка = прДвижения.Хозрасчетный.Добавить();
					Проводка.Период          = лпДокСсылка.Дата;
					Проводка.Организация = лпДокСсылка.Организация;
					Проводка.Содержание = "Возврат ТМЦ: торговая надбавка сторно";
					Проводка.СчетДт = Строка.СчетУчетаБУ;
					Проводка.СчетКт = ПланыСчетов.Хозрасчетный.ТорговаяНаценкаНТТ;
					УстановитьСубконто(Проводка.СчетДт, Проводка.СубконтоДт, "Склады",  прСтруктураШапкиДокумента.Склад);
					УстановитьСубконто(Проводка.СчетКт, Проводка.СубконтоКт, "Склады",  прСтруктураШапкиДокумента.Склад);
					УстановитьСубконто(Проводка.СчетДт, Проводка.СубконтоДт, "Номенклатура",  Строка.Номенклатура);
					УстановитьСубконто(Проводка.СчетКт, Проводка.СубконтоКт, "Номенклатура",  Строка.Номенклатура);   					
					УстановитьСубконто(Проводка.СчетДт, Проводка.СубконтоДт, "СтавкиНДС",  Строка.СтавкаНДС);
					УстановитьСубконто(Проводка.СчетКт, Проводка.СубконтоКт, "СтавкиНДС",  Строка.СтавкаНДС);
					
					Проводка.Сумма = лпСуммаСписываемойНаценки;
					Если Проводка.СчетДт.Количественный Тогда
						Проводка.КоличествоДт = -Строка.Количество;
					КонецЕсли;
					Если Проводка.СчетКт.Количественный Тогда
						Проводка.КоличествоКт = -Строка.Количество;
					КонецЕсли;
					
					Проводка.НалоговоеНазначениеДт = Строка.НалоговоеНазначение; 
					Проводка.НалоговоеНазначениеКт = Строка.НалоговоеНазначение;
					Если лпДокОбъект.Дата < Дата(2015,01,01,0,0,0) Тогда
						Проводка.СуммаНУДт = Проводка.Сумма;  					
						Проводка.СуммаНУКт = Проводка.Сумма;
					КонецЕсли;
					
				КонецЕсли;
			КонецЕсли;
			
		КонецЦикла;
	КонецЕсли;
	
	лпДокОбъект = 0;
КонецПроцедуры



Процедура ДвиженияПоРегистрам_БП_ОтчетОРозничныхПродажах(прДвижения,прРежимПроведения, прСтруктураШапкиДокумента) Экспорт
	лпДокСсылка = прСтруктураШапкиДокумента.Ссылка;
	лпДокОбъект = лпДокСсылка.ПолучитьОбъект();
	
	//определим наш ли это документ
	лпДокСсылка = прСтруктураШапкиДокумента.Ссылка;
	лпСоответствиеДок = Справочники.ТО_СоответствияДокументов;
	лпНайденнаяСсылка = лпСоответствиеДок.НайтиПоРеквизиту("Документ", лпДокСсылка);
	Если лпНайденнаяСсылка <> Справочники.ТО_СоответствияДокументов.ПустаяСсылка() Тогда
		лпДопДанныеДокументаСсылка = лпНайденнаяСсылка.ДопДанныеДокумента;
	Иначе
		лпДопДанныеДокументаСсылка = Справочники.ТО_ДополнительныеДанныеДокументов.ПустаяСсылка();
	КонецЕсли;
	
	Если лпДопДанныеДокументаСсылка.Пустая() Тогда
		Возврат;
	КонецЕсли;
	лпДопДанныеДокумента = лпДопДанныеДокументаСсылка.ПолучитьОбъект();
	
	//удалим неподходящие стандартные проводки
	Если "УдалитьПроводки" = "УдалитьПроводки" Тогда
		
		//***** Хозрасчетный
		лпДвижения_Хозрасчетный = прДвижения.Хозрасчетный;
		лпНомерПров = лпДвижения_Хозрасчетный.Количество();
		Пока лпНомерПров > 0 Цикл
			лпПроводка = лпДвижения_Хозрасчетный.Получить(лпНомерПров - 1);
			// схема оптовый
			// удаляем 
			// схема розничный
			// ничего не удаляем
			
			// схема розничный
			Если прСтруктураШапкиДокумента.Склад.ВидСклада = Перечисления.ВидыСкладов.Розничный Тогда
				// проводка по строке
				Если (Лев(лпПроводка.СчетДт.Код, 2) = "28")ИЛИ(Лев(лпПроводка.СчетКт.Код, 2) = "28") Тогда
					лпДвижения_Хозрасчетный.Удалить(лпНомерПров - 1);
				КонецЕсли;
				Если (Лев(лпПроводка.СчетДт.Код, 3) = "36Р") Тогда
					лпДвижения_Хозрасчетный.Удалить(лпНомерПров - 1);
				КонецЕсли;
				Если (Лев(лпПроводка.СчетДт.Код, 3) = "301") Тогда
					лпДвижения_Хозрасчетный.Удалить(лпНомерПров - 1);
				КонецЕсли;
			КонецЕсли;
			лпНомерПров = лпНомерПров - 1;
		КонецЦикла;
	КонецЕсли;
	
	// проводки по строке
	Если "СформироватьПроводкиСтрока" = "СформироватьПроводкиСтрока" Тогда
		Для каждого Строка Из лпДокСсылка.Товары Цикл
			лпСуммаЗакБезНДС     = ПолучитьДопРеквизитТабличнойЧастиСумма(лпДопДанныеДокумента, "Товары", Строка.Номенклатура, "СуммаЗакБезНДС");
			
			лпСуммаЗакБезНДС = ПолучитьДопРеквизитТабличнойЧастиСумма(лпДопДанныеДокумента, "Товары", Строка.Номенклатура, "СуммаЗакБезНДС");
			лпСуммаЗакНДС = ПолучитьДопРеквизитТабличнойЧастиСумма(лпДопДанныеДокумента, "Товары", Строка.Номенклатура, "СуммаЗакНДС");
			лпСуммаЗакСНДС = ПолучитьДопРеквизитТабличнойЧастиСумма(лпДопДанныеДокумента, "Товары", Строка.Номенклатура, "СуммаЗакСНДС");
			
			лпСуммаЗакБезНДССкидки = ПолучитьДопРеквизитТабличнойЧастиСумма(лпДопДанныеДокумента, "Товары", Строка.Номенклатура, "СуммаЗакБезНДССкидки");
			лпСуммаЗакСНДССкидки = ПолучитьДопРеквизитТабличнойЧастиСумма(лпДопДанныеДокумента, "Товары", Строка.Номенклатура, "СуммаЗакСНДССкидки");
			лпСуммаЗакНДССкидки = ПолучитьДопРеквизитТабличнойЧастиСумма(лпДопДанныеДокумента, "Товары", Строка.Номенклатура, "СуммаЗакНДССкидки");
			// !!!
			лпСебестоимость = лпСуммаЗакБезНДС;
			
